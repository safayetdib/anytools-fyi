---
import en from "../i18n/en.json";

interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav aria-label={en.a11y.breadcrumb}>
  <ol>
    {
      items.map((item, index) =>
        index === items.length - 1 ? (
          <li aria-current="page">{item.name}</li>
        ) : (
          <li>
            <a href={item.path}>{item.name}</a>
            <span aria-hidden="true">/</span>
          </li>
        ),
      )
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
