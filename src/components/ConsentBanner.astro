---
import en from "../i18n/en.json";

const c = en.consent;
---

<section class="consent" aria-labelledby="consent-title" data-consent hidden>
  <div class="consent-head">
    <span class="consent-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a9 9 0 1 0 9 9 3 3 0 0 1-3.5-3 3 3 0 0 1-3-3A3 3 0 0 1 12 3z" />
        <circle cx="8.5" cy="11" r="1" fill="currentColor" stroke="none" />
        <circle cx="12" cy="16" r="1" fill="currentColor" stroke="none" />
        <circle cx="15.5" cy="13" r="1" fill="currentColor" stroke="none" />
      </svg>
    </span>
    <p class="consent-title" id="consent-title">{c.title}</p>
  </div>
  <p class="consent-body">
    {c.body} <a href="/cookies/">{c.more}</a>
  </p>
  <div class="consent-actions">
    <button class="consent-button" type="button" data-consent-choice="denied">{c.decline}</button>
    <button class="consent-button consent-accept" type="button" data-consent-choice="granted">{c.accept}</button>
  </div>
</section>

<script>
  import {
    MEASUREMENT_ID,
    analyticsCookies,
    readConsent,
    saveConsent,
    shouldLoadAnalytics,
    type Consent,
  } from "../lib/consent";

  type Gtag = (...args: unknown[]) => void;
  const page = window as unknown as { dataLayer?: unknown[]; gtag?: Gtag };

  const storage = {
    getItem: (key: string) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    },
    setItem: (key: string, value: string) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        // Blocked storage: the choice lasts for this page only.
      }
    },
  };

  // Google Analytics is added only after the visitor accepts, so nothing reaches Google before that.
  function loadAnalytics() {
    if (page.gtag || !shouldLoadAnalytics(location.hostname, readConsent(storage))) return;
    page.dataLayer = page.dataLayer ?? [];
    page.gtag = function gtag() {
      // gtag.js reads the arguments object itself, so it is pushed as is.
      // eslint-disable-next-line prefer-rest-params
      page.dataLayer?.push(arguments);
    };
    page.gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "granted",
    });
    page.gtag("js", new Date());
    page.gtag("config", MEASUREMENT_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`;
    document.head.append(script);
  }

  function forgetAnalytics() {
    page.gtag?.("consent", "update", { analytics_storage: "denied" });
    const domain = location.hostname;
    for (const name of analyticsCookies(document.cookie)) {
      document.cookie = `${name}=; Max-Age=0; path=/`;
      document.cookie = `${name}=; Max-Age=0; path=/; domain=.${domain}`;
    }
  }

  // Waits until the page has loaded and the browser is idle, so analytics never slows the first view.
  function whenIdle(task: () => void) {
    const run = () => ("requestIdleCallback" in window ? requestIdleCallback(task, { timeout: 3000 }) : setTimeout(task, 1));
    if (document.readyState === "complete") run();
    else addEventListener("load", run, { once: true });
  }

  const banner = document.querySelector<HTMLElement>("[data-consent]");
  const calm = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The card springs in, a moment after the page on a first visit, and drops away once answered.
  function show(late: boolean) {
    if (!banner) return;
    delete banner.dataset.leaving;
    banner.dataset.entering = late ? "late" : "now";
    banner.hidden = false;
  }

  function hide() {
    if (!banner || banner.hidden) return;
    if (calm()) {
      banner.hidden = true;
      return;
    }
    banner.dataset.leaving = "";
    const done = () => {
      if (banner.dataset.leaving === undefined) return;
      delete banner.dataset.leaving;
      banner.hidden = true;
    };
    banner.addEventListener("animationend", (event) => event.target === banner && done(), { once: true });
    setTimeout(done, 400);
  }

  function choose(consent: Consent) {
    saveConsent(storage, consent);
    hide();
    if (consent === "granted") loadAnalytics();
    else forgetAnalytics();
  }

  if (banner) {
    if (readConsent(storage) === null) show(true);
    banner.addEventListener("click", (event) => {
      const choice = (event.target as HTMLElement).closest<HTMLElement>("[data-consent-choice]")?.dataset.consentChoice;
      if (choice === "granted" || choice === "denied") choose(choice);
    });
  }

  // "Cookie settings" in the footer brings the choice back.
  document.querySelectorAll("[data-consent-open]").forEach((button) =>
    button.addEventListener("click", () => {
      if (!banner) return;
      show(false);
      banner.querySelector<HTMLButtonElement>("[data-consent-choice]")?.focus();
    }),
  );

  // Tools announce when they finish. Only the page address is sent, never file names or contents.
  document.addEventListener("anytools:tool-done", () => page.gtag?.("event", "tool_complete", { tool_path: location.pathname }));

  whenIdle(loadAnalytics);
</script>

<style>
  .consent {
    position: fixed;
    right: var(--space-md);
    bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
    z-index: 45;
    display: grid;
    gap: var(--space-sm);
    width: min(26rem, calc(100vw - 2 * var(--space-md)));
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.45);
  }

  .consent[hidden] {
    display: none;
  }

  .consent-head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .consent-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface));
    color: var(--color-accent);
  }

  .consent-title {
    margin: 0;
    font-weight: 700;
  }

  .consent-body {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .consent-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  /* Accept and Decline are equally easy to see and tap. */
  .consent-button {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .consent-accept {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* Phones: above the tab bar, edge to edge. */
  @media (max-width: 599px) {
    .consent {
      right: var(--space-sm);
      bottom: calc(4.25rem + env(safe-area-inset-bottom));
      left: var(--space-sm);
      width: auto;
    }

    :global(:root:has([data-tool-shell][data-task])) .consent {
      bottom: calc(var(--space-sm) + env(safe-area-inset-bottom));
    }
  }

  /* In: the card springs up, the cookie pops and takes a bite, the text and buttons follow, Accept glows once.
     Out: the card drops and fades. Everything finishes in about a second. */
  @media (prefers-reduced-motion: no-preference) {
    .consent[data-entering] {
      --consent-wait: 0ms;
      animation: consent-in 560ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--consent-wait) both;
    }

    .consent[data-entering="late"] {
      --consent-wait: 800ms;
    }

    .consent[data-entering] .consent-icon {
      animation:
        consent-pop 480ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--consent-wait) + 160ms) both,
        consent-bite 600ms var(--ease-out) calc(var(--consent-wait) + 760ms);
    }

    .consent[data-entering] .consent-title,
    .consent[data-entering] .consent-body,
    .consent[data-entering] .consent-actions {
      animation: consent-rise 360ms var(--ease-out) both;
    }

    .consent[data-entering] .consent-title {
      animation-delay: calc(var(--consent-wait) + 140ms);
    }

    .consent[data-entering] .consent-body {
      animation-delay: calc(var(--consent-wait) + 220ms);
    }

    .consent[data-entering] .consent-actions {
      animation-delay: calc(var(--consent-wait) + 300ms);
    }

    .consent[data-entering] .consent-accept {
      animation: consent-glow 1s var(--ease-out) calc(var(--consent-wait) + 900ms);
    }

    .consent[data-leaving] {
      animation: consent-out 260ms cubic-bezier(0.4, 0, 1, 1) forwards;
    }

    @keyframes consent-in {
      from {
        opacity: 0;
        transform: translateY(28px) scale(0.94);
      }
    }

    @keyframes consent-pop {
      from {
        opacity: 0;
        transform: scale(0.3) rotate(-120deg);
      }
    }

    @keyframes consent-bite {
      25% {
        transform: rotate(-14deg) scale(1.08);
      }

      55% {
        transform: rotate(10deg) scale(1.08);
      }

      80% {
        transform: rotate(-4deg);
      }
    }

    @keyframes consent-rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }

    @keyframes consent-glow {
      0% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 50%, transparent);
      }

      100% {
        box-shadow: 0 0 0 14px transparent;
      }
    }

    @keyframes consent-out {
      to {
        opacity: 0;
        transform: translateY(24px) scale(0.96);
      }
    }
  }
</style>
