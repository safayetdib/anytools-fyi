---
import Logo from "./Logo.astro";
import en from "../i18n/en.json";
import { liveHubs } from "../lib/tools";

const f = en.footer;
const columns = [
  {
    title: f.tools,
    links: [
      ...liveHubs().map((hub) => ({ href: `/${hub.slug}/`, label: en.hubs[hub.id].name })),
      { href: "/tools/", label: en.nav.allTools },
    ],
  },
  {
    title: f.company,
    links: [
      { href: "/about/", label: f.about },
      { href: "/contact/", label: f.contact },
      { href: "/how-we-protect-your-privacy/", label: f.howWeProtect },
      { href: "/credits/", label: f.credits },
    ],
  },
  {
    title: f.legal,
    links: [
      { href: "/privacy/", label: f.privacy },
      { href: "/terms/", label: f.terms },
      { href: "/cookies/", label: f.cookies },
      { href: "/accessibility/", label: f.accessibility },
    ],
  },
];
const year = new Date().getUTCFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a class="name" href="/" aria-label={en.a11y.home}><Logo /></a>
        <p class="promise">{f.promise}</p>
      </div>
      <nav class="columns" aria-label={en.a11y.footerNav}>
        {
          columns.map((column) => (
            <div>
              <p class="title">{column.title}</p>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
                {column.title === f.legal && (
                  <li>
                    <button class="settings" type="button" data-consent-open>
                      {en.consent.settings}
                    </button>
                  </li>
                )}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="copyright">&copy; {year} {en.site.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-4xl);
    padding-block: var(--space-3xl) var(--space-xl);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border-subtle);
  }

  .top {
    display: grid;
    gap: var(--space-2xl);
  }

  .name {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .promise {
    max-width: 22rem;
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-md) var(--space-xl);
  }

  .title {
    margin: 0 0 var(--space-sm);
    font-weight: 700;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a,
  .settings {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .settings {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  @media (hover: hover) {
    .settings:hover,
    a:hover {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .copyright {
    margin: var(--space-2xl) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-3xl);
    }
  }
</style>
