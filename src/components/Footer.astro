---
import en from "../i18n/en.json";

const links = [
  { href: "/how-we-protect-your-privacy/", label: en.footer.howWeProtect },
  { href: "/about/", label: en.footer.about },
  { href: "/contact/", label: en.footer.contact },
  { href: "/privacy/", label: en.footer.privacy },
  { href: "/terms/", label: en.footer.terms },
  { href: "/accessibility/", label: en.footer.accessibility },
];
const year = new Date().getUTCFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="promise">{en.footer.promise}</p>
    <nav aria-label={en.a11y.footerNav}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="copyright">&copy; {year} {en.site.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border-subtle);
  }

  .promise {
    margin: 0 0 var(--space-sm);
    font-weight: 600;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
  }

  a:hover {
    color: var(--color-accent);
  }

  .copyright {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
