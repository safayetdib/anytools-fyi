---
import en from "../i18n/en.json";
import { HUBS, isHubLive, listedTools, toolBySlug, type Tool } from "../lib/tools";
import SearchBox from "./SearchBox.astro";
import Logo from "./Logo.astro";
import ToolIcon from "./ToolIcon.astro";

const path = Astro.url.pathname;
const tools = en.tools as Record<string, { name: string }>;
const quick = en.nav.quick.map((slug) => toolBySlug(slug) as Tool);
const groups = HUBS.map((hub) => ({
  hub,
  live: isHubLive(hub.id),
  tools: listedTools().filter((tool) => tool.hub === hub.id),
}));
---

<header class="header">
  <div class="container row">
    <a class="logo" href="/" aria-label={en.a11y.home}>
      <Logo intro />
    </a>
    <div class="search-slot">
      <SearchBox id="header-search" />
    </div>
    <nav class="nav" aria-label={en.a11y.mainNav}>
      <button class="search-toggle" type="button" aria-label={en.search.open} aria-expanded="false" data-search-toggle hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <button class="icon-button theme-toggle" type="button" aria-label={en.theme.label} aria-pressed="false" data-theme-toggle hidden>
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <ul class="quick">
        {
          quick.map((tool) => (
            <li>
              <a href={`/${tool.slug}/`} aria-current={path === `/${tool.slug}/` ? "page" : undefined}>
                {tools[tool.slug].name}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="menu" data-menu>
        <summary>
          <span class="wide">{en.nav.allTools}</span>
          <span class="narrow">{en.nav.menu}</span>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <div class="panel">
          <div class="container groups">
            {
              groups.map((group) => (
                <div class="group">
                  <p class="group-title">
                    {group.live ? <a href={`/${group.hub.slug}/`}>{en.hubs[group.hub.id].name}</a> : en.hubs[group.hub.id].name}
                  </p>
                  <ul>
                    {group.tools.map((tool) => (
                      <li>
                        <a class="tool-link" href={`/${tool.slug}/`}>
                          <ToolIcon tool={tool} size="sm" />
                          {tools[tool.slug].name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="container see-all">
            <a href="/tools/">{en.nav.seeAll}</a>
            <button class="panel-theme" type="button" aria-pressed="false" data-theme-toggle hidden>
              <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
              {en.theme.label}
            </button>
          </div>
        </div>
      </details>
    </nav>
  </div>
  <nav class="tabbar" aria-label={en.nav.tabs.label}>
    <a class="tab" href="/" aria-current={path === "/" ? "page" : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"></path></svg>
      {en.nav.tabs.home}
    </a>
    <a class="tab" href="/tools/" aria-current={path === "/tools/" ? "page" : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"></rect><rect x="13.5" y="4" width="6.5" height="6.5" rx="3.25"></rect><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"></rect><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"></rect></svg>
      {en.nav.tabs.tools}
    </a>
    <button class="tab" type="button" data-tab-search>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      {en.nav.tabs.search}
    </button>
    <button class="tab" type="button" aria-pressed="false" data-theme-toggle hidden>
      <svg class="moon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
      <svg class="sun" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      {en.theme.label}
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const query = matchMedia("(prefers-color-scheme: dark)");
    const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : query.matches);
    const toggles = document.querySelectorAll("[data-theme-toggle]");
    const sync = () =>
      toggles.forEach((toggle) => {
        toggle.hidden = false;
        toggle.setAttribute("aria-pressed", String(isDark()));
      });
    toggles.forEach((toggle) =>
      toggle.addEventListener("click", () => {
        const theme = isDark() ? "light" : "dark";
        root.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {}
        sync();
      }),
    );
    query.addEventListener("change", sync);
    sync();
  })();

  // The Search tab opens the header search on phones.
  document.querySelector("[data-tab-search]")?.addEventListener("click", () => {
    const header = document.querySelector(".header");
    const input = header?.querySelector("[data-search] input");
    if (!header || !input) return;
    header.setAttribute("data-search-open", "");
    document.querySelector("[data-search-toggle]")?.setAttribute("aria-expanded", "true");
    window.scrollTo({ top: 0 });
    input.focus();
  });

  (() => {
    const menu = document.querySelector("[data-menu]");
    if (!menu) return;
    const summary = menu.querySelector("summary");
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
  })();
</script>

<style>
  .header {
    position: relative;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-sm);
    min-height: 4.5rem;
  }

  .search-slot {
    display: none;
    order: 3;
    flex-basis: 100%;
    padding-bottom: var(--space-sm);
  }

  .header[data-search-open] .search-slot {
    display: block;
  }

  .icon-button,
  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .search-toggle[hidden],
  .theme-toggle[hidden],
  .panel-theme[hidden] {
    display: none;
  }

  /* The header switch needs room, so phones get it at the bottom of the menu instead. */
  .theme-toggle {
    display: none;
  }

  .sun,
  :root[data-theme="dark"] .moon {
    display: none;
  }

  :root[data-theme="dark"] .sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .moon {
      display: none;
    }

    :root:not([data-theme="light"]) .sun {
      display: block;
    }
  }

  .panel-theme {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @media (min-width: 480px) {
    .row {
      column-gap: var(--space-lg);
    }

    .logo {
      --logo-size: 2rem;
    }

    .theme-toggle {
      display: inline-flex;
    }

    .panel-theme {
      display: none;
    }
  }

  .search-toggle[aria-expanded="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* A smaller logo on narrow phones keeps the menu on the same row. */
  .logo {
    --logo-size: 1.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .quick {
    display: none;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick a,
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding-inline: var(--space-sm);
    border-radius: var(--radius-button);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  summary {
    padding-inline: var(--space-md);
    border: 1px solid var(--color-border);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .wide {
    display: none;
  }

  .chevron {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .menu[open] .chevron {
    transform: rotate(180deg);
  }

  .menu[open] summary {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .quick a:hover,
    summary:hover {
      color: var(--color-accent);
    }
  }

  .quick a[aria-current="page"] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    max-height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    padding-block: var(--space-xl);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-xl) var(--space-2xl);
  }

  .group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group-title {
    margin: 0 0 var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .group-title a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
  }

  .tool-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: var(--space-xs);
    margin-inline: calc(var(--space-xs) * -1);
    border-radius: var(--radius-button);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  @media (hover: hover) {
    .tool-link:hover {
      background: var(--color-bg);
      color: var(--color-accent);
    }
  }

  .see-all {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .see-all a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: drop var(--dur-base) var(--ease-out);
    }

    @keyframes drop {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }

  @media (min-width: 900px) {
    .row {
      flex-wrap: nowrap;
    }

    .search-slot,
    .header[data-search-open] .search-slot {
      display: block;
      order: 0;
      flex: 1;
      max-width: 26rem;
      padding: 0;
    }

    .search-toggle {
      display: none !important;
    }

    .wide {
      display: inline;
    }

    .narrow {
      display: none;
    }

    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .quick {
      display: flex;
    }

    .groups {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-lg);
    }
  }
  /* Phones: a slim app bar on top and a tab bar at the bottom. */
  .tabbar {
    display: none;
  }

  @media (max-width: 599px) {
    .row {
      min-height: 3.5rem;
    }

    .search-toggle,
    summary {
      border-color: transparent;
    }

    /* The Search tab replaces the top search button. */
    .search-toggle {
      display: none !important;
    }

    .tabbar {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 30;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: var(--space-xs) var(--space-xs) calc(var(--space-xs) + env(safe-area-inset-bottom));
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
    }

    /* While a tool is in use, its own bar owns the bottom of the screen. */
    :global(:root:has([data-tool-shell][data-task])) .tabbar {
      display: none;
    }

    .tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-height: 52px;
      padding: 0;
      border: 0;
      border-radius: var(--radius-button);
      background: transparent;
      color: var(--color-text-muted);
      font: inherit;
      font-size: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .tab[hidden] {
      display: none;
    }

    .tab[aria-current="page"] {
      color: var(--color-accent);
    }

    .tab:active {
      background: var(--color-bg);
    }
  }
</style>
