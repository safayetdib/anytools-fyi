---
import en from "../i18n/en.json";
import { HUBS, isHubLive, listedTools, toolBySlug, type Tool } from "../lib/tools";
import SearchBox from "./SearchBox.astro";
import Logo from "./Logo.astro";
import ToolIcon from "./ToolIcon.astro";

const path = Astro.url.pathname;
// The homepage has its own large search box, so the header leaves its one out there.
const isHome = path === "/";
const tools = en.tools as Record<string, { name: string }>;
// Quick links point only to tools that work today.
const quick = en.nav.quick.map((slug) => toolBySlug(slug) as Tool).filter((tool) => tool.built);
const groups = HUBS.map((hub) => ({
  hub,
  live: isHubLive(hub.id),
  tools: listedTools().filter((tool) => tool.hub === hub.id),
})).filter((group) => group.tools.length > 0);
---

<header class="header">
  <div class="container row">
    <a class="logo" href="/" aria-label={en.a11y.home}>
      <Logo intro />
    </a>
    {
      !isHome && (
        <div class="search-slot">
          <SearchBox id="header-search" />
        </div>
      )
    }
    <nav class="nav" aria-label={en.a11y.mainNav}>
      {
        !isHome && (
          <button class="search-toggle" type="button" aria-label={en.search.open} aria-expanded="false" data-search-toggle hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </button>
        )
      }
      <ul class="quick">
        {
          quick.map((tool) => (
            <li>
              <a href={`/${tool.slug}/`} aria-current={path === `/${tool.slug}/` ? "page" : undefined}>
                {tools[tool.slug].name}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="menu" data-menu>
        <summary>
          <span class="wide">{en.nav.allTools}</span>
          <span class="narrow">{en.nav.menu}</span>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <div class="drawer-backdrop" data-menu-close aria-hidden="true"></div>
        <div class="panel" id="site-menu">
          <div class="drawer-head">
            <p class="drawer-title">{en.nav.menu}</p>
            <button class="drawer-close" type="button" aria-label={en.nav.closeMenu} data-menu-close>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg>
            </button>
          </div>
          <div class="container groups">
            {
              groups.map((group) => (
                <div class="group">
                  <p class="group-title">
                    {group.live ? (
                      <a href={`/${group.hub.slug}/`}>
                        {en.hubs[group.hub.id].name}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                      </a>
                    ) : (
                      <span>{en.hubs[group.hub.id].name}</span>
                    )}
                  </p>
                  <ul>
                    {group.tools.map((tool) => (
                      <li>
                        <a class="tool-link" href={`/${tool.slug}/`} aria-current={path === `/${tool.slug}/` ? "page" : undefined}>
                          <ToolIcon tool={tool} size="sm" />
                          <span class="tool-name">{tools[tool.slug].name}</span>
                          {!tool.built && <span class="soon">{en.nav.soon}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="container see-all">
            <a class="see-all-link" href="/tools/">
              {en.nav.seeAll}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
            </a>
          </div>
        </div>
      </details>
      <button class="icon-button theme-toggle" type="button" aria-label={en.theme.label} aria-pressed="false" data-theme-toggle hidden>
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
  <nav class="tabbar" aria-label={en.nav.tabs.label}>
    <a class="tab" href="/" aria-current={path === "/" ? "page" : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"></path></svg>
      {en.nav.tabs.home}
    </a>
    <a class="tab" href="/tools/" aria-current={path === "/tools/" ? "page" : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"></rect><rect x="13.5" y="4" width="6.5" height="6.5" rx="3.25"></rect><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"></rect><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"></rect></svg>
      {en.nav.tabs.tools}
    </a>
    <button class="tab" type="button" data-tab-search>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      {en.nav.tabs.search}
    </button>
    <button class="tab" type="button" aria-expanded="false" aria-controls="site-menu" data-tab-menu>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></svg>
      {en.nav.menu}
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const query = matchMedia("(prefers-color-scheme: dark)");
    const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : query.matches);
    const toggles = document.querySelectorAll("[data-theme-toggle]");
    const sync = () =>
      toggles.forEach((toggle) => {
        toggle.hidden = false;
        toggle.setAttribute("aria-pressed", String(isDark()));
      });
    toggles.forEach((toggle) =>
      toggle.addEventListener("click", () => {
        const theme = isDark() ? "light" : "dark";
        root.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {}
        sync();
      }),
    );
    query.addEventListener("change", sync);
    sync();
  })();

  // Other sticky parts sit below the header, and focused items scroll clear of it.
  (() => {
    const header = document.querySelector(".header");
    if (!header) return;
    const sync = () =>
      document.documentElement.style.setProperty("--header-height", `${Math.round(header.getBoundingClientRect().height)}px`);
    new ResizeObserver(sync).observe(header);
    sync();
  })();

  // The Search tab opens the header search on phones, or goes to the page's own search box on the homepage.
  document.querySelector("[data-tab-search]")?.addEventListener("click", () => {
    const header = document.querySelector(".header");
    const input = header?.querySelector("[data-search] input");
    if (!header || !input) {
      const own = document.querySelector("main [data-search] input");
      own?.scrollIntoView({ block: "center" });
      own?.focus();
      return;
    }
    header.setAttribute("data-search-open", "");
    document.querySelector("[data-search-toggle]")?.setAttribute("aria-expanded", "true");
    window.scrollTo({ top: 0 });
    input.focus();
  });

  (() => {
    const menu = document.querySelector("[data-menu]");
    if (!menu) return;
    const summary = menu.querySelector("summary");
    // On phones the menu is a drawer from the right, opened from the header or the Menu tab.
    const tab = document.querySelector("[data-tab-menu]");
    let opener = summary;
    tab?.addEventListener("click", (event) => {
      event.stopPropagation();
      opener = tab;
      menu.open = !menu.open;
    });
    summary.addEventListener("click", () => (opener = summary));
    menu.addEventListener("toggle", () => {
      tab?.setAttribute("aria-expanded", String(menu.open));
      const close = menu.querySelector(".drawer-close");
      if (menu.open && close && getComputedStyle(close).display !== "none") close.focus();
    });
    menu.querySelectorAll("[data-menu-close]").forEach((button) =>
      button.addEventListener("click", () => {
        menu.open = false;
        opener.focus();
      }),
    );
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        opener.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
  })();
</script>

<style>
  /* The header stays at the top while the page scrolls. */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-sm);
    min-height: 4.5rem;
  }

  .search-slot {
    display: none;
    order: 3;
    flex-basis: 100%;
    padding-bottom: var(--space-sm);
  }

  .header[data-search-open] .search-slot {
    display: block;
  }

  .icon-button,
  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .search-toggle[hidden],
  .theme-toggle[hidden] {
    display: none;
  }

  /* The theme switch sits quietly at the far right of the top bar, on phones too. */
  .theme-toggle {
    border-color: transparent;
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      background: var(--color-bg);
      color: var(--color-accent);
    }
  }

  .sun,
  :root[data-theme="dark"] .moon {
    display: none;
  }

  :root[data-theme="dark"] .sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .moon {
      display: none;
    }

    :root:not([data-theme="light"]) .sun {
      display: block;
    }
  }

  @media (min-width: 480px) {
    .row {
      column-gap: var(--space-lg);
    }

    .logo {
      --logo-size: 2rem;
    }
  }

  .search-toggle[aria-expanded="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* A smaller logo on narrow phones keeps the menu on the same row. */
  .logo {
    --logo-size: 1.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .quick {
    display: none;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick a,
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding-inline: var(--space-sm);
    border-radius: var(--radius-button);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  summary {
    padding-inline: var(--space-md);
    border: 1px solid var(--color-border);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .wide {
    display: none;
  }

  .chevron {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .menu[open] .chevron {
    transform: rotate(180deg);
  }

  .menu[open] summary {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .quick a:hover,
    summary:hover {
      color: var(--color-accent);
    }
  }

  .quick a[aria-current="page"] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    max-height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    padding-block: var(--space-xl);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* The menu: one card per category, each with a quiet heading and one-line tool rows. */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-lg) var(--space-xl);
  }

  /* With a single category, its tools spread across the menu instead of sitting in one narrow column. */
  .group:only-child {
    grid-column: 1 / -1;
  }

  .group:only-child ul {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    column-gap: var(--space-xl);
  }

  .group ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group-title {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    margin: 0 0 var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .group-title a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.25rem;
    color: inherit;
    text-decoration: none;
  }

  .group-title a svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .tool-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: var(--space-xs) var(--space-sm);
    margin-inline: calc(var(--space-sm) * -1);
    border-radius: var(--radius-button);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tool-link[aria-current="page"] {
    background: var(--color-bg);
    color: var(--color-accent);
  }

  .tool-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .soon {
    flex: none;
    padding: 1px var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  @media (hover: hover) {
    .tool-link:hover {
      background: var(--color-bg);
      color: var(--color-accent);
    }

    .group-title a:hover {
      color: var(--color-accent);
    }

    .group-title a:hover svg,
    .see-all-link:hover svg {
      transform: translateX(3px);
    }
  }

  .see-all {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
  }

  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .see-all-link svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: drop var(--dur-base) var(--ease-out);
    }

    @keyframes drop {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }

  @media (min-width: 900px) {
    .row {
      flex-wrap: nowrap;
    }

    .search-slot,
    .header[data-search-open] .search-slot {
      display: block;
      order: 0;
      flex: 1;
      max-width: 26rem;
      padding: 0;
    }

    .search-toggle {
      display: none !important;
    }

    .wide {
      display: inline;
    }

    .narrow {
      display: none;
    }

    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-2xl);
    }
  }

  @media (min-width: 1200px) {
    .quick {
      display: flex;
    }

    .groups {
      gap: var(--space-xl) var(--space-3xl);
    }
  }
  /* Phones: a slim app bar on top and a tab bar at the bottom. */
  .tabbar,
  .drawer-head,
  .drawer-backdrop {
    display: none;
  }

  @media (max-width: 599px) {
    .row {
      min-height: 3.5rem;
    }

    .search-toggle,
    summary {
      border-color: transparent;
    }

    /* The Search and Menu tabs replace the top search button and Menu button. */
    .search-toggle,
    summary {
      display: none !important;
    }

    .tabbar {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 30;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: var(--space-xs) var(--space-xs) calc(var(--space-xs) + env(safe-area-inset-bottom));
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
    }

    /* While a tool is in use, its own bar owns the bottom of the screen. */
    :global(:root:has([data-tool-shell][data-task])) .tabbar {
      display: none;
    }

    .tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-height: 52px;
      padding: 0;
      border: 0;
      border-radius: var(--radius-button);
      background: transparent;
      color: var(--color-text-muted);
      font: inherit;
      font-size: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .tab[hidden] {
      display: none;
    }

    .tab[aria-current="page"] {
      color: var(--color-accent);
    }

    .tab:active {
      background: var(--color-bg);
    }

    .tab[aria-expanded="true"] {
      color: var(--color-accent);
    }

    /* The menu opens as a drawer from the right, above everything else. */
    .header:has(.menu[open]) {
      z-index: 50;
    }

    :global(:root:has(.menu[open])) {
      overflow: hidden;
    }

    .drawer-backdrop {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: block;
      background: rgb(0 0 0 / 0.45);
    }

    .panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      z-index: 41;
      display: flex;
      flex-direction: column;
      width: min(21rem, 86vw);
      max-height: none;
      padding: 0 0 calc(var(--space-lg) + env(safe-area-inset-bottom));
      border-bottom: 0;
      border-left: 1px solid var(--color-border-subtle);
      box-shadow: -16px 0 40px -20px rgb(0 0 0 / 0.5);
    }

    .drawer-head {
      position: sticky;
      top: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(var(--space-sm) + env(safe-area-inset-top)) var(--space-sm) var(--space-sm) var(--space-md);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .drawer-title {
      margin: 0;
      font-size: 1.125rem;
      font-weight: 700;
    }

    .drawer-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: var(--radius-button);
      background: transparent;
      color: var(--color-text);
      cursor: pointer;
    }

    .panel .container {
      width: 100%;
      padding-inline: var(--space-md);
    }

    .panel .tool-link {
      margin-inline: 0;
    }

    .panel .groups {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
      padding-top: var(--space-lg);
    }

    .panel .see-all {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (max-width: 599px) and (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: drawer-in var(--dur-slow) var(--ease-out);
    }

    .menu[open] .drawer-backdrop {
      animation: drawer-fade var(--dur-slow) var(--ease-out);
    }

    @keyframes drawer-in {
      from {
        transform: translateX(100%);
      }
    }

    @keyframes drawer-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>
