---
// A password box with a button that shows or hides what was typed.
import en from "../i18n/en.json";

interface Props {
  id: string;
  autocomplete: "new-password" | "off";
  label?: string;
  [data: `data-${string}`]: string | boolean | undefined;
}

const { id, autocomplete, label, ...data } = Astro.props;
---

<div class="pw-input">
  <input id={id} type="password" autocomplete={autocomplete} spellcheck="false" autocapitalize="off" aria-label={label} {...data} />
  <button type="button" class="pw-show" aria-pressed="false" aria-label={en.protectPdf.show} data-show data-label-show={en.protectPdf.show} data-label-hide={en.protectPdf.hide}>
    <svg class="is-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
    <svg class="is-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.9 17.9A10.4 10.4 0 0 1 12 19c-6.5 0-10-7-10-7a18.5 18.5 0 0 1 5.1-5.9M9.9 5.2A9.7 9.7 0 0 1 12 5c6.5 0 10 7 10 7a18.6 18.6 0 0 1-2.2 3.2M14.1 14.1a3 3 0 1 1-4.2-4.2"></path><path d="m2 2 20 20"></path></svg>
  </button>
</div>
