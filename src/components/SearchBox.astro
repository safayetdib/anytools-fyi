---
import en from "../i18n/en.json";

interface Props {
  id: string;
  variant?: "header" | "hero";
}

const { id, variant = "header" } = Astro.props;
const landmark = variant === "hero" ? en.search.heroLandmark : en.search.headerLandmark;
const t = en.search;
---

<form class:list={["search", variant]} role="search" aria-label={landmark} action="/tools/" data-search>
  <label class="sr-only" for={id}>{t.label}</label>
  <div class="field">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      id={id}
      type="search"
      name="q"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={`${id}-list`}
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder={t.placeholder}
    />
    {variant === "header" && <kbd aria-hidden="true">/</kbd>}
  </div>
  <div class="popup" data-popup hidden>
    <ul role="listbox" id={`${id}-list`} aria-label={t.listLabel}></ul>
    <p class="empty" data-empty hidden></p>
    <a class="see-all" href="/tools/">{t.seeAll}</a>
  </div>
  <p class="sr-only" aria-live="polite" data-status></p>
</form>

<script>
  import { initSearch } from "../lib/search/ui";

  initSearch();
</script>

<style is:global>
  .search {
    position: relative;
    width: 100%;
  }

  .search .field {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding-inline: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text-muted);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .search .field:focus-within {
    border-color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .search input {
    flex: 1;
    min-width: 0;
    min-height: 42px;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
  }

  .search input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .search input:focus {
    outline: none;
  }

  .search input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .search kbd {
    padding: 0 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    font-family: inherit;
    font-size: 0.8125rem;
  }

  .search.hero .field {
    min-height: 56px;
    background: var(--color-surface);
    font-size: 1.0625rem;
  }

  .search .popup {
    position: absolute;
    top: calc(100% + var(--space-xs));
    right: 0;
    left: 0;
    z-index: 30;
    max-height: min(70dvh, 28rem);
    overflow-y: auto;
    padding: var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .search [role="listbox"] {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-option {
    display: grid;
    gap: 2px;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .search-option[aria-selected="true"] {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    background: var(--color-bg);
  }

  @media (hover: hover) {
    .search-option:hover {
      background: var(--color-bg);
    }
  }

  .search-name {
    color: var(--color-text);
    font-weight: 700;
  }

  .search-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .search .empty {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text-muted);
  }

  .search .see-all {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
    font-weight: 700;
  }
</style>
