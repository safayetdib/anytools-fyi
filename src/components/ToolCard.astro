---
import en from "../i18n/en.json";
import type { Tool } from "../lib/tools";
import ToolIcon from "./ToolIcon.astro";

interface Props {
  tool: Tool;
  headingLevel?: "h2" | "h3";
}

const { tool, headingLevel: Heading = "h3" } = Astro.props;
const strings = (en.tools as Record<string, { name: string; description: string }>)[tool.slug];
---

<a class="card" href={`/${tool.slug}/`} data-testid="tool-card">
  <span class="icon"><ToolIcon tool={tool} /></span>
  <Heading class="name">{strings.name}</Heading>
  {!tool.built && <span class="soon">{en.card.comingSoon}</span>}
  <span class="description">{strings.description}</span>
</a>

<style>
  .card {
    display: block;
    height: 100%;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .soon {
    display: inline-block;
    margin-top: 0.375rem;
    padding: 2px var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .icon {
    display: flex;
    margin-bottom: var(--space-md);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .name {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .description {
    display: block;
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (min-width: 600px) {
    .card {
      padding: 1.25rem;
    }
  }

  @media (min-width: 900px) {
    .card {
      padding: var(--space-lg);
    }
  }

  .card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--color-accent);
      transform: translateY(-3px);
    }

    .card:hover .icon {
      transform: scale(1.06);
    }
  }
</style>
