---
import en from "../i18n/en.json";
import { TOOL_ICONS } from "../lib/icons";
import { hubFor, type Tool } from "../lib/tools";

interface Props {
  tool: Tool;
  headingLevel?: "h2" | "h3";
}

const { tool, headingLevel: Heading = "h3" } = Astro.props;
const strings = (en.tools as Record<string, { name: string; description: string }>)[tool.slug];
---

<a class="card" href={`/${tool.slug}/`} data-testid="tool-card">
  <span class="icon" style={`background:${hubFor(tool).color}`}>
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={TOOL_ICONS[tool.slug]}
    />
  </span>
  <Heading class="name">{strings.name}</Heading>
  <span class="description">{strings.description}</span>
</a>

<style>
  .card {
    display: block;
    height: 100%;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-button);
    color: var(--color-on-category);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .name {
    margin: 0;
    font-size: 1.0625rem;
  }

  .description {
    display: block;
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .card:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--color-accent);
      transform: translateY(-3px);
    }

    .card:hover .icon {
      transform: scale(1.08) rotate(-4deg);
    }
  }
</style>
