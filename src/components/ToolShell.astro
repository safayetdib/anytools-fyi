---
import en from "../i18n/en.json";
import { fill } from "../i18n/format";
import { formatSize } from "../lib/files";
import type { ToolConfig } from "../lib/shell/types";

interface Props {
  config: ToolConfig;
  selectLabel?: string;
  runLabel: string;
}

const { config, selectLabel = "", runLabel } = Astro.props;
const t = en.shell;
const isFiles = config.mode === "files";
const limits = isFiles
  ? fill(config.minFiles > 1 ? t.limitsMin : t.limits, {
      accept: config.acceptLabel,
      size: formatSize(config.maxFileSize),
      min: config.minFiles,
    })
  : "";
---

<div class="shell" data-tool-shell>
  <noscript><p class="shell-message">{t.noscript}</p></noscript>
  <p class="sr-only" aria-live="polite" data-el="live" data-testid="shell-live"></p>

  {
    isFiles && (
      <section data-screen="select">
        <div class="shell-zone" data-el="zone" data-testid="shell-zone">
          <svg class="shell-art" width="96" height="72" viewBox="0 0 96 72" aria-hidden="true">
            <rect x="18" y="10" width="40" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2" />
            <rect x="34" y="4" width="40" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
            <rect x="42" y="16" width="20" height="3" rx="1.5" fill="var(--color-accent)" />
            <rect x="42" y="24" width="24" height="3" rx="1.5" fill="var(--color-border-subtle)" />
            <path class="shell-art-arrow" d="M54 34v16m-6-6 6 6 6-6" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <label class="shell-pick" data-testid="shell-pick">
            <input class="sr-only" type="file" data-el="pick-input" accept={config.accept} multiple={config.multiple} />
            {selectLabel}
          </label>
          <p class="shell-hint">{t.orDrop}</p>
          <p class="shell-limits">{limits}</p>
        </div>
      </section>
    )
  }

  <section data-screen="working" hidden={isFiles}>
    {isFiles && <h2 class="shell-heading" tabindex="-1" data-el="working-heading">{t.arrangeHeading}</h2>}
    {isFiles && config.arrangeHint && <p class="shell-hint shell-arrange-hint">{config.arrangeHint}</p>}
    <form data-el="form" novalidate>
      {
        isFiles ? (
          <>
            <ol class="shell-files" data-el="list" />
            <p class="shell-total" data-el="total" data-testid="shell-total" />
          </>
        ) : (
          <div class="shell-field">
            <label for="shell-text">{config.inputLabel}</label>
            <textarea id="shell-text" data-el="text" rows="5" spellcheck="false" />
          </div>
        )
      }
      <slot name="options" />
      <p class="shell-notice shell-warning" data-el="warning" data-testid="shell-warning" hidden></p>
      <p class="shell-notice shell-error" id="shell-error" data-el="error" data-testid="shell-error" hidden></p>
      <div class="shell-run-row">
        {
          isFiles && config.multiple && (
            <label class="shell-secondary shell-add">
              <input class="sr-only" type="file" data-el="add-input" accept={config.accept} multiple />
              {t.addMore}
            </label>
          )
        }
        <button class="shell-primary shell-run" type="submit" data-el="run">{runLabel}</button>
      </div>
    </form>
  </section>

  <section data-screen="running" hidden>
    <h2 class="shell-heading" id="shell-running-heading">{t.runningHeading}</h2>
    <progress class="shell-progress" data-el="progress" max="1" aria-label={t.progressLabel}></progress>
    <p class="shell-status" data-el="status"></p>
    <button class="shell-secondary" type="button" data-el="cancel">{t.cancel}</button>
  </section>

  <section data-screen="result" hidden>
    <div class="shell-done">
      <svg class="shell-tick" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="var(--color-accent)" />
        <path d="m12 20.5 5.5 5.5L28 15" fill="none" stroke="var(--color-on-accent)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h2 class="shell-heading" tabindex="-1" data-el="result-heading">{t.resultOne}</h2>
    </div>
    <p class="shell-summary" data-el="summary"></p>
    <ul class="shell-downloads" data-el="downloads"></ul>
    <output class="shell-output" data-el="output" data-testid="shell-output" hidden></output>
    <div class="shell-actions">
      <button class="shell-secondary" type="button" data-el="copy" hidden>{t.copy}</button>
      <button class="shell-secondary" type="button" data-el="reset">{isFiles ? t.startOver : t.editInput}</button>
    </div>
    <section class="shell-preview" data-el="preview" aria-labelledby="shell-preview-heading" hidden>
      <h3 id="shell-preview-heading">{t.previewHeading}</h3>
      <p class="shell-hint">{t.previewNote}</p>
      <ol class="shell-pages" data-el="pages"></ol>
      <p class="shell-hint" data-el="preview-count" aria-live="polite"></p>
      <button class="shell-secondary" type="button" data-el="more" hidden>{t.showMore}</button>
    </section>
  </section>

  <dialog class="shell-viewer" data-el="viewer" aria-labelledby="shell-viewer-title">
    <div class="shell-viewer-bar">
      <p class="shell-viewer-title" id="shell-viewer-title" data-el="viewer-title"></p>
      <button class="shell-icon-button" type="button" data-el="viewer-close" aria-label={t.close}>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="shell-viewer-page">
      <img data-el="viewer-image" alt="" />
    </div>
    <div class="shell-viewer-bar">
      <button class="shell-secondary" type="button" data-el="viewer-prev">{t.previous}</button>
      <button class="shell-secondary" type="button" data-el="viewer-next">{t.next}</button>
    </div>
  </dialog>
</div>

<style is:global>
  .shell {
    margin-block: var(--space-xl);
  }

  .shell [hidden] {
    display: none !important;
  }

  .shell-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-lg);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    text-align: center;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .shell-zone.is-dragging {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    transform: scale(1.01);
  }

  .shell-pick,
  .shell-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: var(--space-sm) var(--space-xl);
    border: 0;
    border-radius: var(--radius-button);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: inherit;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .shell-pick {
    width: 100%;
    min-height: 64px;
    font-size: 1.25rem;
  }

  .shell-pick:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .shell-pick:active,
  .shell-primary:active,
  .shell-secondary:active {
    transform: scale(0.98);
  }

  .shell-secondary,
  .shell-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .shell-add:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .shell-icon-button {
    width: 44px;
    padding: 0;
    font-size: 1.25rem;
  }

  @media (hover: hover) {
    .shell-secondary:hover,
    .shell-icon-button:hover {
      border-color: var(--color-accent);
    }
  }

  .shell-hint,
  .shell-limits {
    margin: 0;
    color: var(--color-text-muted);
  }

  .shell-limits {
    font-size: 0.875rem;
  }

  .shell-heading {
    margin: 0 0 var(--space-sm);
    font-size: 1.375rem;
  }

  .shell-heading:focus {
    outline: none;
  }

  .shell-files {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
    counter-reset: file;
  }

  .shell-file {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
    padding: 0.75rem var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-surface);
  }

  .shell-file-name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .shell-file-actions {
    display: flex;
    gap: var(--space-xs);
  }


  .shell-field {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .shell-field label {
    font-weight: 600;
  }

  .shell-field input,
  .shell-field textarea,
  .shell-field select {
    width: 100%;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .shell-field textarea {
    resize: vertical;
  }

  .shell-field [aria-invalid="true"] {
    border-color: var(--color-danger);
    border-width: 2px;
  }

  .shell-arrange-hint {
    margin: 0 0 var(--space-lg);
  }

  .shell-run-row {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .shell-total {
    margin: 0 0 var(--space-md);
    font-weight: 600;
  }

  .shell-total:empty {
    display: none;
  }

  .shell-file-order {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .shell-thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.375rem;
    background: var(--color-bg);
  }

  .shell-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #ffffff;
  }

  .shell-thumb.is-loading {
    animation: shell-pulse 1.2s ease-in-out infinite alternate;
  }

  .shell-file-info {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .shell-file-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .shell-file-meta.is-problem {
    color: var(--color-warning);
    font-weight: 600;
  }

  .shell-summary {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
  }

  .shell-preview {
    margin-top: var(--space-2xl);
  }

  .shell-preview h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .shell-pages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: var(--space-md);
    margin: var(--space-md) 0;
    padding: 0;
    list-style: none;
  }

  .shell-page {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    padding: var(--space-xs);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: zoom-in;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .shell-page:hover {
      border-color: var(--color-accent);
    }
  }

  .shell-page img,
  .shell-page .shell-page-blank {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    border-radius: 0.25rem;
    background: #ffffff;
  }

  .shell-viewer {
    width: min(56rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .shell-viewer::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .shell-viewer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .shell-viewer-title {
    margin: 0;
    font-weight: 700;
  }

  .shell-viewer-page {
    display: flex;
    justify-content: center;
    margin-block: var(--space-sm);
  }

  .shell-viewer-page img {
    max-width: 100%;
    max-height: calc(100dvh - 12rem);
    height: auto;
    background: #ffffff;
    border: 1px solid var(--color-border-subtle);
  }

  .shell-notice {
    margin: 0 0 var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid currentColor;
    border-radius: var(--radius-button);
    background: var(--color-surface);
    font-weight: 600;
  }

  .shell-error {
    color: var(--color-danger);
  }

  .shell-warning {
    color: var(--color-warning);
  }

  .shell-run {
    width: 100%;
  }

  .shell-progress {
    width: 100%;
    height: 0.75rem;
    accent-color: var(--color-accent);
  }

  .shell-status {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-text-muted);
  }

  .shell-done {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-sm);
  }

  .shell-done .shell-heading {
    margin: 0;
  }

  .shell-downloads {
    display: grid;
    gap: var(--space-sm);
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
  }

  .shell-downloads a {
    width: 100%;
    overflow-wrap: anywhere;
  }

  .shell-output {
    display: block;
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .shell-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .shell-message {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
  }

  @media (min-width: 600px) {
    .shell-pick {
      width: auto;
    }

    .shell-run,
    .shell-downloads a {
      width: auto;
    }

    .shell-run-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .shell-pages {
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    }
  }

  /* Last, so it overrides the base row layout above. */
  @media (max-width: 479px) {
    .shell-file {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .shell-file-order {
      display: none;
    }

    .shell-file-actions {
      grid-column: 1 / -1;
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .shell-zone.is-dragging .shell-art-arrow {
      animation: shell-nudge 0.6s var(--ease-out) infinite alternate;
    }

    [data-screen="result"]:not([hidden]) .shell-tick path {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      animation: shell-draw var(--dur-slow) var(--ease-out) 120ms forwards;
    }

    @keyframes shell-pulse {
      to {
        opacity: 0.55;
      }
    }

    @keyframes shell-nudge {
      to {
        transform: translateY(3px);
      }
    }

    @keyframes shell-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
