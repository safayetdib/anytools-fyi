---
import en from "../i18n/en.json";
import { fill } from "../i18n/format";
import { formatSize } from "../lib/files";
import type { ToolConfig } from "../lib/shell/types";
import ShellConfirm from "./ShellConfirm.astro";

interface Props {
  config: ToolConfig;
  selectLabel?: string;
  runLabel: string;
}

const { config, selectLabel = "", runLabel } = Astro.props;
const t = en.shell;
const isFiles = config.mode === "files";
const limits = isFiles
  ? fill(config.minFiles > 1 ? t.limitsMin : t.limits, {
      accept: config.acceptLabel,
      size: formatSize(config.maxFileSize),
      min: config.minFiles,
    })
  : "";
---

<div class="shell" data-tool-shell>
  <noscript><p class="shell-message">{t.noscript}</p></noscript>
  <p class="sr-only" aria-live="polite" data-el="live" data-testid="shell-live"></p>
  {
    isFiles && (
      <div class="shell-steps" data-el="steps" data-testid="shell-steps">
        <span class="shell-steps-bars" aria-hidden="true">
          <span />
          <span />
          <span />
        </span>
        <span class="shell-steps-text" data-el="steps-text" />
      </div>
    )
  }

  {
    isFiles && (
      <section data-screen="select">
        <div class="shell-zone" data-el="zone" data-testid="shell-zone">
          <svg class="shell-art" width="96" height="72" viewBox="0 0 96 72" aria-hidden="true">
            <rect x="18" y="10" width="40" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2" />
            <rect x="34" y="4" width="40" height="52" rx="6" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />
            <rect x="42" y="16" width="20" height="3" rx="1.5" fill="var(--color-accent)" />
            <rect x="42" y="24" width="24" height="3" rx="1.5" fill="var(--color-border-subtle)" />
            <path class="shell-art-arrow" d="M54 34v16m-6-6 6 6 6-6" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <label class="shell-pick" data-testid="shell-pick">
            <input class="sr-only" type="file" data-el="pick-input" accept={config.accept} multiple={config.multiple} />
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 15V4" /><path d="m7 9 5-5 5 5" /><path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" />
            </svg>
            {selectLabel}
          </label>
          <p class="shell-hint">{t.orDrop}</p>
          <p class="shell-limits">{limits}</p>
        </div>
      </section>
    )
  }

  <section data-screen="working" hidden={isFiles}>
    {
      isFiles && (
        <div class="shell-working-head">
          <h2 class="shell-heading" tabindex="-1" data-el="working-heading">
            {t.arrangeHeading}
          </h2>
          <button class="shell-secondary" type="button" data-el="clear-files">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" /><path d="M3 21v-5h5" />
            </svg>
            {t.startOver}
          </button>
        </div>
      )
    }
    {isFiles && <ShellConfirm name="clear-confirm" />}
    {
      isFiles && config.arrangeHint && (
        <p class="shell-hint shell-arrange-hint">
          <span class="shell-long-hint">{config.arrangeHint}</span>
          <span class="shell-touch-hint">{t.arrangeHintPhone}</span>
        </p>
      )
    }
    <form data-el="form" novalidate>
      {
        isFiles ? (
          <>
            <ol class="shell-files" data-el="list" />
          </>
        ) : (
          <div class="shell-field">
            <label for="shell-text">{config.inputLabel}</label>
            <textarea id="shell-text" data-el="text" rows="5" spellcheck="false" />
          </div>
        )
      }
      <slot name="options" />
      <p class="shell-notice shell-warning" data-el="warning" data-testid="shell-warning" hidden></p>
      <p class="shell-notice shell-error" id="shell-error" data-el="error" data-testid="shell-error" hidden></p>
      <div class="shell-run-row" data-testid="shell-action-bar">
        {isFiles && <p class="shell-total" data-el="total" data-testid="shell-total" />}
        <div class="shell-run-actions">
          {
            isFiles && config.multiple && (
              <label class="shell-secondary shell-add">
                <input class="sr-only" type="file" data-el="add-input" accept={config.accept} multiple />
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                <span class="shell-add-text">{t.addMore}</span>
              </label>
            )
          }
          <button class="shell-primary shell-run" type="submit" data-el="run">
            {runLabel}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </form>
  </section>

  <section data-screen="running" hidden>
    <h2 class="shell-heading" id="shell-running-heading">{t.runningHeading}</h2>
    <progress class="shell-progress" data-el="progress" max="1" aria-label={t.progressLabel}></progress>
    <p class="shell-status" data-el="status"></p>
    <button class="shell-secondary" type="button" data-el="cancel">{t.cancel}</button>
  </section>

  <section data-screen="result" hidden>
    <div class="shell-result-card" data-testid="shell-result-card">
      <div class="shell-result-head">
        <div class="shell-done">
          <svg class="shell-tick" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="18" fill="var(--color-accent)" />
            <path d="m12 20.5 5.5 5.5L28 15" fill="none" stroke="var(--color-on-accent)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h2 class="shell-heading" tabindex="-1" data-el="result-heading">{t.resultOne}</h2>
        </div>
        <p class="shell-summary" data-el="summary"></p>
      </div>
      <div class="shell-result-bar" data-testid="shell-result-bar">
        <p class="shell-changed" data-el="changed" hidden>{t.changedNote}</p>
        <ul class="shell-downloads" data-el="downloads"></ul>
        <div class="shell-actions">
          <button class="shell-primary shell-apply" type="button" data-el="apply" hidden>{t.apply}</button>
          <button class="shell-secondary" type="button" data-el="undo" hidden>{t.undo}</button>
          <button class="shell-secondary" type="button" data-el="copy" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
            {t.copy}
          </button>
          <button class="shell-secondary" type="button" data-el="reset">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" /><path d="M3 21v-5h5" /></svg>
            {isFiles ? t.startOver : t.editInput}
          </button>
        </div>
      </div>
    </div>
    <output class="shell-output" data-el="output" data-testid="shell-output" hidden></output>
    {isFiles && <ShellConfirm name="result-confirm" />}
    <section class="shell-preview" data-el="preview" aria-labelledby="shell-preview-heading" hidden>
      <h3 id="shell-preview-heading">{t.previewHeading}</h3>
      <p class="shell-hint" data-el="preview-note">{t.previewNote}</p>
      <div class="shell-page-toolbar" data-el="page-toolbar" data-testid="page-toolbar" hidden>
        <div class="shell-page-status">
          <p class="shell-page-status-title" data-el="selection-status" aria-live="polite"></p>
          <p class="shell-hint" data-el="page-tip">{t.pageTip}</p>
        </div>
        <div class="shell-page-actions" data-el="idle-actions">
          <button class="shell-secondary" type="button" data-el="select-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="m8 12 3 3 5-6" /></svg>
            {t.selectAll}
          </button>
          <button class="shell-secondary" type="button" data-el="rotate-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
            {t.rotateAllShort}
          </button>
          <details class="shell-menu" data-el="size-menu">
            <summary class="shell-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 7h6" /></svg>
              <span>{t.pageSize}: <span data-el="size-label">{t.pageSizes.original}</span></span>
            </summary>
            <div class="shell-menu-panel">
              <div class="shell-field">
                <label for="shell-page-size">{t.pageSize}</label>
                <select id="shell-page-size" data-el="page-size" aria-describedby="shell-page-size-note">
                  {Object.entries(t.pageSizes).map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              </div>
              <p class="shell-hint" id="shell-page-size-note">{t.pageSizeNote}</p>
            </div>
          </details>
        </div>
        <div class="shell-page-actions" data-el="selection-actions" hidden>
          <button class="shell-secondary" type="button" data-el="rotate-selected">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
            {t.rotateSelected}
          </button>
          <details class="shell-menu" data-el="move-menu">
            <summary class="shell-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 4-3 3 3 3" /><path d="M4 7h11" /><path d="m17 14 3 3-3 3" /><path d="M20 17H9" /></svg>
              {t.moveMenu}
            </summary>
            <div class="shell-menu-panel">
              <div class="shell-field">
                <label for="shell-move-position">{t.moveTo}</label>
                <input id="shell-move-position" type="number" min="1" inputmode="numeric" data-el="move-position" />
              </div>
              <button class="shell-primary" type="button" data-el="move-selected">{t.moveButton}</button>
            </div>
          </details>
          <button class="shell-secondary shell-danger" type="button" data-el="remove-selected">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M6 7l1 13h10l1-13" /><path d="M9 7V4h6v3" /></svg>
            {t.removeSelected}
          </button>
          <button class="shell-secondary" type="button" data-el="clear-selection">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12" /><path d="M18 6 6 18" /></svg>
            {t.clearSelection}
          </button>
        </div>
      </div>
      <ol class="shell-pages" data-el="pages"></ol>
      <div class="shell-page-count" data-el="page-count" data-testid="page-count" hidden>
        <p class="shell-page-count-text" data-el="preview-count" aria-live="polite"></p>
        <div class="shell-page-count-bar" aria-hidden="true"><span data-el="preview-progress"></span></div>
        <div class="shell-page-count-actions">
          <button class="shell-secondary shell-more" type="button" data-el="more">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            <span data-el="more-label"></span>
          </button>
          <button class="shell-secondary" type="button" data-el="all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 6 5 5 5-5" /><path d="m7 13 5 5 5-5" /></svg>
            <span data-el="all-label"></span>
          </button>
          <button class="shell-text-button" type="button" data-el="less">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
            <span data-el="less-label"></span>
          </button>
        </div>
      </div>
    </section>
  </section>

  {
    isFiles && config.multiple && (
      <dialog class="shell-sheet" data-el="file-sheet" aria-labelledby="shell-file-sheet-title">
        <p class="shell-sheet-title" id="shell-file-sheet-title" data-el="file-sheet-title" />
        <button class="shell-sheet-item" type="button" data-sheet="up">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m6 11 6-6 6 6" /></svg>
          {t.sheetUp}
        </button>
        <button class="shell-sheet-item" type="button" data-sheet="down">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m6 13 6 6 6-6" /></svg>
          {t.sheetDown}
        </button>
        <button class="shell-sheet-item shell-danger" type="button" data-sheet="remove">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M6 7l1 13h10l1-13" /><path d="M9 7V4h6v3" /></svg>
          {t.sheetRemove}
        </button>
        <button class="shell-secondary shell-sheet-cancel" type="button" data-sheet="cancel">{t.sheetCancel}</button>
      </dialog>
    )
  }

  <dialog class="shell-viewer" data-el="viewer" aria-labelledby="shell-viewer-title">
    <div class="shell-viewer-head">
      <p class="shell-viewer-title" id="shell-viewer-title" data-el="viewer-title"></p>
      <div class="shell-viewer-zoom" role="group" aria-label={t.zoomFit}>
        <button class="shell-icon-button" type="button" data-el="zoom-out" aria-label={t.zoomOut}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /><path d="M8 11h6" /></svg>
        </button>
        <span class="shell-viewer-zoom-level" data-el="zoom-level">100%</span>
        <button class="shell-icon-button" type="button" data-el="zoom-in" aria-label={t.zoomIn}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /><path d="M8 11h6" /><path d="M11 8v6" /></svg>
        </button>
        <button class="shell-icon-button" type="button" data-el="zoom-fit" aria-label={t.zoomFit}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5" /><path d="M20 9V4h-5" /><path d="M4 15v5h5" /><path d="M20 15v5h-5" /></svg>
        </button>
      </div>
      <button class="shell-icon-button" type="button" data-el="viewer-close" aria-label={t.close}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12" /><path d="M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="shell-viewer-stage">
      <div class="shell-viewer-scroll" data-el="viewer-scroll">
        <div class="shell-viewer-canvas" data-el="viewer-canvas">
          <img data-el="viewer-image" alt="" />
          <div class="shell-crop" data-el="crop-box" tabindex="0" role="group" aria-label={t.cropArea} aria-describedby="shell-crop-help" hidden>
            <span class="shell-crop-handle" data-handle="nw" aria-hidden="true"></span>
            <span class="shell-crop-handle" data-handle="ne" aria-hidden="true"></span>
            <span class="shell-crop-handle" data-handle="sw" aria-hidden="true"></span>
            <span class="shell-crop-handle" data-handle="se" aria-hidden="true"></span>
          </div>
        </div>
      </div>
      <button class="shell-viewer-nav shell-viewer-prev" type="button" data-el="viewer-prev" aria-label={t.previous}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <button class="shell-viewer-nav shell-viewer-next" type="button" data-el="viewer-next" aria-label={t.next}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
    <div class="shell-viewer-tools" data-el="viewer-edit" data-testid="viewer-tools" hidden>
      <div class="shell-viewer-group">
        <button class="shell-secondary" type="button" data-el="viewer-rotate-left" aria-label={t.rotateLeft}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
          <span class="shell-long">{t.rotateLeft}</span><span class="shell-short" aria-hidden="true">{t.rotateLeftShort}</span>
        </button>
        <button class="shell-secondary" type="button" data-el="viewer-rotate-right" aria-label={t.rotateRight}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
          <span class="shell-long">{t.rotateRight}</span><span class="shell-short" aria-hidden="true">{t.rotateRightShort}</span>
        </button>
        <button class="shell-secondary" type="button" data-el="viewer-crop">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2v14a2 2 0 0 0 2 2h14" /><path d="M18 22V8a2 2 0 0 0-2-2H2" /></svg>
          {t.crop}
        </button>
      </div>
      <button class="shell-secondary shell-viewer-move-toggle" type="button" data-el="viewer-move-toggle" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 4-3 3 3 3" /><path d="M4 7h11" /><path d="m17 14 3 3-3 3" /><path d="M20 17H9" /></svg>
        {t.moveOpen}
      </button>
      <div class="shell-viewer-group shell-viewer-move">
        <label class="shell-viewer-position">
          <span>{t.moveToShort}<span class="shell-viewer-extra"> {t.positionWord}</span></span>
          <input type="number" min="1" inputmode="numeric" data-el="viewer-position" />
        </label>
        <button class="shell-secondary" type="button" data-el="viewer-move">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 4-3 3 3 3" /><path d="M4 7h11" /><path d="m17 14 3 3-3 3" /><path d="M20 17H9" /></svg>
          {t.moveButton}
        </button>
      </div>
      <div class="shell-viewer-group">
        <button class="shell-secondary shell-danger" type="button" data-el="viewer-remove" aria-label={t.removeThis}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M6 7l1 13h10l1-13" /><path d="M9 7V4h6v3" /></svg>
          <span class="shell-long">{t.removeThis}</span><span class="shell-short" aria-hidden="true">{t.sheetRemove}</span>
        </button>
      </div>
    </div>
    <div class="shell-viewer-tools shell-crop-tools" data-el="crop-tools" hidden>
      <p class="shell-hint" id="shell-crop-help">
        {t.cropHelpDrag}<span class="shell-viewer-extra"> {t.cropHelpKeys}</span>
      </p>
      <div class="shell-viewer-group">
        <button class="shell-secondary shell-danger" type="button" data-el="crop-reset" hidden>{t.cropReset}</button>
        <button class="shell-secondary" type="button" data-el="crop-cancel">{t.cropCancel}</button>
        <button class="shell-primary" type="button" data-el="crop-apply">
