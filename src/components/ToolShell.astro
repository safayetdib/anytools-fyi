    accent-color: var(--color-accent);
  }

  .shell-status {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-text-muted);
  }

  .shell-done {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-sm);
  }

  .shell-done .shell-heading {
    margin: 0;
  }

  .shell-downloads {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shell-downloads a {
    width: 100%;
    overflow-wrap: anywhere;
  }

  .shell-output {
    display: block;
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }


  .shell-message {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
  }

  @media (min-width: 600px) {
    .shell-pick {
      width: auto;
    }

    .shell-run,
    .shell-downloads a {
      width: auto;
    }

    .shell-run-row,
    .shell-result-bar {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-md) var(--space-lg);
    }

    .shell-run-actions,
    .shell-actions {
      flex-direction: row;
      align-items: center;
      margin-left: auto;
    }

    .shell-run {
      min-width: 12rem;
    }

    /* The result is one card: what was made on the left, the download and next steps on the right. */
    .shell-result-card {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md) var(--space-xl);
      padding: var(--space-lg);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-card);
      background: var(--color-surface);
    }

    .shell-result-head {
      min-width: 0;
    }

    .shell-result-head .shell-summary {
      margin: 0;
    }

    .shell-result-card .shell-result-bar {
      justify-content: flex-end;
      margin: 0 0 0 auto;
      padding: 0;
      border: 0;
      background: none;
    }

    .shell-result-card .shell-changed {
      text-align: right;
    }

    .shell-result-bar .shell-actions {
      margin-left: 0;
    }

    .shell-pages {
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    }
  }


  /* The larger view fills the screen: page on top, fitted to the space, with every control always visible. */
  .shell-viewer {
    width: min(68rem, calc(100vw - 2rem));
    height: calc(100dvh - 2rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .shell-viewer[open] {
    display: flex;
    flex-direction: column;
  }

  .shell-viewer::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .shell-viewer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-sm) var(--space-sm) var(--space-lg);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .shell-viewer-title {
    margin: 0;
    font-weight: 700;
  }

  .shell-viewer-stage {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
    padding: 0 4rem;
    background: var(--color-bg);
  }

  /* The page sits in its own scroll area, so a zoomed page can be moved around while the arrows stay put. */
  .shell-viewer-scroll {
    display: flex;
    flex: 1;
    min-width: 0;
    overflow: auto;
    padding: var(--space-md);
  }

  .shell-viewer.is-zoomed .shell-viewer-scroll {
    cursor: grab;
  }

  .shell-viewer.is-zoomed .shell-viewer-scroll:active {
    cursor: grabbing;
  }

  .shell-viewer-canvas {
    position: relative;
    flex-shrink: 0;
    margin: auto;
  }

  .shell-viewer-canvas img {
    display: block;
    width: 100%;
    height: 100%;
    background: #ffffff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.2);
  }

  .shell-viewer-zoom {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }

  .shell-viewer-zoom-level {
    min-width: 3.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-align: center;
  }

  .shell-viewer-zoom button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .shell-viewer.is-cropping .shell-viewer-nav {
    display: none;
  }

  /* The crop box dims everything outside it, with a handle on each corner. */
  .shell-crop {
    position: absolute;
    border: 2px solid #ffffff;
    outline: 1px solid rgb(0 0 0 / 0.6);
    box-shadow: 0 0 0 9999px rgb(0 0 0 / 0.5);
    cursor: move;
    touch-action: none;
  }

  .shell-viewer-canvas:has(.shell-crop:not([hidden])) {
    overflow: hidden;
  }

  .shell-crop:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .shell-crop-handle {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 3px solid #ffffff;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5);
    touch-action: none;
  }

  .shell-crop-handle[data-handle="nw"] {
    top: -12px;
    left: -12px;
    cursor: nwse-resize;
  }

  .shell-crop-handle[data-handle="ne"] {
    top: -12px;
    right: -12px;
    cursor: nesw-resize;
  }

  .shell-crop-handle[data-handle="sw"] {
    bottom: -12px;
    left: -12px;
    cursor: nesw-resize;
  }

  .shell-crop-handle[data-handle="se"] {
    right: -12px;
    bottom: -12px;
    cursor: nwse-resize;
  }

  .shell-crop-tools .shell-hint {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .shell-viewer-nav {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 4px 14px -6px rgb(0 0 0 / 0.4);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .shell-viewer-nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (hover: hover) {
    .shell-viewer-nav:not(:disabled):hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  .shell-viewer-prev {
    left: var(--space-md);
  }

  .shell-viewer-next {
    right: var(--space-md);
  }

  .shell-viewer-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm) var(--space-lg);
    padding: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
  }

  .shell-viewer-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .shell-viewer-position {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 600;
  }

  .shell-viewer-position input {
    width: 4.5rem;
    min-height: var(--shell-button-height);
    padding: 0 var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  /* On phones the page gets the room: arrows sit over its edges and the tools wrap tightly. */
  @media (max-width: 599px) {
    .shell-viewer {
      width: calc(100vw - 1rem);
      height: calc(100dvh - 1rem);
      max-height: calc(100dvh - 1rem);
    }

    .shell-viewer-stage {
      padding: 0;
    }

    .shell-viewer-scroll {
      padding: var(--space-sm);
    }

    .shell-viewer-zoom-level {
      display: none;
    }

    .shell-viewer-head {
      gap: var(--space-xs);
      padding-left: var(--space-md);
    }

    .shell-viewer-prev {
      left: var(--space-xs);
    }

    .shell-viewer-next {
      right: var(--space-xs);
    }

    /* Tools sit in a two-column grid so the page keeps most of the screen. */
    .shell-viewer-tools {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xs);
      padding: var(--space-sm);
    }

    .shell-viewer-group {
      display: contents;
    }

    .shell-viewer-tools .shell-secondary,
    .shell-viewer-tools .shell-primary {
      width: 100%;
      padding: 0 var(--space-sm);
    }

    .shell-viewer-position input {
      flex: 1;
      width: auto;
      min-width: 0;
    }

    .shell-viewer-tools [data-el="viewer-remove"],
    .shell-crop-tools .shell-hint,
    .shell-crop-tools [data-el="crop-reset"] {
      grid-column: 1 / -1;
    }

    .shell-viewer-extra {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Last, so it overrides the base row layout above. */
  @media (max-width: 479px) {
    .shell-file {
      grid-template-columns: auto auto minmax(0, 1fr);
    }

    .shell-file-order {
      display: none;
    }

    .shell-file-actions {
      grid-column: 1 / -1;
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .shell-zone.is-dragging .shell-art-arrow {
      animation: shell-nudge 0.6s var(--ease-out) infinite alternate;
    }

    [data-screen="result"]:not([hidden]) .shell-tick path {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      animation: shell-draw var(--dur-slow) var(--ease-out) 120ms forwards;
    }

    @keyframes shell-pulse {
      to {
        opacity: 0.55;
      }
    }

    @keyframes shell-nudge {
      to {
        transform: translateY(3px);
      }
    }

    @keyframes shell-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }

  /* Phones: slightly shorter buttons, three pages per row, and no keyboard-and-mouse tip. */
  @media (max-width: 599px) {
    .shell {
      --shell-button-height: 3rem;
    }

    .shell-pick,
    .shell-primary {
      padding-inline: var(--space-lg);
      font-size: 1rem;
    }

    .shell-zone {
      padding: var(--space-xl) var(--space-md);
    }

    .shell-file {
      gap: var(--space-sm);
      padding: var(--space-sm);
    }

    .shell-thumb {
      width: 48px;
    }

    .shell-run-row,
    .shell-result-bar {
      padding: var(--space-sm);
    }

    .shell-page-toolbar {
      gap: var(--space-sm);
      padding: var(--space-sm);
    }

    .shell-page-status .shell-hint {
      display: none;
    }

    .shell-page-actions {
      width: 100%;
    }

    .shell-page-actions > * {
      flex: 1 1 auto;
    }

    .shell-pages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-sm);
    }

    .shell-page-item {
      padding: 2px;
    }

    .shell-page-check {
      gap: 6px;
      padding: 0 6px;
      font-size: 0.8125rem;
    }

    .shell-page-check input {
      width: 1.125rem;
      height: 1.125rem;
    }

    .shell-heading {
      font-size: 1.25rem;
    }
  }
  /* --- Phone app layout. Wider screens keep the layout above. --- */

  .shell-steps,
  .shell-touch-hint,
  .shell-short,
  .shell-viewer-move-toggle,
  .shell-file-more {
    display: none;
  }

  /* A bottom sheet: used for a file's actions on phones. */
  .shell-sheet {
    width: 100%;
    max-width: 32rem;
    margin: auto auto 0;
    padding: var(--space-md) var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
    border: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .shell-sheet[open] {
    display: grid;
    gap: var(--space-xs);
  }

  .shell-sheet::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .shell-sheet-title {
    margin: 0 0 var(--space-sm);
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shell-sheet-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .shell-sheet-item.shell-danger {
    color: var(--color-danger);
  }

  .shell-sheet-item:active {
    background: var(--color-bg);
  }

  .shell-sheet-cancel {
    margin-top: var(--space-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shell-sheet[open] {
      animation: shell-sheet-up var(--dur-slow) var(--ease-out);
    }

    @keyframes shell-sheet-up {
      from {
        transform: translateY(100%);
      }
    }
  }

  @media (max-width: 599px) {
    .shell {
      margin-block: var(--space-lg);
    }

    /* Room at the end of the page for the docked bar. */
    .shell[data-task] {
      padding-bottom: 7rem;
    }

    /* Progress: three short bars and the step's name. */
    .shell[data-task] .shell-steps {
      display: grid;
      gap: 6px;
      margin-bottom: var(--space-md);
    }

    .shell-steps-bars {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4px;
    }

    .shell-steps-bars span {
      height: 4px;
      border-radius: 2px;
      background: var(--color-border-subtle);
    }

    .shell[data-step="1"] .shell-steps-bars span:nth-child(-n + 1),
    .shell[data-step="2"] .shell-steps-bars span:nth-child(-n + 2),
    .shell[data-step="3"] .shell-steps-bars span {
      background: var(--color-accent);
    }

    .shell-steps-text {
      color: var(--color-text-muted);
      font-size: 0.8125rem;
      font-weight: 600;
    }

    /* Choosing files: a plain card. There's no dragging files in on a phone. */
    .shell-zone {
      gap: var(--space-sm);
      border: 1px solid var(--color-border-subtle);
    }

    .shell-zone .shell-hint {
      display: none;
    }

    .shell-art {
      width: 72px;
      height: 54px;
    }

    .shell-working-head .shell-secondary {
      min-height: 2.75rem;
      padding: 0 var(--space-md);
      font-size: 0.9375rem;
    }

    .shell-arrange-hint {
      font-size: 0.875rem;
    }

    .shell-long-hint {
      display: none;
    }

    .shell-touch-hint {
      display: inline;
    }

    /* File rows: one slim line each, with their actions in a sheet. */
    .shell-files {
      gap: var(--space-sm);
    }

    .shell-file {
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      gap: var(--space-sm);
      padding: 0.375rem 0.25rem 0.375rem var(--space-sm);
    }

    .shell-file-order {
      display: none;
    }

    .shell-thumb {
      width: 32px;
    }

    .shell-file-name {
      overflow: hidden;
      font-size: 0.9375rem;
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow-wrap: normal;
    }

    .shell-file-meta {
      font-size: 0.8125rem;
    }

    .shell-file-actions {
      grid-column: auto;
    }

    .shell-file-actions [data-action="up"],
    .shell-file-actions [data-action="down"],
    .shell-file-actions [data-action="remove"] {
      display: none;
    }

    .shell-file-more {
      display: inline-flex;
      border-color: transparent;
      background: transparent;
    }

    /* The run bar docks to the bottom of the screen, like an app's main button. */
    .shell-run-row,
    .shell-result-bar,
    .shell-page-toolbar:has([data-el="selection-actions"]:not([hidden])) {
      position: fixed;
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 25;
      margin: 0;
      padding: 0.75rem var(--space-md) calc(0.75rem + env(safe-area-inset-bottom));
      border: 0;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
      box-shadow: 0 -8px 24px -12px rgb(0 0 0 / 0.4);
    }

    .shell-run-row {
      gap: var(--space-xs);
    }

    .shell-total {
      font-size: 0.875rem;
    }

    .shell-result-bar {
      gap: var(--space-sm);
      border-top: 1px solid var(--color-border-subtle);
    }

    .shell-actions {
      flex-flow: row-reverse wrap;
    }

    .shell-actions > * {
      flex: 1 1 auto;
    }

    .shell-changed {
      margin: 0;
      font-size: 0.8125rem;
    }

    .shell-done .shell-tick {
      width: 32px;
      height: 32px;
    }

    .shell-summary {
      font-size: 0.9375rem;
    }

    /* While a "Start over?" question is open, it's the only decision on screen, so the docked bar steps aside. */
    .shell:has([data-el="clear-confirm"]:not([hidden])) .shell-run-row,
    .shell:has([data-el="result-confirm"]:not([hidden])) .shell-result-bar {
      display: none;
    }

    .shell-confirm-actions .shell-secondary {
      padding-inline: var(--space-md);
      font-size: 0.9375rem;
    }

    /* While pages are selected, their tools take the bottom of the screen. */
    .shell:has([data-el="selection-actions"]:not([hidden])) .shell-result-bar {
      display: none;
    }

    .shell-page-toolbar:has([data-el="selection-actions"]:not([hidden])) {
      gap: var(--space-xs);
      padding-top: var(--space-sm);
      border-top: 1px solid var(--color-border-subtle);
    }

    .shell-page-toolbar:has([data-el="selection-actions"]:not([hidden])) .shell-page-status {
      width: 100%;
      text-align: center;
    }

    [data-el="selection-actions"] {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xs);
    }

    [data-el="selection-actions"]:has([data-el="move-menu"][hidden]) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-el="selection-actions"] > .shell-secondary,
    [data-el="selection-actions"] summary {
      flex-direction: column;
      gap: 2px;
      width: 100%;
      min-height: 3.5rem;
      padding: 0 2px;
      border-color: transparent;
      background: transparent;
      font-size: 0.75rem;
      line-height: 1.2;
    }

    [data-el="selection-actions"] .shell-menu-panel {
      top: auto;
      bottom: calc(100% + var(--space-sm));
      left: 50%;
      transform: translateX(-50%);
    }

    [data-el="idle-actions"] .shell-secondary,
    [data-el="idle-actions"] summary {
      min-height: 2.75rem;
      padding: 0 0.75rem;
      font-size: 0.875rem;
    }

    /* The larger view fills the whole screen, with one row of tools. */
    .shell-viewer {
      width: 100%;
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
      border-radius: 0;
    }

    .shell-viewer-head {
      padding-top: calc(var(--space-sm) + env(safe-area-inset-top));
    }

    .shell-viewer-head .shell-icon-button {
      border-color: transparent;
    }

    .shell-viewer-stage {
      background: var(--color-stage);
    }

    .shell-viewer-scroll {
      touch-action: pan-y;
    }

    .shell-viewer.is-zoomed .shell-viewer-scroll {
      touch-action: none;
    }

    [data-el="viewer-edit"] {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 2px;
      padding: var(--space-xs) var(--space-xs) calc(var(--space-xs) + env(safe-area-inset-bottom));
    }

    [data-el="viewer-edit"] .shell-secondary {
      flex-direction: column;
      gap: 2px;
      min-height: 3.5rem;
      padding: 0 2px;
      border-color: transparent;
      background: transparent;
      font-size: 0.75rem;
      line-height: 1.2;
    }

    .shell-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .shell-short {
      display: inline;
    }

    .shell-viewer-move-toggle {
      display: inline-flex;
    }

    .shell-viewer-move-toggle[aria-expanded="true"] {
      color: var(--color-accent);
    }

    [data-el="viewer-edit"] .shell-viewer-move {
      display: none;
    }

    [data-el="viewer-edit"][data-move-open] .shell-viewer-move {
      display: flex;
      flex-wrap: nowrap;
      grid-column: 1 / -1;
      order: -1;
      gap: var(--space-sm);
      padding: var(--space-sm) var(--space-xs);
    }

    [data-el="viewer-edit"] .shell-viewer-move .shell-secondary {
      flex: none;
      width: auto;
      flex-direction: row;
      min-height: var(--shell-button-height);
      padding: 0 var(--space-lg);
