---
import { HELP_ICONS, type HelpIconName } from "../../lib/help-icons";

interface Props {
  name: HelpIconName;
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={HELP_ICONS[name]}
/>
