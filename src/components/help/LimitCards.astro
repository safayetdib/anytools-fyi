---
import type { HelpIconName } from "../../lib/help-icons";
import HelpIcon from "./HelpIcon.astro";

interface Props {
  limits: { icon: HelpIconName; value: string; label: string; note?: string; tone: "default" | "warn" }[];
}

const { limits } = Astro.props;
---

<ul class="limits" style={`--count: ${limits.length}`}>
  {
    limits.map((limit) => (
      <li class:list={["limit", limit.tone]} data-testid="limit-card">
        <span class="badge">
          <HelpIcon name={limit.icon} size={22} />
        </span>
        <div class="text">
          <p class="label">{limit.label}</p>
          <p class="value">{limit.value}</p>
          {limit.note && <p class="note">{limit.note}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  /* One panel of facts, split by hairlines: rows on phones, columns on wide screens. */
  .limits {
    display: grid;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    list-style: none;
  }

  .limit {
    --tone: var(--color-accent);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    align-items: start;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .limit + .limit {
    border-top: 1px solid var(--color-border-subtle);
  }

  .limit.warn {
    --tone: var(--color-warning);
  }

  .badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--tone) 14%, var(--color-surface));
    color: var(--tone);
  }

  .text {
    display: grid;
    gap: var(--space-xs);
  }

  .label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .value {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .warn .value {
    color: var(--tone);
  }

  .note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .limits {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }

    .limit {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-md);
    }

    .limit + .limit {
      border-top: 0;
      border-left: 1px solid var(--color-border-subtle);
    }
  }
</style>
