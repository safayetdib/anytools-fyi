---
import Breadcrumb from "../components/Breadcrumb.astro";
import en from "../i18n/en.json";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: { title: string; description: string; draft?: boolean; updated: string };
}

const { title, description, draft, updated } = Astro.props.frontmatter;
const path = Astro.url.pathname;
const updatedLabel = new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(updated));
---

<BaseLayout title={`${title} | ${en.site.name}`} description={description} noindex={draft}>
  <div class="container page-top">
    <Breadcrumb items={[{ name: en.nav.home, path: "/" }, { name: title, path }]} />
    <article class="prose">
      <h1>{title}</h1>
      {draft && <p class="draft">{en.info.draft}</p>}
      <slot />
      <p class="updated">{en.info.updated} <time datetime={updated}>{updatedLabel}</time></p>
    </article>
  </div>
</BaseLayout>

<style>
  h1 {
    margin: var(--space-md) 0 var(--space-xl);
  }

  .draft {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid currentColor;
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-warning);
    font-weight: 600;
  }

  .updated {
    margin-top: var(--space-xl);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
