---
import Breadcrumb from "../components/Breadcrumb.astro";
import JsonLd from "../components/JsonLd.astro";
import ToolGrid from "../components/ToolGrid.astro";
import ToolIcon from "../components/ToolIcon.astro";
import Faq from "../components/help/Faq.astro";
import LimitCards from "../components/help/LimitCards.astro";
import PrivacyDiagram from "../components/help/PrivacyDiagram.astro";
import Steps from "../components/help/Steps.astro";
import TipCards from "../components/help/TipCards.astro";
import en from "../i18n/en.json";
import { fill } from "../i18n/format";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { breadcrumbSchema, faqSchema, howToSchema, webApplicationSchema } from "../lib/schema";
import { formatAverage, shownRating } from "../lib/ratings";
import { loadRatings } from "../lib/ratings-source";
import { isToolIndexable, toolMeta } from "../lib/seo";
import { TOOLS, hubFor, isHubLive, staysOnDevice, toolBySlug, variantsOf, type Tool } from "../lib/tools";

const toolModules = import.meta.glob<AstroComponentFactory>("../tools/*/Tool.astro", { eager: true, import: "default" });
const diagrams = import.meta.glob<AstroComponentFactory>("../tools/*/Diagram.astro", { eager: true, import: "default" });

export function getStaticPaths() {
  return TOOLS.map((tool) => ({ params: { tool: tool.slug }, props: { tool } }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const site = Astro.site as URL;
const tools = en.tools as Record<string, { name: string; description: string; size?: string; variantsTitle?: string }>;
const p = en.toolPage;
const strings = tools[tool.slug];
const path = `/${tool.slug}/`;
const isText = tool.input === "text";
const hub = hubFor(tool);
const parent = tool.variantOf ? (toolBySlug(tool.variantOf) as Tool) : undefined;
const crumbs = [
  { name: en.nav.home, path: "/" },
  ...(isHubLive(hub.id) ? [{ name: en.hubs[hub.id].name, path: `/${hub.slug}/` }] : []),
  ...(parent ? [{ name: tools[parent.slug].name, path: `/${parent.slug}/` }] : []),
  { name: strings.name, path },
];
// A tool and its variants link to each other: the parent first, so a variant page can lead back to it.
const family = parent ?? tool;
const sizes = variantsOf(family).length ? [family, ...variantsOf(family)] : [];
const sizesTitle = tools[family.slug].variantsTitle ?? p.sizes;
const related = tool.related.map((slug) => toolBySlug(slug) as Tool);
// The privacy promise is made only by tools that do all their work in the browser.
const local = staysOnDevice(tool);
const { title, description } = toolMeta(tool);
// Coming-soon pages stay reachable but out of search results until the tool works.
const indexable = isToolIndexable(tool);
const image = indexable
  ? { path: `/og/${tool.slug}.png`, alt: fill(en.meta.toolImageAlt, { name: strings.name, description: strings.description }) }
  : undefined;
// A variant runs its parent's tool, with its own page, title and guide.
const ToolUi = toolModules[`../tools/${tool.slug}/Tool.astro`] ?? (parent && toolModules[`../tools/${parent.slug}/Tool.astro`]);
const Diagram = diagrams[`../tools/${tool.slug}/Diagram.astro`] ?? (parent && diagrams[`../tools/${parent.slug}/Diagram.astro`]);
const help = await getEntry("tools", tool.slug);
// Real ratings only, shown once there are enough of them. The same numbers go to search engines.
const rating = indexable ? shownRating((await loadRatings())[tool.slug]) : null;
const ratingText = rating
  ? `${fill(en.rating.summary, { average: formatAverage(rating.average) })} · ${
      rating.count === 1 ? en.rating.countOne : fill(en.rating.countMany, { count: rating.count })
    }`
  : "";
const STARS = [0, 1, 2, 3, 4]
  .map((index) => `<path transform="translate(${index * 24} 0)" d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z"/>`)
  .join("");
const Explainer = help ? (await render(help)).Content : undefined;
const updatedLabel = help
  ? new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(new Date(help.data.updated))
  : undefined;
---

<BaseLayout title={title} description={description} skipLabel={p.skip} noindex={!indexable} image={image}>
  {
    indexable && (
      <JsonLd
        slot="head"
        data={webApplicationSchema(
          {
            name: strings.name,
            description,
            path,
            image: image?.path,
            features: help?.data.steps.map((step) => step.title),
            updated: help?.data.updated,
            rating: rating ?? undefined,
          },
          site,
        )}
      />
    )
  }
  <JsonLd slot="head" data={breadcrumbSchema(crumbs, site)} />
  {indexable && help && <JsonLd slot="head" data={howToSchema(help.data.howToTitle, help.data.steps, site, image?.path)} />}
  {indexable && help && <JsonLd slot="head" data={faqSchema(help.data.faq)} />}
  <div class="container page-top">
    <div class="crumbs">
      <Breadcrumb items={crumbs} />
    </div>
    <div class="title-row">
      <ToolIcon tool={tool} />
      <h1>{strings.name}</h1>
    </div>
    {
      rating && (
        <p class="rating" data-testid="tool-rating">
          <span class="rating-stars" style={`--rating: ${(rating.average / 5) * 100}%`} aria-hidden="true">
            <svg class="rating-empty" width="100" height="20" viewBox="0 0 120 24" set:html={STARS} />
            <span class="rating-fill">
              <svg width="100" height="20" viewBox="0 0 120 24" set:html={STARS} />
            </span>
          </span>
          <span>{ratingText}</span>
        </p>
      )
    }
    <p class="lead">{strings.description} {isText ? p.leadText : p.leadFiles}</p>

    {
      local && (
        <aside class="local" aria-labelledby="local-title">
          <span class="local-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
          <span class="local-text">
            <span class="local-title" id="local-title">{isText ? p.localTitleText : p.localTitleFiles}</span>
            <span class="local-body">
              {isText ? p.localBodyText : p.localBodyFiles} <a href="/how-we-protect-your-privacy/">{en.footer.howWeProtect}</a>
            </span>
          </span>
        </aside>
      )
    }

    {
      sizes.length > 0 && (
        <nav class="sizes" aria-label={sizesTitle}>
          <p class="sizes-title" aria-hidden="true">
            {sizesTitle}
          </p>
          <ul>
            {sizes.map((size) => (
              <li>
                <a href={`/${size.slug}/`} aria-current={size.slug === tool.slug ? "page" : undefined}>
                  {tools[size.slug].size ?? tools[size.slug].name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      ToolUi ? (
        <ToolUi />
      ) : (
        <section class="tool-area" data-testid="tool-area" aria-labelledby="tool-status">
          <svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true">
            <rect x="8" y="8" width="48" height="48" rx="12" fill="none" stroke="var(--color-border)" stroke-width="2" stroke-dasharray="6 6" />
            <path d="M24 34l6 6 12-14" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h2 id="tool-status">{p.comingSoonTitle}</h2>
          <p>{p.comingSoonBody}</p>
        </section>
      )
    }


    {
      help && Explainer && (
        <div class="help">
          <section aria-labelledby="limits-heading" data-fold>
            <h2 id="limits-heading">{p.limits}</h2>
            <LimitCards limits={help.data.limits} />
          </section>

          <section aria-labelledby="steps-heading" data-fold>
            <h2 id="steps-heading">{help.data.howToTitle}</h2>
            <Steps steps={help.data.steps} />
          </section>

          <section aria-labelledby="explainer-heading" class="explainer" data-fold>
            <h2 id="explainer-heading">{help.data.diagramTitle ?? strings.name}</h2>
            <div class="prose">
              <Explainer />
            </div>
            {Diagram && <Diagram />}
          </section>

          {help.data.tips.length > 0 && (
            <section aria-labelledby="tips-heading" data-fold>
              <h2 id="tips-heading">{help.data.tipsTitle}</h2>
              <TipCards tips={help.data.tips} />
            </section>
          )}

          {local && !isText && (
            <section aria-labelledby="privacy-heading" data-fold>
              <h2 id="privacy-heading">{en.help.privacyTitle}</h2>
              <PrivacyDiagram />
            </section>
          )}

          <section aria-labelledby="faq-heading" data-fold>
            <h2 id="faq-heading">{p.questions}</h2>
            <Faq faq={help.data.faq} />
          </section>
        </div>
      )
    }

    <script is:inline>
      // Runs as soon as the guide is parsed, so phones see it folded from the first paint with no jump.
      (() => {
        // On phones the guide folds: each heading becomes a button, so the tool stays near the top.
        const phone = matchMedia("(max-width: 599px)");
        const CHEVRON =
          '<svg class="fold-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';

        function setUpFolds() {
          document.querySelectorAll("[data-fold]").forEach((section) => {
            const heading = section.querySelector("h2");
            if (!heading) return;
            const toggle = heading.querySelector(".fold-toggle");
            if (phone.matches && !toggle) {
              const button = document.createElement("button");
              button.type = "button";
              button.className = "fold-toggle";
              button.setAttribute("aria-expanded", "false");
              const label = document.createElement("span");
              label.append(...Array.from(heading.childNodes));
              button.append(label);
              button.insertAdjacentHTML("beforeend", CHEVRON);
              heading.append(button);
              section.toggleAttribute("data-folded", true);
            } else if (!phone.matches && toggle) {
              heading.replaceChildren(...Array.from(toggle.firstElementChild?.childNodes ?? []));
              section.removeAttribute("data-folded");
            }
          });
        }

        document.addEventListener("click", (event) => {
          const button = event.target.closest(".fold-toggle");
          const section = button?.closest("[data-fold]");
          if (!button || !section) return;
          const open = button.getAttribute("aria-expanded") !== "true";
          button.setAttribute("aria-expanded", String(open));
          section.toggleAttribute("data-folded", !open);
        });
        phone.addEventListener("change", setUpFolds);
        setUpFolds();
      })();
    </script>

    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{p.related}</h2>
      <ToolGrid tools={related} />
    </section>

    {
      updatedLabel && help && (
        <p class="updated">
          {p.updated} <time datetime={help.data.updated}>{updatedLabel}</time>
        </p>
      )
    }
  </div>
</BaseLayout>


<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  /* Partly filled stars: the gold layer is cut to the average, so 4.5 shows four and a half. */
  .rating {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .rating-stars {
    position: relative;
    display: inline-flex;
    flex: none;
  }

  .rating-empty {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
  }

  .rating-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--rating);
    overflow: hidden;
  }

  .rating-fill svg {
    fill: var(--color-star);
    stroke: var(--color-star);
    stroke-width: 1.5;
  }

  .lead {
    max-width: 42rem;
    margin: var(--space-md) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
  }

  .sizes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-lg);
  }

  .sizes-title {
    margin: 0;
    font-weight: 700;
  }

  .sizes ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sizes a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .sizes a[aria-current="page"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .tool-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-xl);
    padding: var(--space-2xl) var(--space-lg);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    text-align: center;
  }

  .tool-area h2 {
    margin: var(--space-sm) 0 var(--space-xs);
    font-size: 1.25rem;
  }

  .tool-area p {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* The privacy promise, shown only on tools that run entirely in the browser. */
  .local {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 42rem;
    margin-top: var(--space-lg);
    padding: var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }

  .local-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .local-text {
    display: grid;
    gap: 2px;
  }

  .local-title {
    font-weight: 700;
  }

  .local-body {
    color: var(--color-text-muted);
  }

  .local-body a {
    display: inline-block;
    padding-block: var(--space-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  .related {
    margin-top: var(--space-4xl);
  }

  .related h2 {
    margin: 0 0 var(--space-lg);
    font-size: 1.375rem;
  }

  .help {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4xl);
    margin-top: var(--space-3xl);
  }

  .help h2 {
    margin: 0 0 var(--space-lg);
    font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.625rem);
  }

  .explainer .prose {
    margin-bottom: var(--space-lg);
  }

  .updated {
    margin-top: var(--space-2xl);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 900px) {
    .tool-area {
      padding-block: var(--space-2xl);
    }
  }

  /* Phones: the tool comes first and the guide folds into one tidy list. */
  @media (max-width: 599px) {
    .crumbs {
      display: none;
    }

    .page-top {
      padding-top: var(--space-2xl);
    }

    .title-row {
      gap: var(--space-sm);
      margin-top: 0;
    }

    .title-row :global(.tool-icon) {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.625rem;
    }

    .title-row h1 {
      margin: 0;
      font-size: 1.5rem;
    }

    .lead {
      margin-top: var(--space-xl);
      font-size: 0.9375rem;
    }

    .local {
      gap: var(--space-sm);
      margin-top: var(--space-md);
      padding: var(--space-sm) var(--space-md);
      font-size: 0.875rem;
    }

    .local-icon {
      width: 2rem;
      height: 2rem;
    }

    .local-icon svg {
      width: 18px;
      height: 18px;
    }

    .help {
      gap: 0;
      margin-top: var(--space-xl);
      overflow: hidden;
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-card);
      background: var(--color-surface);
    }

    .help > section {
      padding: 0 var(--space-md);
    }

    .help > section + section {
      border-top: 1px solid var(--color-border-subtle);
    }

    .help > section:not([data-folded]) {
      padding-bottom: var(--space-lg);
    }

    .help h2 {
      margin: 0;
      font-size: 1rem;
    }

    .help > section:not([data-folded]) h2 {
      margin-bottom: var(--space-md);
    }

    .help > [data-folded] > :global(:not(h2)) {
      display: none;
    }

    .help :global(.fold-toggle) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
      width: 100%;
      min-height: 3.25rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--color-text);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .help :global(.fold-chevron) {
      flex: none;
      color: var(--color-text-muted);
      transition: transform var(--dur-base) var(--ease-out);
    }

    .help :global(.fold-toggle[aria-expanded="true"] .fold-chevron) {
      transform: rotate(180deg);
    }

    .related {
      margin-top: var(--space-2xl);
    }

    .related h2 {
      margin-bottom: var(--space-md);
      font-size: 1.125rem;
    }
  }
</style>
