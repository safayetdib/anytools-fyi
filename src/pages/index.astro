---
import CategoryPills from "../components/CategoryPills.astro";
import HeroArt from "../components/HeroArt.astro";
import JsonLd from "../components/JsonLd.astro";
import ToolGrid from "../components/ToolGrid.astro";
import en from "../i18n/en.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizationSchema, websiteSchema } from "../lib/schema";
import { listedTools } from "../lib/tools";

const site = Astro.site as URL;
---

<BaseLayout title={en.site.title} description={en.site.tagline}>
  <JsonLd slot="head" data={websiteSchema(site, en.site.tagline)} />
  <JsonLd slot="head" data={organizationSchema(site)} />
  <div class="container">
    <section class="hero">
      <div>
        <h1>{en.home.heading}</h1>
        <p class="lead">{en.home.lead}</p>
      </div>
      <HeroArt />
    </section>
    <CategoryPills />
    <h2 class="sr-only">{en.home.toolsHeading}</h2>
    <div class="tools">
      <ToolGrid tools={listedTools()} />
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-block: var(--space-lg);
  }

  .lead {
    max-width: 38rem;
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
  }

  .tools {
    margin-top: var(--space-md);
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-xl);
    }
  }
</style>
