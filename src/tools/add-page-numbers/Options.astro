---
import PageGrid from "../../components/PageGrid.astro";
import en from "../../i18n/en.json";

const t = en.addPageNumbers;
const MODE_ICONS = {
  single: '<rect x="7" y="3" width="10" height="18" rx="1"/>',
  facing: '<rect x="2" y="4" width="9" height="16" rx="1"/><rect x="13" y="4" width="9" height="16" rx="1"/>',
} as const;
const modes = ["single", "facing"] as const;
const spots = ["top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right"] as const;
const margins = ["small", "recommended", "big"] as const;
const texts = ["number", "page", "pageOf", "custom"] as const;
const fonts = ["helvetica", "times", "courier"] as const;
const sizes = [8, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48];
---

<div class="numbers-layout" data-numbers-options data-testid="numbers-options">
  <aside class="numbers-panel" aria-labelledby="numbers-panel-title">
    <h3 class="numbers-panel-title" id="numbers-panel-title">{t.panelTitle}</h3>

    <fieldset class="numbers-group">
      <legend>{t.pageMode}</legend>
      <div class="numbers-modes">
        {
          modes.map((mode) => (
            <label class="numbers-mode">
              <input type="radio" name="num-mode" value={mode} checked={mode === "single"} />
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={MODE_ICONS[mode]} />
              <span>{t.modes[mode]}</span>
            </label>
          ))
        }
      </div>
      <label class="numbers-check" data-cover-row hidden><input type="checkbox" data-cover />{t.cover}</label>
    </fieldset>

    <div class="numbers-row">
      <fieldset class="numbers-group">
        <legend>{t.position}</legend>
        <div class="numbers-spots">
          {
            spots.map((spot) => (
              <label class="numbers-spot" title={t.positions[spot]}>
                <input type="radio" name="num-spot" value={spot} checked={spot === "bottom-right"} aria-label={t.positions[spot]} />
                <span class="numbers-dot" aria-hidden="true" />
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="numbers-field">
        <label for="num-margin">{t.margin}</label>
        <select id="num-margin" data-margin>
          {margins.map((margin) => <option value={margin} selected={margin === "recommended"}>{t.margins[margin]}</option>)}
        </select>
      </div>
    </div>

    <fieldset class="numbers-group">
      <legend>{t.pages}</legend>
      <div class="numbers-boxes">
        <label class="numbers-box"><span>{t.firstNumber}</span><input type="number" inputmode="numeric" min="0" step="1" value="1" data-first aria-label={t.firstNumber} /></label>
      </div>
      <p class="numbers-subhead">{t.whichPages}</p>
      <div class="numbers-boxes numbers-boxes-2">
        <label class="numbers-box"><span>{t.fromPage}</span><input type="number" inputmode="numeric" min="1" step="1" value="1" data-from aria-label={t.fromLabel} /></label>
        <label class="numbers-box"><span>{t.toPage}</span><input type="number" inputmode="numeric" min="1" step="1" value="1" data-to aria-label={t.toLabel} /></label>
      </div>
    </fieldset>

    <div class="numbers-field">
      <label for="num-text">{t.text}</label>
      <select id="num-text" data-text>
        {texts.map((text) => <option value={text} selected={text === "number"}>{t.texts[text]}</option>)}
      </select>
    </div>
    <div class="numbers-field" data-custom-row hidden>
      <label for="num-custom">{t.customLabel}</label>
      <input id="num-custom" type="text" maxlength="120" value="Page {n} of {p}" data-custom aria-describedby="num-custom-hint" />
      <p class="numbers-hint" id="num-custom-hint">{t.customHint}</p>
    </div>
    <div class="numbers-field">
      <label for="num-digits">{t.digits}</label>
      <select id="num-digits" data-digits>
        <option value="latin" selected>{t.digitStyles.latin}</option>
        <option value="bangla" lang="bn">{t.digitStyles.bangla}</option>
      </select>
    </div>

    <fieldset class="numbers-group">
      <legend>{t.format}</legend>
      <div class="numbers-format">
        <select data-font aria-label={t.font}>
          {fonts.map((font) => <option value={font} selected={font === "helvetica"}>{t.fonts[font]}</option>)}
        </select>
        <select data-size aria-label={t.size}>
          {sizes.map((size) => <option value={size} selected={size === 14}>{size}</option>)}
        </select>
        <label class="numbers-toggle" title={t.bold}><input type="checkbox" data-bold aria-label={t.bold} /><b aria-hidden="true">B</b></label>
        <label class="numbers-toggle" title={t.italic}><input type="checkbox" data-italic aria-label={t.italic} /><i aria-hidden="true">I</i></label>
        <label class="numbers-toggle" title={t.underline}><input type="checkbox" data-underline aria-label={t.underline} /><u aria-hidden="true">U</u></label>
        <label class="numbers-color" title={t.color}><input type="color" value="#000000" data-color aria-label={t.color} /></label>
      </div>
    </fieldset>

    <input type="hidden" name="numbers" data-numbers />
  </aside>

  <div class="numbers-preview">
    <PageGrid name="numbers-grid" />
  </div>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { previewPdfOutput } from "../../lib/pdf/preview";
  import { createPageGrid } from "../../lib/shell/page-grid";
  import { FAMILIES } from "../../lib/pdf/text-picture";
  import { MARGINS, labelFor, numbering, onLeft, readSettings, type Settings } from "./numbers";

  const t = en.addPageNumbers;
  // Previews are drawn as if pages were A4 wide, so sizes and margins look in proportion.
  const PREVIEW_WIDTH_PT = 595;

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-numbers-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const $ = <T extends HTMLElement>(selector: string) => box.querySelector(selector) as T;
    const first = $<HTMLInputElement>("[data-first]");
    const from = $<HTMLInputElement>("[data-from]");
    const to = $<HTMLInputElement>("[data-to]");
    const text = $<HTMLSelectElement>("[data-text]");
    const custom = $<HTMLInputElement>("[data-custom]");
    const output = $<HTMLInputElement>("[data-numbers]");

    let file: File | null = null;
    let pageCount = 0;
    // Until someone changes "to", it means the last page of every file.
    let toChanged = false;
    let current: Settings = readSettings("");

    const picked = (name: string) => box.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";
    const checked = (selector: string) => $<HTMLInputElement>(selector).checked;

    function read(): Settings {
      const [vertical, horizontal] = picked("num-spot").split("-");
      return readSettings(
        JSON.stringify({
          mode: picked("num-mode"),
          cover: checked("[data-cover]"),
          vertical,
          horizontal,
          margin: $<HTMLSelectElement>("[data-margin]").value,
          first: first.value,
          from: from.value,
          to: toChanged ? to.value : null,
          text: text.value,
          custom: custom.value,
          digits: $<HTMLSelectElement>("[data-digits]").value,
          font: $<HTMLSelectElement>("[data-font]").value,
          size: $<HTMLSelectElement>("[data-size]").value,
          bold: checked("[data-bold]"),
          italic: checked("[data-italic]"),
          underline: checked("[data-underline]"),
          color: $<HTMLInputElement>("[data-color]").value,
        }),
      );
    }

    // The number as it will look on a page, drawn over the page's picture in proportion.
    function mark(page: number): HTMLElement | null {
      if (!pageCount) return null;
      const { pages, last } = numbering(current, pageCount);
      const entry = pages.find((item) => item.page === page);
      if (!entry) return null;
      const layer = document.createElement("span");
      const label = document.createElement("span");
      label.className = "numbers-mark";
      label.setAttribute("data-testid", "number-mark");
      const left = onLeft(page, current);
      const horizontal = left && current.horizontal !== "center" ? (current.horizontal === "left" ? "right" : "left") : current.horizontal;
      label.dataset.spot = `${current.vertical}-${horizontal}`;
      label.textContent = labelFor(current, entry.n, last);
      label.style.setProperty("--size", String(current.size / PREVIEW_WIDTH_PT));
      label.style.setProperty("--gap", String(MARGINS[current.margin] / PREVIEW_WIDTH_PT));
      label.style.fontFamily = FAMILIES[current.font];
      label.style.fontWeight = current.bold ? "700" : "400";
      label.style.fontStyle = current.italic ? "italic" : "normal";
      label.style.textDecoration = current.underline ? "underline" : "none";
      label.style.color = current.color;
      layer.append(label);
      return layer;
    }

    const grid = createPageGrid({
      list: $<HTMLOListElement>('[data-el="numbers-grid-list"]'),
      status: $<HTMLElement>('[data-el="numbers-grid-status"]'),
      open: previewPdfOutput,
      overlay: mark,
      onZoom(page, fromButton) {
        if (file) shell.dispatchEvent(new CustomEvent("anytools:preview-file", { detail: { file, from: fromButton, page } }));
      },
    });

    function sync() {
      current = read();
      const isCustom = current.text === "custom";
      $<HTMLElement>("[data-custom-row]").hidden = !isCustom;
      $<HTMLElement>("[data-cover-row]").hidden = current.mode !== "facing";
      output.value = JSON.stringify(current);
      grid.decorate();
    }

    // Bangla letters come from a font that loads when first used; previews are drawn again once it arrives.
    document.fonts.addEventListener("loadingdone", () => grid.decorate());

    // Numbers are tidied when leaving a box: first from 0, pages within the file, and "to" never before "from".
    function tidy() {
      first.value = String(current.first);
      if (!pageCount) return;
      const start = Math.min(Math.max(current.from, 1), pageCount);
      from.value = String(start);
      if (toChanged) to.value = String(Math.min(Math.max(Number(to.value) || pageCount, start), pageCount));
      sync();
    }

    box.addEventListener("input", (event) => {
      if (event.target === to) toChanged = true;
      sync();
    });
    box.addEventListener("change", (event) => {
      if (event.target === first || event.target === from || event.target === to) tidy();
      else sync();
    });

    shell.addEventListener("anytools:files", async (event) => {
      const next = (event as CustomEvent<{ files: File[] }>).detail.files[0] ?? null;
      if (next === file) return;
      file = next;
      pageCount = 0;
      sync();
      pageCount = (await grid.load(file)) ?? 0;
      if (!file || !pageCount) return;
      $<HTMLOListElement>('[data-el="numbers-grid-list"]').setAttribute("aria-label", fill(t.pagesLabel, { name: file.name }));
      if (!toChanged) to.value = String(pageCount);
      from.max = to.max = String(pageCount);
      sync();
      grid.showPages(new Set(), false);
      // Bring the choices into view, so the next step is obvious after choosing a file.
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    });

    sync();
  }
</script>

<style>
  /* Like most PDF tools: the options in a panel on the right, the pages on the left. Phones show the options first. */
  .numbers-layout {
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-md));
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .numbers-layout {
      grid-template-columns: minmax(0, 1fr) 23rem;
      align-items: start;
    }

    .numbers-preview {
      grid-column: 1;
      grid-row: 1;
    }

    .numbers-panel {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-md));
      grid-column: 2;
    }
  }

  .numbers-panel {
    min-width: 0;
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  @media (max-width: 399px) {
    .numbers-panel {
      padding: var(--space-md);
    }
  }

  .numbers-panel-title {
    margin: 0;
    font-size: 1.25rem;
    text-align: center;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .numbers-group {
    display: grid;
    gap: var(--space-sm);
  }

  .numbers-group legend,
  .numbers-field label {
    margin: 0 0 var(--space-sm);
    padding: 0;
    font-weight: 700;
  }

  .numbers-group legend {
    float: left;
    width: 100%;
  }

  .numbers-modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  /* Choices with pictures, like Split PDF's tabs. They are radio buttons underneath. */
  .numbers-mode {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    justify-items: center;
    min-width: 0;
    padding: var(--space-sm) 2px;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    color: var(--color-text-muted);
    font-size: clamp(0.8125rem, 3.4vw, 1rem);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .numbers-mode input,
  .numbers-spot input,
  .numbers-toggle input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .numbers-mode:has(input:checked),
  .numbers-toggle:has(input:checked) {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface));
    color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .numbers-mode:has(input:focus-visible),
  .numbers-spot:has(input:focus-visible),
  .numbers-toggle:has(input:focus-visible),
  .numbers-color:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .numbers-check {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    font-weight: 600;
    cursor: pointer;
  }

  .numbers-check[hidden],
  .numbers-field[hidden] {
    display: none;
  }

  .numbers-check input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-accent);
  }

  .numbers-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  /* The position grid: a small page split into nine spots, the chosen one marked with a dot. */
  .numbers-spots {
    display: grid;
    grid-template-columns: repeat(3, 32px);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
  }

  .numbers-spot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 36px;
    border: 1px dashed var(--color-border-subtle);
    cursor: pointer;
  }

  .numbers-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .numbers-spot:has(input:checked) .numbers-dot {
    background: var(--color-accent);
  }

  @media (hover: hover) {
    .numbers-spot:not(:has(input:checked)):hover .numbers-dot {
      background: color-mix(in srgb, var(--color-accent) 35%, transparent);
    }
  }

  .numbers-field {
    display: grid;
  }

  .numbers-field select,
  .numbers-field input,
  .numbers-format select {
    width: 100%;
    min-height: 44px;
    padding: 0 var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .numbers-field input[aria-invalid] {
    border: 2px solid var(--color-danger);
  }

  .numbers-hint {
    margin: var(--space-xs) 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .numbers-subhead {
    margin: var(--space-xs) 0 0;
    font-weight: 600;
  }

  .numbers-boxes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .numbers-boxes-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* A number box with its label inside, like Split PDF's range fields. */
  .numbers-box {
    display: flex;
    align-items: stretch;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    overflow: hidden;
  }

  .numbers-box span {
    display: flex;
    align-items: center;
    padding: 0 var(--space-sm);
    border-right: 1px solid var(--color-border-subtle);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .numbers-box input {
    width: 100%;
    min-width: 0;
    padding: 0 var(--space-sm);
    border: 0;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    text-align: right;
    appearance: textfield;
  }

  .numbers-box input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
  }

  .numbers-format {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .numbers-format select:first-child {
    flex: 1 1 100%;
  }

  .numbers-format select[data-size] {
    flex: 0 0 5rem;
  }

  .numbers-toggle,
  .numbers-color {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    font-size: 1.0625rem;
    cursor: pointer;
  }

  .numbers-color input {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* The preview mark sits on the page picture, sized and placed in proportion to the real page. */
  :global(.numbers-mark) {
    position: absolute;
    font-size: max(7px, calc(var(--size) * 100cqw));
    line-height: 1;
    white-space: nowrap;
    --edge: calc(var(--gap) * 100cqw + 4%);
  }

  :global(.page-grid-overlay:has(.numbers-mark)) {
    container-type: inline-size;
  }

  :global(.numbers-mark[data-spot^="top"]) {
    top: var(--edge);
  }

  :global(.numbers-mark[data-spot^="middle"]) {
    top: 50%;
    translate: 0 -50%;
  }

  :global(.numbers-mark[data-spot^="bottom"]) {
    bottom: var(--edge);
  }

  :global(.numbers-mark[data-spot$="left"]) {
    left: calc(var(--gap) * 100cqw + 7%);
  }

  :global(.numbers-mark[data-spot$="right"]) {
    right: calc(var(--gap) * 100cqw + 7%);
  }

  :global(.numbers-mark[data-spot$="center"]) {
    left: 50%;
    translate: -50% 0;
  }

  :global(.numbers-mark[data-spot="middle-center"]) {
    translate: -50% -50%;
  }
</style>
