---
import en from "../../i18n/en.json";

const d = en.addWatermark.diagram;
const TILES = 9;
---

<figure class="mark-diagram" aria-labelledby="mark-diagram-caption" data-mark-diagram data-mode="centre">
  <div class="stage">
    <div class="doc">
      <span class="doc-name">{d.file}</span>
      <span class="sheet" aria-hidden="true"><span class="lines"></span></span>
    </div>
    <div class="cut">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
      </svg>
      <span>{d.stamp}</span>
    </div>
    <div class="doc result">
      <span class="doc-name">{d.output}</span>
      <span class="sheet" aria-hidden="true">
        <span class="lines"></span>
        <span class="stamp is-centre">DRAFT</span>
        <span class="tiles">{Array.from({ length: TILES }, () => <span class="stamp">DRAFT</span>)}</span>
      </span>
    </div>
  </div>
  <div class="controls">
    <button class="toggle" type="button" data-toggle data-label-mosaic={d.tryMosaic} data-label-centre={d.tryCentre}>{d.tryMosaic}</button>
  </div>
  <figcaption id="mark-diagram-caption" aria-live="polite" data-caption-centre={d.captionCentre} data-caption-mosaic={d.captionMosaic}>
    {d.captionCentre}
  </figcaption>
</figure>

<script>
  const figure = document.querySelector<HTMLElement>("[data-mark-diagram]");
  const toggle = figure?.querySelector<HTMLButtonElement>("[data-toggle]");
  const caption = figure?.querySelector<HTMLElement>("figcaption");

  // Switches between one diagonal watermark and Mosaic.
  toggle?.addEventListener("click", () => {
    if (!figure || !caption) return;
    const mosaic = figure.dataset.mode === "centre";
    figure.dataset.mode = mosaic ? "mosaic" : "centre";
    caption.textContent = (mosaic ? caption.dataset.captionMosaic : caption.dataset.captionCentre) ?? "";
    toggle.textContent = (mosaic ? toggle.dataset.labelCentre : toggle.dataset.labelMosaic) ?? "";
  });
</script>

<style>
  .mark-diagram {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .stage {
    display: grid;
    align-items: center;
    gap: var(--space-md);
  }

  .doc {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-bg);
  }

  .doc.result {
    border: 2px solid var(--color-accent);
  }

  .doc-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .sheet {
    position: relative;
    display: block;
    width: 6rem;
    height: 8rem;
    padding: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #ffffff;
  }

  .lines {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(#c7cfca 0 2px, transparent 2px 8px);
  }

  /* The watermark: red, half see-through and turned 45 degrees, like a stamp. */
  .stamp {
    color: #c8312a;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.5;
  }

  .is-centre {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    rotate: -45deg;
    font-size: 1.25rem;
  }

  .tiles {
    position: absolute;
    inset: -10px;
    display: none;
    grid-template-columns: repeat(3, 1fr);
    place-items: center;
    rotate: -30deg;
  }

  .tiles .stamp {
    font-size: 0.625rem;
  }

  .mark-diagram[data-mode="mosaic"] .is-centre {
    display: none;
  }

  .mark-diagram[data-mode="mosaic"] .tiles {
    display: grid;
  }

  .cut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
  }

  .controls {
    margin-top: var(--space-lg);
  }

  .toggle {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @media (hover: hover) {
    .toggle:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  figcaption {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
