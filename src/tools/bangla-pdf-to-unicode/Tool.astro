---
import ToolShell from "../../components/ToolShell.astro";
import en from "../../i18n/en.json";
import Options from "./Options.astro";
import { tool } from "./tool";
---

<ToolShell config={tool.config} selectLabel={en.banglaPdfToUnicode.selectLabel} runLabel={en.banglaPdfToUnicode.runLabel}>
  <Options slot="options" />
</ToolShell>

<script>
  import { mountToolShell } from "../../lib/shell/mount";
  import { tool } from "./tool";

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  if (root) mountToolShell(root, tool);
</script>
