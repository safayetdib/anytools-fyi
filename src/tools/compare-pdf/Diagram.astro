---
import en from "../../i18n/en.json";

const d = en.comparePdf.diagram;
---

<figure class="compare-diagram" aria-labelledby="compare-diagram-caption">
  <div class="pair" aria-hidden="true">
    <div class="doc">
      <span class="doc-name">{d.before}</span>
      <span class="sheet"><span class="lines"></span><span class="mark is-removed"></span></span>
    </div>
    <div class="doc result">
      <span class="doc-name">{d.after}</span>
      <span class="sheet"><span class="lines"></span><span class="mark is-added"></span></span>
    </div>
  </div>
  <p class="action">{d.action}</p>
  <figcaption id="compare-diagram-caption">{d.caption}</figcaption>
</figure>

<style>
  .compare-diagram {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: var(--space-md);
    justify-content: center;
  }

  .doc {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    min-width: 0;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-bg);
  }

  .doc.result {
    border: 2px solid var(--color-accent);
  }

  .doc-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .sheet {
    position: relative;
    display: block;
    width: 6rem;
    height: 8rem;
    padding: 12px 10px;
    border: 1px solid var(--color-border);
    background: #ffffff;
  }

  .lines {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(#5f6b65 0 2px, transparent 2px 9px);
  }

  /* The same line on both pages: the old words in red, the new ones in green. */
  .mark {
    position: absolute;
    top: 33px;
    height: 8px;
    mix-blend-mode: multiply;
  }

  .mark.is-removed {
    left: 34px;
    width: 1.75rem;
    background: rgb(242 89 89 / 0.75);
  }

  .mark.is-added {
    left: 34px;
    width: 2.25rem;
    background: rgb(77 204 115 / 0.75);
  }

  .action {
    margin: var(--space-md) 0 0;
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
  }

  figcaption {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
