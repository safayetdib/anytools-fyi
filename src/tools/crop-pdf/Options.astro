---
import en from "../../i18n/en.json";

const t = en.cropPdf;
const modes = ["all", "current"] as const;
const sides = ["top", "bottom", "left", "right"] as const;
const handles = ["nw", "n", "ne", "e", "se", "s", "sw", "w"] as const;
---

<div class="crop-layout" data-crop-options data-testid="crop-options">
  <section class="crop-stage" aria-labelledby="crop-stage-title">
    <h3 class="sr-only" id="crop-stage-title">{t.stageTitle}</h3>
    <div class="crop-view">
      <div class="crop-sheet is-loading" data-sheet data-testid="crop-sheet">
        <img class="crop-page" data-page-image alt="" draggable="false" hidden />
        <span class="crop-shade" aria-hidden="true"><span class="crop-hole" data-hole hidden></span></span>
        <div class="crop-box" data-box data-testid="crop-box" tabindex="0" role="group" aria-label={t.boxLabel} aria-describedby="crop-help" hidden>
          {handles.map((handle) => <span class="crop-handle" data-handle={handle} aria-hidden="true" />)}
          <span class="crop-size" data-size aria-hidden="true"></span>
        </div>
      </div>
    </div>
    <nav class="crop-nav" aria-label={t.navLabel}>
      <button type="button" class="crop-step" data-prev aria-label={t.previous}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <span class="crop-page-status" data-page-status data-testid="crop-page-status" aria-live="polite"></span>
      <button type="button" class="crop-step" data-next aria-label={t.next}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </nav>
    <p class="crop-help" id="crop-help">{t.help}<span class="crop-keys"> {t.helpKeys}</span></p>
  </section>

  <aside class="crop-panel" aria-labelledby="crop-panel-title">
    <h3 class="crop-panel-title" id="crop-panel-title">{t.panelTitle}</h3>

    <fieldset class="crop-modes">
      <legend>{t.modeLegend}</legend>
      {
        modes.map((mode) => (
          <label class="crop-mode">
            <input type="radio" name="crop-mode" value={mode} checked={mode === "all"} />
            <span class="crop-mode-title">{t.modes[mode]}</span>
            <span class="crop-mode-note">{t.modeNotes[mode]}</span>
          </label>
        ))
      }
    </fieldset>

    <fieldset class="crop-margins">
      <legend>{t.marginsLegend}</legend>
      <div class="crop-margin-grid">
        {
          sides.map((side) => (
            <label class="crop-margin">
              <span>{t.sides[side]}</span>
              <input type="number" inputmode="decimal" min="0" step="1" value="0" data-margin={side} />
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="crop-actions">
      <button type="button" class="crop-action" data-fit>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3"></path><path d="M16 3h3a2 2 0 0 1 2 2v3"></path><path d="M21 16v3a2 2 0 0 1-2 2h-3"></path><path d="M8 21H5a2 2 0 0 1-2-2v-3"></path><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>
        {t.fit}
      </button>
      <button type="button" class="crop-action" data-reset>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path></svg>
        {t.reset}
      </button>
    </div>
    <p class="crop-status" data-status data-testid="crop-status" role="status"></p>
    <input type="hidden" name="crop" data-crop-value />
  </aside>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { openPdf, renderPage, type PdfDocument } from "../../lib/pdf/preview";
  import { isFullPage, type CropRect } from "../../lib/shell/crop";
  import { FULL, MIN_SIDE, MM_PER_POINT, boxFromMargins, dragBox, inkBox, marginsOf, nudgeBox, type Handle, type Margins } from "./box";

  const t = en.cropPdf;
  // Sharp enough for a large screen, small enough for phones.
  const MAX_RENDER_WIDTH = 1600;
  // Pages are checked for blank paper at this width; finer gains nothing for a crop box.
  const FIT_WIDTH = 500;

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-crop-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const $ = <T extends HTMLElement>(selector: string) => box.querySelector(selector) as T;
    const sheet = $<HTMLElement>("[data-sheet]");
    const image = $<HTMLImageElement>("[data-page-image]");
    const cropEl = $<HTMLElement>("[data-box]");
    const hole = $<HTMLElement>("[data-hole]");
    const sizeEl = $<HTMLElement>("[data-size]");
    const prev = $<HTMLButtonElement>("[data-prev]");
    const next = $<HTMLButtonElement>("[data-next]");
    const pageStatus = $<HTMLElement>("[data-page-status]");
    const status = $<HTMLElement>("[data-status]");
    const value = $<HTMLInputElement>("[data-crop-value]");
    const fitButton = $<HTMLButtonElement>("[data-fit]");
    const resetButton = $<HTMLButtonElement>("[data-reset]");
    const margins = Array.from(box.querySelectorAll<HTMLInputElement>("[data-margin]"));
    const runButton = shell.querySelector<HTMLButtonElement>('[data-el="run"]');

    let file: File | null = null;
    let doc: PdfDocument | null = null;
    let closeDoc: (() => void) | null = null;
    let pageCount = 0;
    let current = 1;
    // Each page's size as shown, in points, once known.
    const sizes = new Map<number, [number, number]>();
    let allBox: CropRect = FULL;
    const pageBoxes = new Map<number, CropRect>();
    let drawn = 0;

    const mode = () => (box.querySelector<HTMLInputElement>('input[name="crop-mode"]:checked')?.value ?? "all") as "all" | "current";
    const boxOf = (page: number) => (mode() === "all" ? allBox : (pageBoxes.get(page) ?? FULL));
    const sizeOf = (page: number) => sizes.get(page) ?? [595.28, 841.89];

    function setBox(next: CropRect) {
      if (mode() === "all") allBox = next;
      else if (isFullPage(next)) pageBoxes.delete(current);
      else pageBoxes.set(current, next);
      draw();
      sync();
    }

    function draw() {
      const crop = boxOf(current);
      for (const element of [cropEl, hole]) {
        element.style.left = `${crop.x * 100}%`;
        element.style.top = `${crop.y * 100}%`;
        element.style.width = `${crop.width * 100}%`;
        element.style.height = `${crop.height * 100}%`;
      }
      const [width, height] = sizeOf(current);
      const mm = (share: number, side: number) => Math.round(share * side * MM_PER_POINT);
      sizeEl.textContent = fill(t.size, { width: mm(crop.width, width), height: mm(crop.height, height) });
      const full = isFullPage(crop);
      cropEl.classList.toggle("is-full", full);
      hole.hidden = full || cropEl.hidden;
      const cut = marginsOf(crop, width, height);
      for (const input of margins) {
        if (input !== document.activeElement) input.value = String(cut[input.dataset.margin as keyof Margins]);
      }
      // Lets screen reader users hear where the box is as they move it.
      cropEl.setAttribute("aria-label", fill(t.boxLabelValue, { ...cut }));
    }

    function sync() {
      const all = mode() === "all";
      const pages = [...pageBoxes].map(([page, crop]) => ({ page, box: crop })).sort((a, b) => a.page - b.page);
      value.value = JSON.stringify({ all: all ? allBox : null, pages: all ? [] : pages });
      const any = all ? !isFullPage(allBox) : pages.length > 0;
      if (!file) status.textContent = "";
      else if (all) status.textContent = any ? t.statusAll : t.statusNone;
      else status.textContent = pages.length === 0 ? t.statusNone : pages.length === 1 ? t.statusOne : fill(t.statusMany, { count: pages.length });
      pageStatus.textContent = pageCount ? fill(t.pageOf, { page: current, count: pageCount }) : "";
      prev.disabled = current <= 1;
      next.disabled = current >= pageCount;
      fitButton.disabled = resetButton.disabled = !doc;
      if (runButton) runButton.disabled = !any;
    }

    async function showPage(page: number) {
      if (!doc) return;
      current = page;
      const ticket = ++drawn;
      sync();
      sheet.classList.add("is-loading");
      const handle = doc;
      try {
        if (!sizes.has(page)) {
          // Margins are measured against the page's real size, so they wait for it.
          for (const input of margins) input.disabled = true;
          const pdfPage = await handle.getPage(page);
          const { width, height } = pdfPage.getViewport({ scale: 1 });
          sizes.set(page, [width, height]);
          if (ticket === drawn) for (const input of margins) input.disabled = false;
        }
        const [width, height] = sizeOf(page);
        sheet.style.aspectRatio = `${width} / ${height}`;
        sheet.style.setProperty("--sheet-ratio", String(width / height));
        draw();
        const pixels = Math.min(MAX_RENDER_WIDTH, Math.round(sheet.clientWidth * (window.devicePixelRatio || 1)) || 800);
        const rendered = await renderPage(handle, page, pixels);
        if (ticket !== drawn || handle !== doc) return;
        if (image.src) URL.revokeObjectURL(image.src);
        image.src = URL.createObjectURL(rendered.blob);
        image.hidden = false;
        cropEl.hidden = false;
        draw();
      } catch {
        // The shell already tells people when a file can't be read.
      } finally {
        if (ticket === drawn) sheet.classList.remove("is-loading");
      }
    }

    function clear() {
      closeDoc?.();
      doc = null;
      closeDoc = null;
      pageCount = 0;
      current = 1;
      sizes.clear();
      pageBoxes.clear();
      allBox = FULL;
      if (image.src) URL.revokeObjectURL(image.src);
      image.removeAttribute("src");
      image.hidden = true;
      cropEl.hidden = true;
      hole.hidden = true;
    }

    // Dragging the box moves it, its handles resize it, and dragging on the page outside it draws a new one.
    let drag: { handle: Handle; x: number; y: number; start: CropRect } | null = null;
    sheet.addEventListener("pointerdown", (event) => {
      if (!doc || cropEl.hidden || event.button > 0) return;
      event.preventDefault();
      const area = sheet.getBoundingClientRect();
      let handle = ((event.target as HTMLElement).dataset.handle ?? "move") as Handle;
      let start = boxOf(current);
      if (!cropEl.contains(event.target as Node)) {
        const x = Math.min(1 - MIN_SIDE, Math.max(0, (event.clientX - area.left) / area.width));
        const y = Math.min(1 - MIN_SIDE, Math.max(0, (event.clientY - area.top) / area.height));
        start = { x, y, width: MIN_SIDE, height: MIN_SIDE };
        handle = "se";
        setBox(start);
      }
      sheet.setPointerCapture(event.pointerId);
      drag = { handle, x: event.clientX, y: event.clientY, start };
      cropEl.focus({ preventScroll: true });
    });
    sheet.addEventListener("pointermove", (event) => {
      if (!drag) return;
      const area = sheet.getBoundingClientRect();
      setBox(dragBox(drag.start, drag.handle, (event.clientX - drag.x) / area.width, (event.clientY - drag.y) / area.height));
    });
    const endDrag = () => (drag = null);
    sheet.addEventListener("pointerup", endDrag);
    sheet.addEventListener("pointercancel", endDrag);

    cropEl.addEventListener("keydown", (event) => {
      const moved = nudgeBox(boxOf(current), event.key, event.shiftKey);
      if (!moved) return;
      event.preventDefault();
      setBox(moved);
    });

    for (const input of margins) {
      input.addEventListener("input", () => {
        const cut = Object.fromEntries(margins.map((field) => [field.dataset.margin, Number.parseFloat(field.value)])) as unknown as Margins;
        const [width, height] = sizeOf(current);
        setBox(boxFromMargins(cut, width, height));
      });
      // Shows the number actually used once typing is done, such as after a margin too big for the page.
      input.addEventListener("change", () => {
        input.blur();
        draw();
      });
    }

    prev.addEventListener("click", () => void showPage(Math.max(1, current - 1)));
    next.addEventListener("click", () => void showPage(Math.min(pageCount, current + 1)));

    fitButton.addEventListener("click", async () => {
      if (!doc) return;
      const rendered = await renderPage(doc, current, FIT_WIDTH);
      const bitmap = await createImageBitmap(rendered.blob);
      const canvas = document.createElement("canvas");
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      const context = canvas.getContext("2d", { willReadFrequently: true }) as CanvasRenderingContext2D;
      context.drawImage(bitmap, 0, 0);
      bitmap.close();
      const found = inkBox(context.getImageData(0, 0, canvas.width, canvas.height).data, canvas.width, canvas.height);
      canvas.width = canvas.height = 0;
      if (!found) {
        status.textContent = t.blank;
        return;
      }
      setBox(found);
    });

    resetButton.addEventListener("click", () => setBox(FULL));

    box.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name !== "crop-mode") return;
      // Switching keeps the box people already drew: on this page, or for every page.
      if (target.value === "current") {
        pageBoxes.clear();
        if (!isFullPage(allBox)) pageBoxes.set(current, allBox);
      } else allBox = pageBoxes.get(current) ?? allBox;
      draw();
      sync();
    });

    // Pages are drawn again at the new size when the layout changes width, such as turning a phone.
    let lastWidth = 0;
    let resizeTimer = 0;
    new ResizeObserver(() => {
      const width = sheet.clientWidth;
      if (!doc || Math.abs(width - lastWidth) < 40) return;
      lastWidth = width;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => void showPage(current), 200);
    }).observe(sheet);

    shell.addEventListener("anytools:files", async (event) => {
      const chosen = (event as CustomEvent<{ files: File[] }>).detail.files[0] ?? null;
      if (chosen === file) return;
      file = chosen;
      clear();
      sync();
      if (!chosen) return;
      try {
        const opened = await openPdf(new Uint8Array(await chosen.arrayBuffer()));
        if (file !== chosen) {
          opened.close();
          return;
        }
        doc = opened.doc;
        closeDoc = opened.close;
        pageCount = opened.doc.numPages;
        lastWidth = sheet.clientWidth;
        await showPage(1);
      } catch {
        // The shell already tells people the file can't be read.
      }
      sync();
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    });

    sync();
  }
</script>

<style>
  /* Like most PDF tools: the page large on the left, the options in a panel on the right. Phones show the page first. */
  .crop-layout {
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-md));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .crop-layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }

    .crop-panel {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-md));
    }
  }

  .crop-stage {
    min-width: 0;
    display: grid;
    gap: var(--space-md);
    justify-items: center;
  }

  /* Room around the page, so the handles on its edges stay easy to grab. */
  .crop-view {
    width: 100%;
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    border-radius: var(--radius-card);
    background: var(--color-bg-subtle, color-mix(in srgb, var(--color-text) 6%, var(--color-bg)));
  }

  .crop-sheet {
    position: relative;
    /* As tall as fits between the header and the bottom bar, so the whole page and its handles are in view. */
    width: min(100%, 36rem, calc((100vh - 20rem) * var(--sheet-ratio, 0.7071)), calc((100dvh - 20rem) * var(--sheet-ratio, 0.7071)));
    min-width: 12rem;
    aspect-ratio: 595 / 842;
    background: #ffffff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: crosshair;
  }

  .crop-sheet.is-loading {
    animation: crop-pulse 1.2s ease-in-out infinite;
  }

  @keyframes crop-pulse {
    50% {
      opacity: 0.6;
    }
  }

  .crop-page {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Everything outside the box is dimmed: that part is cut away. The shade is clipped to the page; the box isn't,
     so its handles stay whole on the page's edges. */
  .crop-shade {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .crop-hole {
    position: absolute;
    box-shadow: 0 0 0 9999px rgb(0 0 0 / 0.45);
  }

  .crop-hole[hidden] {
    display: none;
  }

  .crop-box {
    position: absolute;
    border: 2px dashed #ffffff;
    outline: 1px solid rgb(0 0 0 / 0.65);
    cursor: move;
    touch-action: none;
  }

  .crop-box.is-full {
    border-color: var(--color-accent);
    outline-color: transparent;
  }

  .crop-box:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .crop-handle {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 3px solid #ffffff;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5);
    touch-action: none;
  }

  /* A bigger, invisible area around each handle for fingers. */
  .crop-handle::after {
    content: "";
    position: absolute;
    inset: -12px;
  }

  .crop-handle[data-handle="nw"] {
    top: -11px;
    left: -11px;
    cursor: nwse-resize;
  }

  .crop-handle[data-handle="n"] {
    top: -11px;
    left: calc(50% - 10px);
    cursor: ns-resize;
  }

  .crop-handle[data-handle="ne"] {
    top: -11px;
    right: -11px;
    cursor: nesw-resize;
  }

  .crop-handle[data-handle="e"] {
    top: calc(50% - 10px);
    right: -11px;
    cursor: ew-resize;
  }

  .crop-handle[data-handle="se"] {
    right: -11px;
    bottom: -11px;
    cursor: nwse-resize;
  }

  .crop-handle[data-handle="s"] {
    bottom: -11px;
    left: calc(50% - 10px);
    cursor: ns-resize;
  }

  .crop-handle[data-handle="sw"] {
    bottom: -11px;
    left: -11px;
    cursor: nesw-resize;
  }

  .crop-handle[data-handle="w"] {
    top: calc(50% - 10px);
    left: -11px;
    cursor: ew-resize;
  }

  .crop-size {
    position: absolute;
    left: 50%;
    bottom: 8px;
    translate: -50% 0;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.72);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
  }

  .crop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .crop-step {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .crop-step:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .crop-step:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .crop-page-status {
    min-width: 8rem;
    font-weight: 600;
    text-align: center;
  }

  .crop-help {
    max-width: 36rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (pointer: coarse) {
    .crop-keys {
      display: none;
    }
  }

  .crop-panel {
    min-width: 0;
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  @media (max-width: 399px) {
    .crop-panel {
      padding: var(--space-md);
    }

    .crop-view {
      padding: var(--space-md);
    }
  }

  .crop-panel-title {
    margin: 0;
    font-size: 1.25rem;
    text-align: center;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin: 0 0 var(--space-sm);
    padding: 0;
    font-weight: 700;
  }

  .crop-modes {
    display: grid;
    gap: var(--space-sm);
  }

  .crop-modes legend {
    float: left;
    width: 100%;
  }

  .crop-mode {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px var(--space-sm);
    align-items: start;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .crop-mode input {
    grid-row: span 2;
    width: 1.125rem;
    height: 1.125rem;
    margin: 2px 0 0;
    accent-color: var(--color-accent);
  }

  .crop-mode:has(input:checked) {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .crop-mode:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .crop-mode-title {
    font-weight: 700;
  }

  .crop-mode-note {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .crop-margin-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .crop-margin {
    display: grid;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.875rem;
