---
import en from "../../i18n/en.json";

const d = en.editPdf.diagram;
---

<figure class="edit-diagram" aria-labelledby="edit-diagram-caption">
  <div class="stage">
    <div class="doc">
      <span class="doc-name">{d.file}</span>
      <span class="doc-meta">{d.before}</span>
      <span class="sheet" aria-hidden="true"><span class="lines"></span></span>
    </div>
    <div class="cut">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
      </svg>
      <span>{d.action}</span>
    </div>
    <div class="doc result">
      <span class="doc-name">{d.file}</span>
      <span class="doc-meta">{d.after}</span>
      <span class="sheet" aria-hidden="true">
        <span class="lines"></span>
        <span class="mark-highlight"></span>
        <span class="mark-whiteout"></span>
        <span class="mark-stamp">{d.added}</span>
      </span>
    </div>
  </div>
  <figcaption id="edit-diagram-caption">{d.caption}</figcaption>
</figure>

<style>
  .edit-diagram {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .stage {
    display: grid;
    align-items: center;
    gap: var(--space-md);
  }

  .doc {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-bg);
  }

  .doc.result {
    border: 2px solid var(--color-accent);
  }

  .doc-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .doc-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .result .doc-meta {
    color: var(--color-accent);
  }

  .sheet {
    position: relative;
    display: block;
    width: 6rem;
    height: 8rem;
    padding: 12px 10px;
    border: 1px solid var(--color-border);
    background: #ffffff;
  }

  .lines {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(#5f6b65 0 2px, transparent 2px 9px);
  }

  /* A highlighted line, a covered line and an added stamp, as the tool makes them. */
  .mark-highlight {
    position: absolute;
    top: 28px;
    left: 8px;
    width: 3.25rem;
    height: 8px;
    background: #ffe14d;
    mix-blend-mode: multiply;
  }

  .mark-whiteout {
    position: absolute;
    top: 55px;
    left: 9px;
    width: 4rem;
    height: 12px;
    background: #ffffff;
  }

  .mark-stamp {
    position: absolute;
    right: 6px;
    bottom: 10px;
    padding: 1px 5px;
    border: 2px solid #c62828;
    border-radius: 3px;
    background: #ffffff;
    color: #c62828;
    font-size: 0.6875rem;
    font-weight: 700;
    transform: rotate(-8deg);
  }

  .cut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
  }

  figcaption {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
