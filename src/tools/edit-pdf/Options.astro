---
import en from "../../i18n/en.json";

const t = en.editPdf;
const TOOLS = ["select", "text", "image", "draw", "rect", "ellipse", "line", "highlight", "whiteout"] as const;
const COLORS = Object.keys(t.colors) as (keyof typeof t.colors)[];
// Small pictures of each tool, drawn like the site's other icons.
const ICONS: Record<(typeof TOOLS)[number], string> = {
  select: '<path d="M5 3l13 8-6 1.5L9 19z"/>',
  text: '<path d="M5 6V4h14v2"/><path d="M12 4v16"/><path d="M9 20h6"/>',
  image: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="m21 16-5-5-8 8"/>',
  draw: '<path d="M4 17c3-6 6 4 9-2s5-6 7-3"/>',
  rect: '<rect x="4" y="6" width="16" height="12" rx="1"/>',
  ellipse: '<ellipse cx="12" cy="12" rx="8" ry="6"/>',
  line: '<path d="M5 19 19 5"/>',
  highlight: '<path d="m9 15 6-6 3 3-6 6H9z"/><path d="M4 20h7"/>',
  whiteout: '<rect x="4" y="7" width="16" height="10" rx="1"/><path d="M8 12h8" stroke-dasharray="2 2"/>',
};
---

<div class="edit-layout" data-edit-options data-testid="edit-options">
  <aside class="edit-panel" aria-labelledby="edit-panel-title">
    <h3 class="edit-panel-title" id="edit-panel-title">{t.panelTitle}</h3>

    <fieldset class="edit-tools">
      <legend class="sr-only">{t.toolsLegend}</legend>
      {
        TOOLS.map((tool) => (
          <label class="edit-tool">
            <input type="radio" name="edit-tool" value={tool} checked={tool === "select"} />
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[tool]} />
            <span>{t.tools[tool]}</span>
          </label>
        ))
      }
    </fieldset>
    <p class="edit-hint" id="edit-hint" data-hint>{t.hints.select}</p>

    <button type="button" class="edit-button is-main" data-choose-image hidden>{t.chooseImage}</button>
    <input type="file" accept="image/*,.heic,.heif" class="sr-only" tabindex="-1" aria-hidden="true" data-image-input />
    <p class="edit-problem" role="alert" data-image-problem></p>

    <div class="edit-styles" data-styles>
      <fieldset class="edit-colors" data-for="color">
        <legend>{t.colorLegend}</legend>
        <div class="edit-swatches">
          {
            COLORS.map((color) => (
              <label class="edit-swatch" style={`--swatch: ${color}`}>
                <input type="radio" name="edit-color" value={color} checked={color === "#111111"} aria-label={t.colors[color]} />
              </label>
            ))
          }
          <label class="edit-swatch is-custom">
            <input type="color" value="#7a3fbf" aria-label={t.customColor} data-custom-color />
          </label>
        </div>
      </fieldset>

      <div class="edit-row" data-for="text">
        <label class="edit-field">
          <span>{t.font}</span>
          <select data-font>
            {(["helvetica", "times", "courier"] as const).map((font) => <option value={font}>{t.fonts[font]}</option>)}
          </select>
        </label>
        <label class="edit-field is-small">
          <span>{t.size}</span>
          <input type="number" min="6" max="120" step="1" value="16" inputmode="numeric" data-size />
        </label>
      </div>
      <div class="edit-toggles" data-for="text">
        <label class="edit-toggle"><input type="checkbox" data-bold /><span><b>{t.bold}</b></span></label>
        <label class="edit-toggle"><input type="checkbox" data-italic /><span><i>{t.italic}</i></span></label>
      </div>

      <label class="edit-field" data-for="thickness">
        <span>{t.thickness}</span>
        <input type="range" min="1" max="12" step="1" value="2" data-thickness />
      </label>
      <label class="edit-toggle" data-for="fill"><input type="checkbox" data-fill /><span>{t.fill}</span></label>
    </div>

    <div class="edit-actions">
      <button type="button" class="edit-button" data-undo disabled>{t.undo}</button>
      <button type="button" class="edit-button" data-remove disabled>{t.remove}</button>
    </div>
    <p class="edit-count" role="status" data-count>{t.editsNone}</p>

    <input type="hidden" name="edits" data-edits-value />
  </aside>

  <ol class="edit-pages" data-pages aria-label={t.pagesLabel}></ol>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { openPdf, renderPage, type PdfDocument } from "../../lib/pdf/preview";
  import { FAMILIES } from "../../lib/pdf/text-picture";
  import { decode, uprightImage } from "../jpg-to-pdf/images";
  import { LINE_HEIGHT, type Edit, type Font } from "./edit";
  import { addImage, clearImages, imageAt } from "./image-store";

  const t = en.editPdf;
  type Tool = keyof typeof t.tools;
  type Kind = Edit["kind"];
  interface Item {
    id: number;
    edit: Edit;
  }

  // Pages are drawn sharp enough for their shown size, but never huge.
  const MAX_RENDER_WIDTH = 1400;
  const STEP = 0.01;
  const BIG_STEP = 0.05;
  const MIN_SIDE = 0.01;
  // A tap without dragging makes a shape this size, as shares of the page.
  const TAP_SIZE = { width: 0.25, height: 0.08 };
  const HISTORY = 60;
  const SVG = "http://www.w3.org/2000/svg";
  const HIGHLIGHT = "#ffe14d";

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-edit-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const $ = <T extends HTMLElement>(selector: string) => box.querySelector(selector) as T;
    const pagesList = $<HTMLOListElement>("[data-pages]");
    const hint = $<HTMLElement>("[data-hint]");
    const chooseImage = $<HTMLButtonElement>("[data-choose-image]");
    const imageInput = $<HTMLInputElement>("[data-image-input]");
    const imageProblem = $<HTMLElement>("[data-image-problem]");
    const fontSelect = $<HTMLSelectElement>("[data-font]");
    const sizeInput = $<HTMLInputElement>("[data-size]");
    const boldInput = $<HTMLInputElement>("[data-bold]");
    const italicInput = $<HTMLInputElement>("[data-italic]");
    const thicknessInput = $<HTMLInputElement>("[data-thickness]");
    const fillInput = $<HTMLInputElement>("[data-fill]");
    const customColor = $<HTMLInputElement>("[data-custom-color]");
    const undoButton = $<HTMLButtonElement>("[data-undo]");
    const removeButton = $<HTMLButtonElement>("[data-remove]");
    const count = $<HTMLElement>("[data-count]");
    const editsValue = $<HTMLInputElement>("[data-edits-value]");
    const runButton = shell.querySelector<HTMLButtonElement>('[data-el="run"]');

    let file: File | null = null;
    let pdf: { doc: PdfDocument; close: () => void } | null = null;
    // Each page's size as shown, in points, known once the page is drawn.
    const sizes = new Map<number, { width: number; height: number }>();
    let items: Item[] = [];
    let nextId = 1;
    let selected: Item | null = null;
    let currentPage = 1;
    const history: string[] = [];
    const visible = new Map<number, number>();
    let renderObserver: IntersectionObserver | null = null;
    let viewObserver: IntersectionObserver | null = null;

    const tool = () => (box.querySelector<HTMLInputElement>('input[name="edit-tool"]:checked')?.value ?? "select") as Tool;
    const color = () => box.querySelector<HTMLInputElement>('input[name="edit-color"]:checked')?.value ?? customColor.value;
    const style = () => ({
      color: color(),
      font: fontSelect.value as Font,
      size: Math.min(120, Math.max(6, Number(sizeInput.value) || 16)),
      bold: boldInput.checked,
      italic: italicInput.checked,
      thickness: Number(thicknessInput.value) || 2,
      fill: fillInput.checked,
    });
    const isBox = (kind: Kind) => kind === "image" || kind === "rect" || kind === "ellipse" || kind === "highlight" || kind === "whiteout";

    const pageItem = (page: number) => pagesList.querySelector<HTMLElement>(`[data-page="${page}"]`);
    const sheetOf = (page: number) => pageItem(page)?.querySelector<HTMLElement>(".edit-sheet") ?? null;
    const layerOf = (page: number) => sheetOf(page)?.querySelector<SVGSVGElement>(".edit-ink") ?? null;
    // Pixels on screen for each point of the page.
    const scaleOf = (page: number) => (sheetOf(page)?.clientWidth ?? 0) / (sizes.get(page)?.width ?? 595);

    // Where the first line's baseline sits below the top of a line box, as a share of the size, measured as this
    // browser draws the font, so the PDF puts the text where the page shows it.
    const baselines = new Map<string, number>();
    function baselineOf(font: Font, bold: boolean, italic: boolean): number {
      const key = `${font}${bold}${italic}`;
      if (!baselines.has(key)) {
        const context = document.createElement("canvas").getContext("2d") as CanvasRenderingContext2D;
        context.font = `${italic ? "italic " : ""}${bold ? 700 : 400} 100px ${FAMILIES[font]}`;
        const metrics = context.measureText("Hg");
        const ascent = (metrics.fontBoundingBoxAscent || 80) / 100;
        const descent = (metrics.fontBoundingBoxDescent || 20) / 100;
        baselines.set(key, (LINE_HEIGHT - ascent - descent) / 2 + ascent);
      }
      return baselines.get(key) as number;
    }

    // The area an edit covers, as shares of its page.
    function bounds(edit: Edit) {
      if (edit.kind === "line") {
        return { x: Math.min(edit.x1, edit.x2), y: Math.min(edit.y1, edit.y2), width: Math.abs(edit.x2 - edit.x1), height: Math.abs(edit.y2 - edit.y1) };
      }
      if (edit.kind === "draw") {
        const xs = edit.points.map(([x]) => x);
        const ys = edit.points.map(([, y]) => y);
        return { x: Math.min(...xs), y: Math.min(...ys), width: Math.max(...xs) - Math.min(...xs), height: Math.max(...ys) - Math.min(...ys) };
      }
      if (edit.kind === "text") {
        const element = pagesList.querySelector<HTMLElement>(`[data-item="${items.find((item) => item.edit === edit)?.id}"]`);
        const sheet = sheetOf(edit.page);
        const width = element && sheet ? element.offsetWidth / sheet.clientWidth : 0.1;
        const height = element && sheet ? element.offsetHeight / sheet.clientHeight : 0.03;
        return { x: edit.x, y: edit.y, width, height };
      }
      return { x: edit.x, y: edit.y, width: edit.width, height: edit.height };
    }

    // Moves an edit by a share of its page, keeping it on the page.
    function shift(edit: Edit, dx: number, dy: number) {
      const area = bounds(edit);
      const mx = Math.min(1 - area.x - area.width, Math.max(-area.x, dx));
      const my = Math.min(1 - area.y - area.height, Math.max(-area.y, dy));
      if (edit.kind === "line") {
        edit.x1 += mx;
        edit.x2 += mx;
        edit.y1 += my;
        edit.y2 += my;
      } else if (edit.kind === "draw") {
        edit.points = edit.points.map(([x, y]) => [x + mx, y + my]);
      } else {
        edit.x += mx;
        edit.y += my;
      }
    }

    // Resizes from the bottom-right corner, keeping a picture's shape. Text grows its letters instead.
    function resize(edit: Edit, start: Edit, dx: number, dy: number) {
      const from = bounds(start);
      if (edit.kind === "text" && start.kind === "text") {
        edit.size = Math.min(120, Math.max(6, Math.round(start.size * Math.max(0.2, (from.width + dx) / Math.max(from.width, 0.01)))));
        return;
      }
      let width = Math.min(1 - from.x, Math.max(MIN_SIDE, from.width + dx));
      let height = Math.min(1 - from.y, Math.max(MIN_SIDE, from.height + dy));
      if (edit.kind === "image") {
        const page = sizes.get(edit.page) ?? { width: 1, height: 1 };
        const ratio = (imageAt(edit.image)?.ratio ?? 1) * (page.height / page.width);
        height = width / ratio;
        if (from.y + height > 1) {
          height = 1 - from.y;
          width = height * ratio;
        }
      }
      if (isBox(edit.kind) && "width" in edit) {
        edit.width = width;
        edit.height = height;
      } else if ((edit.kind === "line" && start.kind === "line") || (edit.kind === "draw" && start.kind === "draw")) {
        const sx = from.width ? width / from.width : 1;
        const sy = from.height ? height / from.height : 1;
        const scale = ([x, y]: [number, number]): [number, number] => [from.x + (x - from.x) * sx, from.y + (y - from.y) * sy];
        if (edit.kind === "line" && start.kind === "line") {
          [edit.x1, edit.y1] = scale([start.x1, start.y1]);
          [edit.x2, edit.y2] = scale([start.x2, start.y2]);
        } else if (edit.kind === "draw" && start.kind === "draw") {
          edit.points = start.points.map(scale);
        }
      }
    }

    function remember() {
      history.push(JSON.stringify({ items, nextId }));
      if (history.length > HISTORY) history.shift();
    }

    function sync() {
      const kept = items.filter((item) => item.edit.kind !== "text" || item.edit.text.trim());
      editsValue.value = JSON.stringify(kept.map((item) => item.edit));
      count.textContent = kept.length === 0 ? t.editsNone : kept.length === 1 ? t.editsOne : fill(t.editsMany, { count: kept.length });
      undoButton.disabled = history.length === 0;
      removeButton.disabled = !selected;
      if (runButton && file) runButton.disabled = kept.length === 0;
    }

    // Shows only the style choices that apply to the tool in hand, or to what's selected.
    function showStyles() {
      const kind: Kind | Tool = selected?.edit.kind ?? tool();
      const applies: Record<string, boolean> = {
        color: !["image", "highlight", "whiteout", "select"].includes(kind),
        text: kind === "text",
        thickness: ["draw", "line", "rect", "ellipse"].includes(kind),
        fill: kind === "rect" || kind === "ellipse",
      };
      for (const element of box.querySelectorAll<HTMLElement>("[data-for]")) element.hidden = !applies[element.dataset.for ?? ""];
      if (kind === "rect" || kind === "ellipse") {
        const filled = selected && "fill" in selected.edit ? selected.edit.fill : fillInput.checked;
        $<HTMLElement>('[data-for="thickness"]').hidden = filled;
      }
      hint.textContent = t.hints[tool()];
      chooseImage.hidden = tool() !== "image";
    }

    // Shows the selected edit's look in the style choices, so changing them changes it.
    function showSelectedStyle() {
      const edit = selected?.edit;
      if (!edit) return;
      if ("color" in edit && edit.kind !== "highlight" && edit.kind !== "whiteout") {
        const swatch = box.querySelector<HTMLInputElement>(`input[name="edit-color"][value="${edit.color}"]`);
        if (swatch) swatch.checked = true;
        else {
          box.querySelectorAll<HTMLInputElement>('input[name="edit-color"]').forEach((input) => (input.checked = false));
          customColor.value = edit.color;
        }
      }
      if (edit.kind === "text") {
        fontSelect.value = edit.font;
        sizeInput.value = String(edit.size);
        boldInput.checked = edit.bold;
        italicInput.checked = edit.italic;
      }
      if ("thickness" in edit) thicknessInput.value = String(edit.thickness);
      if (edit.kind === "rect" || edit.kind === "ellipse") fillInput.checked = edit.fill;
    }

    function draw(item: Item) {
      const { edit } = item;
      const sheet = sheetOf(edit.page);
      if (!sheet) return;
      const scale = scaleOf(edit.page);
      if (edit.kind === "line" || edit.kind === "draw") {
        const layer = layerOf(edit.page);
        if (!layer) return;
        let group = layer.querySelector<SVGGElement>(`[data-item="${item.id}"]`);
        if (!group) {
          group = document.createElementNS(SVG, "g");
          group.dataset.item = String(item.id);
          group.setAttribute("data-testid", "edit-item");
          group.setAttribute("tabindex", "0");
          group.setAttribute("role", "img");
          group.setAttribute("aria-label", fill(t.itemLabels[edit.kind], { page: edit.page }));
          group.append(document.createElementNS(SVG, "path"), document.createElementNS(SVG, "path"));
          listenKeys(group, item);
          layer.append(group);
        }
        const size = sizes.get(edit.page) ?? { width: 1, height: 1 };
        const points = edit.kind === "line" ? [[edit.x1, edit.y1], [edit.x2, edit.y2]] : edit.points;
        const path = points.map(([x, y], index) => `${index ? "L" : "M"}${(x * size.width).toFixed(1)} ${(y * size.height).toFixed(1)}`).join(" ") + (points.length === 1 ? " l0.01 0" : "");
        const [hit, ink] = group.children as unknown as SVGPathElement[];
        for (const element of [hit, ink]) element.setAttribute("d", path);
        hit.setAttribute("class", "edit-hit");
        hit.setAttribute("stroke-width", String(edit.thickness + 14 / Math.max(scale, 0.1)));
        ink.setAttribute("class", "edit-stroke");
        ink.setAttribute("stroke", edit.color);
        ink.setAttribute("stroke-width", String(edit.thickness));
        group.classList.toggle("is-selected", selected === item);
        placeFrame();
        return;
      }
      let element = sheet.querySelector<HTMLElement>(`[data-item="${item.id}"]`);
      if (!element) {
        element = document.createElement("div");
        element.dataset.item = String(item.id);
        element.dataset.kind = edit.kind;
        element.className = `edit-item is-${edit.kind}`;
        element.setAttribute("data-testid", "edit-item");
        element.setAttribute("aria-label", fill(t.itemLabels[edit.kind], { page: edit.page }));
        if (edit.kind === "text") {
          const text = document.createElement("div");
          text.className = "edit-text";
          text.setAttribute("role", "textbox");
          text.setAttribute("aria-multiline", "true");
          text.setAttribute("aria-label", fill(t.itemLabels.text, { page: edit.page }));
          text.dataset.placeholder = t.textPlaceholder;
          try {
            text.contentEditable = "plaintext-only";
          } catch {
            text.contentEditable = "true";
          }
          if (text.contentEditable !== "plaintext-only") text.contentEditable = "true";
          text.textContent = edit.text;
          let before = "";
          text.addEventListener("focus", () => {
            before = JSON.stringify({ items, nextId });
            select(item);
          });
          text.addEventListener("input", () => {
            edit.text = text.innerText.replace(/\n$/, "");
            sync();
          });
          text.addEventListener("blur", () => {
            if (JSON.stringify({ items, nextId }) !== before) {
              history.push(before);
              if (history.length > HISTORY) history.shift();
            }
            if (!edit.text.trim()) removeItem(item, false);
            sync();
          });
          text.addEventListener("keydown", (event) => {
            if (event.key === "Escape") text.blur();
          });
          const grip = document.createElement("button");
          grip.type = "button";
          grip.className = "edit-grip";
          grip.setAttribute("aria-label", t.moveText);
          grip.setAttribute("aria-describedby", "edit-hint");
          grip.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 3v18M3 12h18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3"/></svg>';
          listenKeys(grip, item);
          const handle = document.createElement("span");
          handle.className = "edit-handle";
          handle.dataset.resize = "";
          handle.setAttribute("aria-hidden", "true");
          element.append(grip, text, handle);
        } else {
          element.tabIndex = 0;
          element.setAttribute("role", "img");
          element.setAttribute("aria-describedby", "edit-hint");
          if (edit.kind === "image") {
            const img = document.createElement("img");
            img.alt = "";
            img.draggable = false;
            img.src = imageAt(edit.image)?.url ?? "";
            element.append(img);
          }
          const handle = document.createElement("span");
          handle.className = "edit-handle";
          handle.dataset.resize = "";
          handle.setAttribute("aria-hidden", "true");
          element.append(handle);
          listenKeys(element, item);
        }
        sheet.append(element);
      }
      element.classList.toggle("is-selected", selected === item);
      element.style.left = `${edit.x * 100}%`;
      element.style.top = `${edit.y * 100}%`;
      if (edit.kind === "text") {
        const text = element.querySelector<HTMLElement>(".edit-text") as HTMLElement;
        text.style.fontFamily = FAMILIES[edit.font];
        text.style.fontSize = `${edit.size * scale}px`;
        text.style.fontWeight = edit.bold ? "700" : "400";
        text.style.fontStyle = edit.italic ? "italic" : "normal";
        text.style.color = edit.color;
        text.style.lineHeight = String(LINE_HEIGHT);
        edit.baseline = baselineOf(edit.font, edit.bold, edit.italic);
        return;
      }
      if ("width" in edit) {
        element.style.width = `${edit.width * 100}%`;
        element.style.height = `${edit.height * 100}%`;
      }
      if (edit.kind === "rect" || edit.kind === "ellipse") {
        element.style.background = edit.fill ? edit.color : "transparent";
        element.style.border = edit.fill ? "0" : `${edit.thickness * scale}px solid ${edit.color}`;
      }
      if (edit.kind === "highlight") element.style.background = HIGHLIGHT;
      placeFrame();
    }

    // Lines and drawings live in a drawing layer, so a frame with the delete button and a corner shows around them.
    function placeFrame() {
      pagesList.querySelectorAll(".edit-frame").forEach((frame) => frame.remove());
      if (!selected || (selected.edit.kind !== "line" && selected.edit.kind !== "draw")) return;
      const sheet = sheetOf(selected.edit.page);
      if (!sheet) return;
      const area = bounds(selected.edit);
      const frame = document.createElement("div");
      frame.className = "edit-frame";
      frame.dataset.frame = String(selected.id);
      frame.style.left = `${area.x * 100}%`;
      frame.style.top = `${area.y * 100}%`;
      frame.style.width = `${area.width * 100}%`;
      frame.style.height = `${area.height * 100}%`;
      const handle = document.createElement("span");
      handle.className = "edit-handle";
      handle.dataset.resize = "";
      frame.append(handle);
      sheet.append(frame);
    }

    function drawAll() {
      for (const item of items) draw(item);
    }

    function select(item: Item | null) {
      if (selected === item) return;
      const previous = selected;
      selected = item;
      if (previous) draw(previous);
      if (item) {
        draw(item);
        showSelectedStyle();
      }
      showStyles();
      placeFrame();
      sync();
    }

    function removeItem(item: Item, record = true) {
      if (record) remember();
      items = items.filter((other) => other !== item);
      pagesList.querySelector(`[data-item="${item.id}"]`)?.remove();
      if (selected === item) selected = null;
      placeFrame();
      showStyles();
      sync();
    }

    function add(edit: Edit): Item {
      remember();
      const item = { id: nextId++, edit };
      items.push(item);
      draw(item);
      return item;
    }

    function setTool(next: Tool) {
      const input = box.querySelector<HTMLInputElement>(`input[name="edit-tool"][value="${next}"]`);
      if (input) input.checked = true;
      for (const sheet of pagesList.querySelectorAll<HTMLElement>(".edit-sheet")) sheet.dataset.tool = next;
      showStyles();
    }

    // Arrow keys move, Shift moves further, + and - resize, Delete removes, Escape lets go.
    function listenKeys(element: Element, item: Item) {
      element.addEventListener("focus", () => select(item));
      element.addEventListener("keydown", (raw) => {
        const event = raw as KeyboardEvent;
        const step = event.shiftKey ? BIG_STEP : STEP;
        const { edit } = item;
        const moves: Record<string, () => void> = {
          ArrowLeft: () => shift(edit, -step, 0),
          ArrowRight: () => shift(edit, step, 0),
          ArrowUp: () => shift(edit, 0, -step),
          ArrowDown: () => shift(edit, 0, step),
          "+": () => resize(edit, structuredClone(edit), step, step),
          "=": () => resize(edit, structuredClone(edit), step, step),
          "-": () => resize(edit, structuredClone(edit), -step, -step),
        };
        if (event.key === "Delete" || event.key === "Backspace") {
          event.preventDefault();
          removeItem(item);
          return;
        }
        if (event.key === "Escape") {
          (element as HTMLElement).blur();
          select(null);
          return;
        }
        const action = moves[event.key];
        if (!action) return;
        event.preventDefault();
        remember();
        action();
        draw(item);
        sync();
      });
    }

    // Where a pointer is on a sheet, as shares of it.
    function spot(sheet: HTMLElement, event: PointerEvent) {
      const rect = sheet.getBoundingClientRect();
      return { x: Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width)), y: Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height)) };
    }

    function itemFrom(target: EventTarget | null): Item | null {
      const element = (target as Element | null)?.closest?.("[data-item], [data-frame]");
      const id = Number((element as HTMLElement | null)?.dataset.item ?? (element as HTMLElement | null)?.dataset.frame);
      return items.find((item) => item.id === id) ?? null;
    }

    // One handler for every page: picking, moving and resizing in Select; making something with the other tools.
    // Pointer events cover mouse, pen and touch alike.
    pagesList.addEventListener("pointerdown", (event) => {
      const sheet = (event.target as Element).closest<HTMLElement>(".edit-sheet");
      if (!sheet || !sizes.has(Number(sheet.dataset.page)) || event.button > 0) return;
      const page = Number(sheet.dataset.page);
      const current = tool();
      const hit = itemFrom(event.target);
      const resizing = Boolean((event.target as Element).closest("[data-resize]"));
      const typing = Boolean((event.target as Element).closest(".edit-text"));

      if (current === "select" || hit) {
        if (!hit) {
          select(null);
          (document.activeElement as HTMLElement | null)?.blur?.();
          return;
        }
        if (current !== "select") setTool("select");
        select(hit);
        if (typing && !resizing) return;
        event.preventDefault();
        const start = spot(sheet, event);
        const before = structuredClone(hit.edit);
        const snapshot = JSON.stringify({ items, nextId });
        let moved = false;
        sheet.setPointerCapture(event.pointerId);
        const move = (next: PointerEvent) => {
          const at = spot(sheet, next);
          const dx = at.x - start.x;
          const dy = at.y - start.y;
          if (!moved && Math.hypot(dx * sheet.clientWidth, dy * sheet.clientHeight) < 3) return;
          moved = true;
          hit.edit = structuredClone(before);
          if (resizing) resize(hit.edit, before, dx, dy);
          else shift(hit.edit, dx, dy);
          draw(hit);
        };
        const end = () => {
          sheet.removeEventListener("pointermove", move);
          sheet.removeEventListener("pointerup", end);
          sheet.removeEventListener("pointercancel", end);
          if (moved) {
            history.push(snapshot);
            if (history.length > HISTORY) history.shift();
          }
          const target = pagesList.querySelector<HTMLElement>(`[data-item="${hit.id}"]`);
          (target?.querySelector<HTMLElement>(".edit-grip") ?? target)?.focus({ preventScroll: true });
          sync();
        };
        sheet.addEventListener("pointermove", move);
        sheet.addEventListener("pointerup", end);
        sheet.addEventListener("pointercancel", end);
        return;
      }

      event.preventDefault();
      const start = spot(sheet, event);
      const look = style();
      const size = sizes.get(page) as { width: number; height: number };

      if (current === "text") {
        // The tap marks the middle of the first line.
        const y = Math.max(0, start.y - (look.size * LINE_HEIGHT) / 2 / size.height);
        const item = add({ kind: "text", page, x: start.x, y, text: "", font: look.font, size: look.size, bold: look.bold, italic: look.italic, color: look.color, baseline: baselineOf(look.font, look.bold, look.italic) });
        setTool("select");
        select(item);
        // Straight away, so the first key typed lands in it.
        pagesList.querySelector<HTMLElement>(`[data-item="${item.id}"] .edit-text`)?.focus({ preventScroll: true });
        return;
      }
      if (current === "image") return;

      sheet.setPointerCapture(event.pointerId);
      let item: Item | null = null;
      const make = (at: { x: number; y: number }, final: boolean) => {
        const dragged = Math.hypot((at.x - start.x) * sheet.clientWidth, (at.y - start.y) * sheet.clientHeight) >= 4;
        if (!dragged && !final && current !== "draw") return;
        if (current === "draw") {
          if (!item) item = add({ kind: "draw", page, points: [[start.x, start.y]], color: look.color, thickness: look.thickness });
          const edit = item.edit as Extract<Edit, { kind: "draw" }>;
          const [lx, ly] = edit.points[edit.points.length - 1];
          if (Math.hypot((at.x - lx) * sheet.clientWidth, (at.y - ly) * sheet.clientHeight) >= 2) edit.points.push([at.x, at.y]);
        } else if (current === "line") {
          const end = dragged ? at : { x: Math.min(1, start.x + TAP_SIZE.width), y: start.y };
          const edit: Edit = { kind: "line", page, x1: start.x, y1: start.y, x2: end.x, y2: end.y, color: look.color, thickness: look.thickness };
          if (!item) item = add(edit);
          else item.edit = edit;
        } else {
          const kind = current as Exclude<Kind, "text" | "image" | "line" | "draw">;
          const area = dragged
            ? { x: Math.min(start.x, at.x), y: Math.min(start.y, at.y), width: Math.abs(at.x - start.x), height: Math.abs(at.y - start.y) }
            : { x: Math.min(start.x, 1 - TAP_SIZE.width), y: Math.min(start.y, 1 - TAP_SIZE.height), ...TAP_SIZE };
          const edit: Edit = { kind, page, ...area, color: look.color, fill: kind === "highlight" || kind === "whiteout" || look.fill, thickness: look.thickness };
          if (!item) item = add(edit);
          else item.edit = edit;
        }
        draw(item);
      };
      const move = (next: PointerEvent) => make(spot(sheet, next), false);
      const end = (next: PointerEvent) => {
        sheet.removeEventListener("pointermove", move);
        sheet.removeEventListener("pointerup", end);
        sheet.removeEventListener("pointercancel", end);
        make(spot(sheet, next), true);
        // Drawing goes on; anything else is ready to move or style straight away.
        if (item && current !== "draw") {
          setTool("select");
          select(item);
        }
        sync();
      };
      sheet.addEventListener("pointermove", move);
      sheet.addEventListener("pointerup", end);
      sheet.addEventListener("pointercancel", end);
    });

    // A style change applies to what's selected, and to what's made next.
    function restyle() {
      showStyles();
      if (!selected) return;
      const look = style();
      remember();
      const edit = selected.edit;
      if ("color" in edit && !["highlight", "whiteout"].includes(edit.kind)) edit.color = look.color;
      if (edit.kind === "text") Object.assign(edit, { font: look.font, size: look.size, bold: look.bold, italic: look.italic });
      if ("thickness" in edit) edit.thickness = look.thickness;
      if (edit.kind === "rect" || edit.kind === "ellipse") edit.fill = look.fill;
      draw(selected);
      sync();
    }

    box.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === "edit-tool") {
        select(null);
        setTool(target.value as Tool);
        if (target.value === "image") imageInput.click();
        return;
      }
      if (target === imageInput || target.closest("[data-edits-value]")) return;
      if (target === customColor) box.querySelectorAll<HTMLInputElement>('input[name="edit-color"]').forEach((input) => (input.checked = false));
      restyle();
    });
    box.addEventListener("input", (event) => {
      if (event.target === thicknessInput || event.target === customColor) restyle();
    });

    chooseImage.addEventListener("click", () => imageInput.click());
    imageInput.addEventListener("change", async () => {
      const picked = imageInput.files?.[0];
      imageInput.value = "";
      imageProblem.textContent = "";
      if (!picked) return;
      const page = currentPage;
      const size = sizes.get(page);
      if (!size) return;
      try {
        const { bytes, kind } = await uprightImage(picked);
        const bitmap = await decode(picked);
        const index = addImage({ bytes, kind, width: bitmap.width, height: bitmap.height });
        const ratio = (bitmap.width / bitmap.height) * (size.height / size.width);
        bitmap.close();
        // A third of the page wide, in the middle, never taller than the page.
        let width = 0.4;
        let height = width / ratio;
        if (height > 0.8) {
          height = 0.8;
          width = height * ratio;
        }
        const item = add({ kind: "image", page, x: (1 - width) / 2, y: (1 - height) / 2, width, height, image: index });
        setTool("select");
        select(item);
        const element = pagesList.querySelector<HTMLElement>(`[data-item="${item.id}"]`);
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        element?.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "center" });
        element?.focus({ preventScroll: true });
      } catch {
        imageProblem.textContent = t.imageFailed;
      }
      sync();
    });

    undoButton.addEventListener("click", () => {
      const last = history.pop();
      if (!last) return;
      const state = JSON.parse(last) as { items: Item[]; nextId: number };
      for (const element of pagesList.querySelectorAll("[data-item]")) element.remove();
      items = state.items;
      nextId = state.nextId;
      selected = null;
      drawAll();
      placeFrame();
      showStyles();
      sync();
    });
    removeButton.addEventListener("click", () => selected && removeItem(selected));

    // Draws pages as they come near the screen, and tracks which page is most in view.
    function watchPages(pageCount: number) {
      renderObserver?.disconnect();
      viewObserver?.disconnect();
      visible.clear();
      renderObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            renderObserver?.unobserve(entry.target);
            void drawPage(entry.target as HTMLElement);
          }
        },
        { rootMargin: "600px 0px" },
      );
      viewObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) visible.set(Number((entry.target as HTMLElement).dataset.page), entry.intersectionRatio);
          let best = currentPage;
          let most = -1;
          for (const [page, share] of visible) if (share > most || (share === most && page < best)) [best, most] = [page, share];
          if (most > 0) currentPage = best;
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      const list = Array.from({ length: pageCount }, (_, index) => {
        const page = index + 1;
        const item = document.createElement("li");
        item.className = "edit-page";
        item.dataset.page = String(page);
        item.setAttribute("data-testid", "edit-page");
        const sheet = document.createElement("div");
        sheet.className = "edit-sheet is-loading";
        sheet.dataset.page = String(page);
        sheet.dataset.tool = tool();
        const ink = document.createElementNS(SVG, "svg");
        ink.classList.add("edit-ink");
        ink.setAttribute("aria-hidden", "false");
        ink.setAttribute("preserveAspectRatio", "none");
        sheet.append(ink);
        const caption = document.createElement("span");
        caption.className = "edit-page-number";
        caption.textContent = fill(t.pageLabel, { page });
        item.append(sheet, caption);
        return item;
      });
      pagesList.replaceChildren(...list);
      for (const item of list) {
        renderObserver.observe(item);
        viewObserver.observe(item);
      }
    }

    async function drawPage(item: HTMLElement) {
      const opened = pdf;
      const page = Number(item.dataset.page);
      const sheet = item.querySelector(".edit-sheet") as HTMLElement;
      if (!opened) return;
      const width = Math.min(MAX_RENDER_WIDTH, Math.round(sheet.clientWidth * (window.devicePixelRatio || 1)));
      try {
        const [rendered, shown] = await Promise.all([
          renderPage(opened.doc, page, width),
          opened.doc.getPage(page).then((one) => one.getViewport({ scale: 1 })),
        ]);
        if (opened !== pdf) return;
        sizes.set(page, { width: shown.width, height: shown.height });
        const img = document.createElement("img");
        img.className = "edit-page-image";
        img.alt = "";
        img.draggable = false;
        img.src = URL.createObjectURL(rendered.blob);
        sheet.style.aspectRatio = `${shown.width} / ${shown.height}`;
        sheet.querySelector(".edit-ink")?.setAttribute("viewBox", `0 0 ${shown.width} ${shown.height}`);
        sheet.classList.remove("is-loading");
        sheet.prepend(img);
        for (const one of items) if (one.edit.page === page) draw(one);
      } catch {
        sheet.classList.remove("is-loading");
      }
    }

    function clear() {
      for (const img of pagesList.querySelectorAll<HTMLImageElement>(".edit-page-image")) URL.revokeObjectURL(img.src);
      pagesList.replaceChildren();
      pdf?.close();
      pdf = null;
      sizes.clear();
      items = [];
      history.length = 0;
      selected = null;
      currentPage = 1;
      clearImages();
    }

    shell.addEventListener("anytools:files", async (event) => {
      const next = (event as CustomEvent<{ files: File[] }>).detail.files[0] ?? null;
      if (next === file) return;
      file = next;
      clear();
      sync();
      if (!next) return;
      try {
        const opened = await openPdf(new Uint8Array(await next.arrayBuffer()));
        if (file !== next) {
          opened.close();
          return;
        }
        pdf = opened;
        watchPages(opened.doc.numPages);
      } catch {
        // The shell already tells people the file can't be read.
      }
      sync();
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    });

    // Text and lines keep their size on the page when the pages are drawn bigger or smaller.
    new ResizeObserver(() => drawAll()).observe(pagesList);

    // A panel taller than the screen moves with the page and stops at either end, like Sign PDF's.
    const panel = $<HTMLElement>(".edit-panel");
    const GAP = 16;
    let panelTop: number | null = null;
    let lastScroll = window.scrollY;
    function placePanel() {
      const header = document.querySelector("header")?.getBoundingClientRect().height ?? 64;
      const bar = shell.querySelector<HTMLElement>('[data-testid="shell-action-bar"]')?.getBoundingClientRect().height ?? 0;
      const highest = header + GAP;
      const lowest = Math.min(highest, window.innerHeight - bar - GAP * 2 - panel.offsetHeight);
      const scrolled = window.scrollY - lastScroll;
      lastScroll = window.scrollY;
      panelTop = Math.min(highest, Math.max(lowest, (panelTop ?? highest) - scrolled));
      panel.style.setProperty("--edit-panel-top", `${Math.round(panelTop)}px`);
    }
    new ResizeObserver(placePanel).observe(panel);
    window.addEventListener("resize", placePanel);
    window.addEventListener("scroll", placePanel, { passive: true });

    showStyles();
    sync();
  }
</script>

<style>
  /* Like Sign PDF: the pages large on the left, the tools in a panel on the right. Phones show the tools first. */
