  /* The page, drawn large. What's added sits on top of it, measured in shares of its size. */
  :global(.edit-sheet) {
    position: relative;
    width: 100%;
    max-width: 48rem;
    aspect-ratio: 1 / 1.414;
    background: #ffffff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.18);
