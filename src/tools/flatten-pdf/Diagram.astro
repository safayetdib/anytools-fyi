---
import en from "../../i18n/en.json";

const d = en.flattenPdf.diagram;
---

<figure class="flatten-diagram" aria-labelledby="flatten-diagram-caption">
  <div class="stage">
    <div class="doc">
      <span class="doc-name">{d.file}</span>
      <span class="doc-meta">{d.before}</span>
      <span class="sheet" aria-hidden="true"><span class="field is-live">Rahim Uddin</span><span class="tick is-live">✓</span><span class="note is-live">OK</span></span>
    </div>
    <div class="cut">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
      </svg>
      <span>{d.action}</span>
    </div>
    <div class="doc result">
      <span class="doc-name">{d.output}</span>
      <span class="doc-meta">{d.after}</span>
      <span class="sheet" aria-hidden="true"><span class="field">Rahim Uddin</span><span class="tick">✓</span><span class="note">OK</span></span>
    </div>
  </div>
  <figcaption id="flatten-diagram-caption">{d.caption}</figcaption>
</figure>

<style>
  .flatten-diagram {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .stage {
    display: grid;
    align-items: center;
    gap: var(--space-md);
  }

  .doc {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-bg);
  }

  .doc.result {
    border: 2px solid var(--color-accent);
  }

  .doc-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .doc-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .result .doc-meta {
    color: var(--color-accent);
  }

  .sheet {
    position: relative;
    display: block;
    width: 6rem;
    height: 8rem;
    padding: 12px 10px;
    border: 1px solid var(--color-border);
    background: #ffffff;
  }

  /* A name, a tick and a sticky note. Before, each sits in its own box you could still change; after, they're plain marks. */
  .field,
  .tick,
  .note {
    display: block;
    width: fit-content;
    margin-bottom: 8px;
    padding: 2px 4px;
    color: #111111;
    font-family: Arial, sans-serif;
    font-size: 0.5625rem;
  }

  .tick {
    width: 0.9rem;
    text-align: center;
  }

  .note {
    background: #f6dc6b;
  }

  .is-live {
    outline: 1px dashed var(--color-accent);
    outline-offset: 1px;
    background-color: color-mix(in srgb, var(--color-accent) 10%, #ffffff);
  }

  .note.is-live {
    background: #f6dc6b;
  }

  .cut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
  }

  figcaption {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
