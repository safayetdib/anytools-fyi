---
import en from "../../i18n/en.json";
import "../../styles/card-tools.css";

const t = en.flattenPdf;
---

<div class="pw-layout" data-flatten-options data-testid="flatten-options">
  <aside class="pw-panel" aria-labelledby="flatten-panel-title">
    <h3 class="pw-panel-title" id="flatten-panel-title">{t.panelTitle}</h3>
    <p class="pw-text">{t.intro}</p>

    <fieldset class="flatten-what">
      <legend>{t.whatLegend}</legend>
      <label class="flatten-choice">
        <input type="checkbox" name="forms" value="yes" checked data-choice />
        <span><strong>{t.forms}</strong><small>{t.formsHint}</small></span>
      </label>
      <label class="flatten-choice">
        <input type="checkbox" name="marks" value="yes" checked data-choice />
        <span><strong>{t.marks}</strong><small>{t.marksHint}</small></span>
      </label>
      <p class="pw-check is-bad" role="status" data-choice-status></p>
    </fieldset>

    <p class="pw-note">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
      <span>{t.note}</span>
    </p>
  </aside>

  <ul class="pw-cards" data-cards aria-label={t.cardsLabel}></ul>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { cardElement, trackPdfCards, type PdfCard } from "../../lib/shell/pdf-cards";

  const t = en.flattenPdf;
  const THUMBNAIL_WIDTH = 240;

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-flatten-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const cards = box.querySelector("[data-cards]") as HTMLUListElement;
    const status = box.querySelector("[data-choice-status]") as HTMLElement;
    const choices = [...box.querySelectorAll<HTMLInputElement>("[data-choice]")];
    const runButton = root.querySelector<HTMLButtonElement>('[data-el="run"]');
    let files: File[] = [];

    function sync() {
      const any = choices.some((input) => input.checked);
      status.textContent = any ? "" : t.chooseOne;
      if (runButton && files.length) runButton.disabled = !any;
    }

    box.addEventListener("change", (event) => {
      if ((event.target as HTMLElement).matches("[data-choice]")) sync();
    });

    function metaOf(card: PdfCard): { text: string; problem: boolean } {
      if (card.status === "loading") return { text: t.checking, problem: false };
      if (card.status === "locked") return { text: t.lockedCard, problem: true };
      if (card.status === "unreadable") return { text: t.unreadablePreview, problem: true };
      return { text: card.pages === null ? "" : card.pages === 1 ? t.pageOne : fill(t.pageMany, { count: card.pages }), problem: false };
    }

    let first = true;
    trackPdfCards(root, THUMBNAIL_WIDTH, (next, entries) => {
      files = next;
      cards.replaceChildren(
        ...files.map((file) => {
          const card = entries.get(file) as PdfCard;
          const meta = metaOf(card);
          const item = cardElement(file, card, { meta: meta.text, unreadable: t.unreadablePreview });
          item.setAttribute("data-testid", "flatten-card");
          item.querySelector(".pdf-card-meta")?.classList.toggle("is-problem", meta.problem);
          return item;
        }),
      );
      sync();
      if (first && files.length) {
        first = false;
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
      }
      if (!files.length) first = true;
    });
    sync();
  }
</script>

<style>
  .flatten-what {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .flatten-what legend {
    margin: 0 0 var(--space-xs);
    padding: 0;
    font-weight: 700;
  }

  /* Like the choice tiles in other PDF tools, but both can be picked. */
  .flatten-choice {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    min-height: 52px;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .flatten-choice input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .flatten-choice span {
    display: grid;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .flatten-choice small {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .flatten-choice:has(input:checked) {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  @media (hover: hover) {
    .flatten-choice:not(:has(input:checked)):hover {
      border-color: var(--color-accent);
    }
  }

  .flatten-what .pw-check:empty {
    display: none;
  }
</style>
