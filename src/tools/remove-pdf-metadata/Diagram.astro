---
import en from "../../i18n/en.json";

const d = en.removePdfMetadata.diagram;
---

<figure class="meta-diagram" aria-labelledby="meta-diagram-caption">
  <div class="stage">
    <div class="doc">
      <span class="doc-name">{d.file}</span>
      <span class="doc-meta">{d.before}</span>
      <span class="pair" aria-hidden="true"><span class="sheet"><span class="lines"></span></span><span class="tags"><span>Author: Rahim</span><span>Made with: Word</span><span>12 May 2026</span><span>GPS 23.8, 90.4</span></span></span>
    </div>
    <div class="cut">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
      </svg>
      <span>{d.action}</span>
    </div>
    <div class="doc result">
      <span class="doc-name">{d.output}</span>
      <span class="doc-meta">{d.after}</span>
      <span class="pair" aria-hidden="true"><span class="sheet"><span class="lines"></span></span><span class="tags is-gone"><span>Author</span><span>Made with</span><span>Date</span><span>GPS</span></span></span>
    </div>
  </div>
  <figcaption id="meta-diagram-caption">{d.caption}</figcaption>
</figure>

<style>
  .meta-diagram {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .stage {
    display: grid;
    align-items: center;
    gap: var(--space-md);
  }

  .doc {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-bg);
  }

  .doc.result {
    border: 2px solid var(--color-accent);
  }

  .doc-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .doc-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .result .doc-meta {
    color: var(--color-accent);
  }

  .sheet {
    position: relative;
    display: block;
    width: 6rem;
    height: 8rem;
    padding: 12px 10px;
    border: 1px solid var(--color-border);
    background: #ffffff;
  }

  .lines {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(#5f6b65 0 2px, transparent 2px 9px);
  }

  /* The page beside its hidden details; after cleaning, the details are struck out. */
  .pair {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .tags {
    display: grid;
    gap: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .tags span {
    padding: 2px 6px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    white-space: nowrap;
  }

  .tags.is-gone span {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .cut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
  }

  figcaption {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
