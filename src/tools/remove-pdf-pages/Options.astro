---
import PageGrid from "../../components/PageGrid.astro";
import en from "../../i18n/en.json";

const t = en.removePdfPages;
---

<div class="remove-layout" data-remove-options data-testid="remove-options">
  <aside class="remove-panel" aria-labelledby="remove-panel-title">
    <h3 class="remove-panel-title" id="remove-panel-title">{t.panelTitle}</h3>
    <p class="remove-info">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 8h.01" /></svg>
      <span>{t.info}</span>
    </p>
    <p class="remove-total"><strong>{t.totalPages}</strong> <span data-total-pages></span></p>
    <div class="remove-field">
      <label for="remove-pages">{t.pagesLabel}</label>
      <input
        id="remove-pages"
        name="pages"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        spellcheck="false"
        placeholder={t.pagesPlaceholder}
        aria-describedby="remove-error"
      />
      <p class="remove-error" id="remove-error" data-error data-testid="remove-error" role="alert" hidden>{t.allError}</p>
    </div>
  </aside>

  <div class="remove-preview">
    <PageGrid name="remove-grid" />
  </div>
</div>

<script>
  import { previewPdfOutput } from "../../lib/pdf/preview";
  import { cleanPageList, compressPages, parsePageList } from "../../lib/pdf/page-list";
  import { createPageGrid } from "../../lib/shell/page-grid";

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-remove-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const pagesInput = box.querySelector("#remove-pages") as HTMLInputElement;
    const error = box.querySelector("[data-error]") as HTMLElement;
    const total = box.querySelector("[data-total-pages]") as HTMLElement;
    const runButton = shell.querySelector<HTMLButtonElement>('[data-el="run"]');

    let file: File | null = null;
    let pageCount = 0;
    let marked = new Set<number>();
    // The last page tapped, where a Shift-tap's run starts.
    let anchor: number | null = null;

    const pageList = (pages: number[]) =>
      compressPages(pages)
        .map(({ from, to }) => (from === to ? String(from) : `${from}-${to}`))
        .join(",");

    // The button stays off until a page is marked, and while every page is marked, since a PDF can't be empty.
    function sync() {
      grid.setSelected(marked);
      const all = pageCount > 0 && marked.size === pageCount;
      error.hidden = !all;
      if (all) pagesInput.setAttribute("aria-invalid", "true");
      else pagesInput.removeAttribute("aria-invalid");
      if (runButton) runButton.disabled = marked.size === 0 || all;
    }

    const grid = createPageGrid({
      list: box.querySelector('[data-el="remove-grid-list"]') as HTMLOListElement,
      status: box.querySelector('[data-el="remove-grid-status"]') as HTMLElement,
      open: previewPdfOutput,
      mark: "remove",
      // A tap marks or unmarks a page. Shift-tap marks every page from the last one tapped, like other PDF tools.
      onToggle(page, shift) {
        if (shift && anchor !== null) {
          for (let next = Math.min(anchor, page); next <= Math.max(anchor, page); next++) marked.add(next);
        } else if (marked.has(page)) marked.delete(page);
        else marked.add(page);
        anchor = page;
        pagesInput.value = pageList([...marked].sort((a, b) => a - b));
        sync();
      },
      onZoom(page, from) {
        if (file) shell.dispatchEvent(new CustomEvent("anytools:preview-file", { detail: { file, from, page } }));
      },
    });

    // Typing marks and unmarks pages as it goes; only digits, commas and dashes can be typed.
    pagesInput.addEventListener("input", () => {
      const clean = cleanPageList(pagesInput.value);
      if (clean !== pagesInput.value) pagesInput.value = clean;
      marked = new Set(parsePageList(clean, pageCount));
      anchor = null;
      sync();
    });

    shell.addEventListener("anytools:files", async (event) => {
      file = (event as CustomEvent<{ files: File[] }>).detail.files[0] ?? null;
      pageCount = 0;
      marked = new Set();
      anchor = null;
      pagesInput.value = "";
      total.textContent = "";
      sync();
      pageCount = (await grid.load(file)) ?? 0;
      if (!file || !pageCount) return;
      total.textContent = String(pageCount);
      grid.showPages(marked, true);
      sync();
      // Bring the pages into view, so the next step is obvious after choosing a file.
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    });

    sync();
  }
</script>

<style>
  /* Like most PDF tools: the options in a panel on the right, the pages on the left. Phones show the options first. */
  .remove-layout {
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-md));
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .remove-layout {
      grid-template-columns: minmax(0, 1fr) 24rem;
      align-items: start;
    }

    .remove-preview {
      grid-column: 1;
      grid-row: 1;
    }

    .remove-panel {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-md));
      grid-column: 2;
    }
  }

  .remove-panel {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .remove-panel-title {
    margin: 0;
    font-size: 1.25rem;
    text-align: center;
  }

  /* The info note explains the one thing to do, like a label on a form. */
  .remove-info {
    display: flex;
    gap: var(--space-sm);
    margin: 0;
    padding: var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: var(--radius-button);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    line-height: 1.5;
  }

  .remove-info svg {
    flex: none;
    margin-top: 2px;
    color: var(--color-accent);
  }

  .remove-total {
    margin: 0;
  }

  .remove-field {
    display: grid;
    gap: var(--space-xs);
  }

  .remove-field label {
    font-weight: 700;
  }

  .remove-field input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .remove-field input[aria-invalid="true"] {
    border: 2px solid var(--color-danger);
  }

  .remove-error {
    margin: 0;
    color: var(--color-danger);
    font-weight: 600;
  }

  .remove-error[hidden] {
    display: none;
  }
</style>
