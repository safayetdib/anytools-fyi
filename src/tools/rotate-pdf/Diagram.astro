---
import en from "../../i18n/en.json";

const d = en.rotatePdf.diagram;
---

<figure class="rotate-diagram" aria-labelledby="rotate-diagram-caption" data-rotate-diagram data-direction="right">
  <div class="stage">
    <div class="doc">
      <span class="doc-name">{d.file}</span>
      <span class="doc-meta">{d.before}</span>
      <span class="sheet is-before" aria-hidden="true"><span class="lines"></span></span>
    </div>
    <div class="cut">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" />
      </svg>
      <span>{d.rotate}</span>
    </div>
    <div class="doc result">
      <span class="doc-name">{d.after}</span>
      <span class="sheet is-after" aria-hidden="true"><span class="lines"></span></span>
    </div>
  </div>
  <div class="controls">
    <button class="toggle" type="button" data-toggle data-label-left={d.tryLeft} data-label-right={d.tryRight}>{d.tryLeft}</button>
  </div>
  <figcaption id="rotate-diagram-caption" aria-live="polite" data-caption-right={d.captionRight} data-caption-left={d.captionLeft}>
    {d.captionRight}
  </figcaption>
</figure>

<script>
  const figure = document.querySelector<HTMLElement>("[data-rotate-diagram]");
  const toggle = figure?.querySelector<HTMLButtonElement>("[data-toggle]");
  const caption = figure?.querySelector<HTMLElement>("figcaption");

  // Shows the same sideways scan turned right or left.
  toggle?.addEventListener("click", () => {
    if (!figure || !caption) return;
    const right = figure.dataset.direction !== "right";
    figure.dataset.direction = right ? "right" : "left";
    caption.textContent = (right ? caption.dataset.captionRight : caption.dataset.captionLeft) ?? "";
    toggle.textContent = (right ? toggle.dataset.labelLeft : toggle.dataset.labelRight) ?? "";
  });
</script>

<style>
  .rotate-diagram {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .stage {
    display: grid;
    align-items: center;
    gap: var(--space-md);
  }

  .doc {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    padding: var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    background: var(--color-bg);
  }

  .doc.result {
    border: 2px solid var(--color-accent);
  }

  .doc-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .doc-meta {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  /* A page with lines of text. The scan lies on its side; the result stands upright when turned right. */
  .sheet {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.5rem;
    height: 5.5rem;
    margin-top: var(--space-xs);
  }

  .lines {
    display: block;
    width: 3.2rem;
    height: 4.4rem;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    background:
      linear-gradient(var(--color-accent), var(--color-accent)) 0.45rem 0.6rem / 55% 4px no-repeat,
      repeating-linear-gradient(
          var(--color-border) 0 3px,
          transparent 3px 9px
        )
        0.45rem 1.3rem / 70% 2.6rem no-repeat,
      var(--color-surface);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .is-before .lines {
    transform: rotate(-90deg);
  }

  .rotate-diagram[data-direction="left"] .is-after .lines {
    transform: rotate(180deg);
  }

  .cut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
  }

  .rotate-diagram[data-direction="left"] .cut svg {
    transform: scaleX(-1);
  }

  .controls {
    margin-top: var(--space-lg);
  }

  .toggle {
    min-height: 44px;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @media (hover: hover) {
    .toggle:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  figcaption {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lines {
      transition: none;
    }
  }
</style>
