---
import en from "../../i18n/en.json";

const t = en.rotatePdf;
const ROTATE_RIGHT = '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>';
const ROTATE_LEFT = '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>';
const filters = ["all", "portrait", "landscape"] as const;
const FILTER_ICONS = {
  all: '<rect x="3" y="6" width="8" height="12" rx="1"/><rect x="13" y="8" width="9" height="7" rx="1"/>',
  portrait: '<rect x="7" y="3" width="10" height="18" rx="1"/>',
  landscape: '<rect x="3" y="7" width="18" height="10" rx="1"/>',
} as const;
---

<div class="rotate-layout" data-rotate-options data-testid="rotate-options">
  <aside class="rotate-panel" aria-labelledby="rotate-panel-title">
    <h3 class="rotate-panel-title" id="rotate-panel-title">{t.panelTitle}</h3>
    <p class="rotate-info">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 8h.01" /></svg>
      <span>{t.info}</span>
    </p>

    <fieldset class="rotate-filters" data-filters hidden>
      <legend>{t.filterLegend}</legend>
      <div class="rotate-filter-options">
        {
          filters.map((filter) => (
            <label class="rotate-filter">
              <input type="radio" name="rotate-filter" value={filter} checked={filter === "all"} />
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={FILTER_ICONS[filter]} />
              <span>{t.filters[filter]}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="rotate-section">
      <div class="rotate-section-head">
        <h4>{t.rotation}</h4>
        <button type="button" class="rotate-reset" data-reset hidden>{t.resetAll}</button>
      </div>
      <div class="rotate-turns">
        <button type="button" class="rotate-turn" data-turn-all="90" aria-describedby="rotate-right-label">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ROTATE_RIGHT} />
          {t.right}
        </button>
        <button type="button" class="rotate-turn" data-turn-all="-90" aria-describedby="rotate-left-label">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ROTATE_LEFT} />
          {t.left}
        </button>
      </div>
      <span class="sr-only" id="rotate-right-label">{t.rightLabel}</span>
      <span class="sr-only" id="rotate-left-label">{t.leftLabel}</span>
    </div>
    <p class="sr-only" data-announce aria-live="polite"></p>
    <input type="hidden" name="rotations" data-rotations />
  </aside>

  <ul class="rotate-cards" data-cards aria-label={t.cardsLabel}></ul>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { previewPdfOutput } from "../../lib/pdf/preview";
  import { quarterTurns } from "./rotate";

  const t = en.rotatePdf;
  const THUMBNAIL_WIDTH = 240;
  const ICON =
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>';

  interface Entry {
    // Kept as a running total, so the picture always turns the short way round.
    spin: number;
    landscape: boolean;
    image: string | null;
    failed: boolean;
  }

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-rotate-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const cards = box.querySelector("[data-cards]") as HTMLUListElement;
    const filters = box.querySelector("[data-filters]") as HTMLFieldSetElement;
    const reset = box.querySelector("[data-reset]") as HTMLButtonElement;
    const rotations = box.querySelector("[data-rotations]") as HTMLInputElement;
    const announce = box.querySelector("[data-announce]") as HTMLElement;
    const runButton = shell.querySelector<HTMLButtonElement>('[data-el="run"]');

    let files: File[] = [];
    const entries = new Map<File, Entry>();

    const angle = (entry: Entry) => quarterTurns(0, entry.spin);
    const picked = () => box.querySelector<HTMLInputElement>('input[name="rotate-filter"]:checked')?.value ?? "all";

    function label(file: File, entry: Entry) {
      const turn = angle(entry);
      return turn ? fill(t.turned, { name: file.name, angle: turn }) : fill(t.notTurned, { name: file.name });
    }

    // Updates one card in place, so its picture can animate to the new direction.
    function paint(file: File) {
      const entry = entries.get(file);
      const card = cards.querySelector<HTMLElement>(`[data-index="${files.indexOf(file)}"]`);
      if (!entry || !card) return;
      card.dataset.turn = String(angle(entry));
      card.style.setProperty("--spin", `${entry.spin}deg`);
      card.querySelector(".rotate-card-frame")?.setAttribute("aria-label", label(file, entry));
    }

    function sync() {
      const turns = files.map((file) => angle(entries.get(file) as Entry));
      rotations.value = JSON.stringify(turns);
      const any = turns.some(Boolean);
      reset.hidden = !any;
      filters.hidden = files.length < 2;
      if (runButton) runButton.disabled = !any;
    }

    function draw() {
      cards.replaceChildren(
        ...files.map((file, index) => {
          const entry = entries.get(file) as Entry;
          const item = document.createElement("li");
          item.className = "rotate-card";
          item.dataset.index = String(index);
          item.setAttribute("data-testid", "rotate-card");
          const frame = document.createElement("span");
          frame.className = "rotate-card-frame";
          frame.setAttribute("role", "img");
          if (entry.image) {
            const img = document.createElement("img");
            img.alt = "";
            img.src = entry.image;
            frame.append(img);
          } else if (entry.failed) {
            frame.textContent = t.unreadablePreview;
            frame.classList.add("is-failed");
          } else frame.classList.add("is-loading");
          const name = document.createElement("span");
          name.className = "rotate-card-name";
          name.textContent = file.name;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "rotate-card-button";
          button.dataset.rotate = String(index);
          button.setAttribute("aria-label", fill(t.rotateFile, { name: file.name }));
          button.innerHTML = ICON;
          item.append(button, frame, name);
          return item;
        }),
      );
      files.forEach(paint);
      sync();
    }

    // Each file's first page, drawn once, tells its picture and whether it's portrait or landscape.
    async function look(file: File) {
      const entry = entries.get(file) as Entry;
      try {
        const preview = await previewPdfOutput(file);
        try {
          const page = await preview.renderPage(1, THUMBNAIL_WIDTH);
          entry.image = URL.createObjectURL(page.blob);
          entry.landscape = page.width > page.height;
        } finally {
          preview.close();
        }
      } catch {
        entry.failed = true;
      }
      if (files.includes(file)) draw();
    }

    function turn(chosen: File[], by: number) {
      for (const file of chosen) {
        const entry = entries.get(file) as Entry;
        entry.spin += by;
        paint(file);
      }
      sync();
      if (chosen.length) announce.textContent = chosen.map((file) => label(file, entries.get(file) as Entry)).join(". ");
    }

    box.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const one = target.closest<HTMLButtonElement>("[data-rotate]");
      if (one) return turn([files[Number(one.dataset.rotate)]], 90);
      const all = target.closest<HTMLButtonElement>("[data-turn-all]");
      if (all) {
        const filter = picked();
        const chosen = files.filter((file) => {
          const entry = entries.get(file) as Entry;
          return filter === "all" || (filter === "landscape") === entry.landscape;
        });
        return turn(chosen, Number(all.dataset.turnAll));
      }
      if (target.closest("[data-reset]")) {
        // Back to how each file started, the short way round.
        for (const file of files) {
          const entry = entries.get(file) as Entry;
          entry.spin -= angle(entry) > 180 ? angle(entry) - 360 : angle(entry);
          paint(file);
        }
        sync();
        (box.querySelector("[data-turn-all]") as HTMLButtonElement).focus();
      }
    });

    shell.addEventListener("anytools:files", (event) => {
      const next = (event as CustomEvent<{ files: File[] }>).detail.files;
      for (const [file, entry] of entries) {
        if (next.includes(file)) continue;
        if (entry.image) URL.revokeObjectURL(entry.image);
        entries.delete(file);
      }
      const added = next.filter((file) => !entries.has(file));
      for (const file of added) entries.set(file, { spin: 0, landscape: false, image: null, failed: false });
      const first = files.length === 0 && next.length > 0;
      files = next;
      draw();
      added.forEach((file) => void look(file));
      // Bring the choices into view after choosing the first files, so the next step is obvious.
      if (first) {
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
      }
    });

    sync();
  }
</script>

<style>
  /* Like most PDF tools: the options in a panel on the right, the files on the left. Phones show the options first. */
  .rotate-layout {
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-md));
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .rotate-layout {
      grid-template-columns: minmax(0, 1fr) 24rem;
      align-items: start;
    }

    .rotate-cards {
      grid-column: 1;
      grid-row: 1;
    }

    .rotate-panel {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-md));
      grid-column: 2;
    }
  }

  .rotate-panel {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  /* Very narrow phones get a little more room inside the panel, so the three choices fit side by side. */
  @media (max-width: 399px) {
    .rotate-panel {
      padding: var(--space-md);
    }
  }

  .rotate-panel-title {
    margin: 0;
    font-size: 1.25rem;
    text-align: center;
  }

  .rotate-info {
    display: flex;
    gap: var(--space-sm);
    margin: 0;
    padding: var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: var(--radius-button);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    line-height: 1.5;
  }

  .rotate-info svg {
    flex: none;
    margin-top: 2px;
    color: var(--color-accent);
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rotate-filters[hidden] {
    display: none;
  }

  .rotate-filters legend,
  .rotate-section h4 {
    margin: 0 0 var(--space-sm);
    font-size: 1rem;
    font-weight: 700;
  }

  /* Three choices with pictures, like Split PDF's tabs. They are radio buttons underneath. */
  .rotate-filter-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  /* Narrow phones get slightly smaller labels, so Landscape fits without clipping. */
  .rotate-filter {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    justify-items: center;
    min-width: 0;
    padding: var(--space-sm) 2px;
    font-size: clamp(0.8125rem, 3.4vw, 1rem);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-button);
    color: var(--color-text-muted);
    font-weight: 600;
    cursor: pointer;
  }

  .rotate-filter input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .rotate-filter:has(input:checked) {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface));
    color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .rotate-filter:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .rotate-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .rotate-reset {
    min-height: 44px;
    padding: 0 var(--space-xs);
    border: 0;
    background: none;
    color: var(--color-accent);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .rotate-reset[hidden] {
    display: none;
  }

  .rotate-turns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .rotate-turn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    min-height: 48px;
    padding: 0 var(--space-md);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .rotate-turn:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .rotate-turn:hover {
      background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    }

    .rotate-filter:not(:has(input:checked)):hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  /* One card per file: its first page, turned to show the result, its name and its own rotate button. */
  .rotate-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--space-lg);
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 599px) {
    .rotate-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }

  :global(.rotate-card) {
    position: relative;
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--space-sm);
    border: 2px solid transparent;
    border-radius: var(--radius-button);
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  :global(.rotate-card:not([data-turn="0"])) {
    border-color: var(--color-accent);
  }

  /* A square frame, so the page fits whichever way it's turned. */
  :global(.rotate-card-frame) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    text-align: center;
  }

  :global(.rotate-card-frame img) {
    max-width: 78%;
    max-height: 78%;
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
    transform: rotate(var(--spin, 0deg));
    transition: transform var(--dur-base) var(--ease-out);
  }

  :global(.rotate-card-frame.is-loading) {
    animation: rotate-pulse 1.2s ease-in-out infinite;
  }

  @keyframes rotate-pulse {
    50% {
      opacity: 0.5;
    }
  }

  :global(.rotate-card-name) {
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.rotate-card-button) {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-accent);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
    cursor: pointer;
  }

  @media (hover: hover) {
    :global(.rotate-card-button:hover) {
      background: var(--color-accent);
      color: var(--color-on-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.rotate-card-frame img),
    .rotate-turn {
      transition: none;
    }

    :global(.rotate-card-frame.is-loading) {
      animation: none;
    }
  }
</style>
