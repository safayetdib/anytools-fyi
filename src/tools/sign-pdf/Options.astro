---
import en from "../../i18n/en.json";
import { DEFAULT_CLEAN } from "./clean";

const t = en.signPdf;
const filters = ["original", "clean", "bold"] as const;
// The pen's own colour, then the colours most signatures are written in.
const inks = [
  { key: "original", value: "original" },
  { key: "black", value: "#111111" },
  { key: "blue", value: "#1f3fbf" },
  { key: "red", value: "#c42b2b" },
  { key: "green", value: "#1d7a3e" },
] as const;
---

<div class="sign-layout" data-sign-options data-testid="sign-options">
  <aside class="sign-panel" aria-labelledby="sign-panel-title">
    <h3 class="sign-panel-title" id="sign-panel-title">{t.panelTitle}</h3>

    <section class="sign-section" aria-labelledby="sign-signature-heading">
      <h4 id="sign-signature-heading">{t.signatureHeading}</h4>
      <label class="sign-pick">
        <input class="sr-only" type="file" accept="image/*,.heic,.heif" data-image aria-label={t.upload} />
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 16V4" /><path d="m7 9 5-5 5 5" /><path d="M4 20h16" />
        </svg>
        <span data-pick-text>{t.upload}</span>
      </label>
      <p class="sign-hint">{t.uploadHint}</p>
      <div class="sign-preview" data-preview hidden>
        <img data-preview-image alt={t.previewLabel} />
      </div>
      <p class="sign-error" data-error data-testid="sign-error" role="alert" hidden></p>

      <div class="sign-controls" data-controls hidden>
        <fieldset class="sign-filters">
          <legend>{t.filterLegend}</legend>
          <div class="sign-chips">
            {
              filters.map((filter) => (
                <label class="sign-chip">
                  <input type="radio" name="sign-filter" value={filter} checked={filter === DEFAULT_CLEAN.filter} />
                  <span>{t.filters[filter]}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p class="sign-hint" data-original-note hidden>{t.originalNote}</p>

        <div class="sign-sliders" data-sliders>
          <label class="sign-slider">
            <span>{t.removal}</span>
            <input type="range" min="0" max="100" step="5" value={DEFAULT_CLEAN.removal} data-removal />
          </label>
          <label class="sign-slider">
            <span>{t.contrast}</span>
            <input type="range" min="0" max="100" step="5" value={DEFAULT_CLEAN.contrast} data-contrast />
          </label>
          <label class="sign-slider">
            <span>{t.thickness}</span>
            <input type="range" min="0" max="3" step="1" value={DEFAULT_CLEAN.thickness} data-thickness />
          </label>
        </div>

        <fieldset class="sign-inks" data-inks>
          <legend>{t.inkLegend}</legend>
          <div class="sign-swatches">
            {
              inks.map(({ key, value }) => (
                <label class="sign-swatch" title={t.inks[key]}>
                  <input type="radio" name="sign-ink" value={value} checked={key === "original"} aria-label={t.inks[key]} />
                  <span class:list={["sign-swatch-dot", { "is-pen": key === "original" }]} style={key === "original" ? undefined : `background:${value}`} />
                </label>
              ))
            }
            <label class="sign-swatch" title={t.inks.custom} data-custom-swatch>
              <input type="color" value="#6b2fb3" data-custom aria-label={t.inks.custom} />
              <span class="sign-swatch-dot is-custom" data-custom-dot></span>
            </label>
          </div>
        </fieldset>

        <div class="sign-tools">
          <button type="button" class="sign-tool" data-rotate aria-label={t.rotateLabel}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" />
            </svg>
            <span>{t.rotate}</span>
          </button>
          <button type="button" class="sign-tool" data-reset>{t.reset}</button>
        </div>
      </div>
    </section>

    <section class="sign-section" aria-labelledby="sign-place-heading" data-place hidden>
      <h4 id="sign-place-heading">{t.placeHeading}</h4>
      <div class="sign-adds">
        <button type="button" class="sign-add is-main" data-add-page></button>
        <button type="button" class="sign-add" data-add-all>{t.addToAll}</button>
      </div>
      <p class="sign-count" data-count role="status">{t.placedNone}</p>
      <p class="sign-hint" id="sign-place-hint">{t.placeHint}</p>
    </section>

    <input type="hidden" name="clean" data-clean-value />
    <input type="hidden" name="placements" data-placements-value />
  </aside>

  <ol class="sign-pages" data-pages aria-label={t.pagesLabel}></ol>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { previewPdfOutput } from "../../lib/pdf/preview";
  import type { OutputPreview } from "../../lib/shell/types";
  import { chooseSignature, cleaned, chosenSignature, toPng } from "./chosen-signature";
  import { DEFAULT_CLEAN, FILTERS, readClean, type CleanSettings, type Filter } from "./clean";

  const t = en.signPdf;
  // A new signature starts at this share of the page's width, in the bottom-right corner, like a signature line.
  const START_WIDTH = 0.3;
  const EDGE = 0.06;
  const MIN_WIDTH = 0.05;
  const STEP = 0.01;
  const BIG_STEP = 0.05;
  // Pages are drawn sharp enough for their shown size, but never huge.
  const MAX_RENDER_WIDTH = 1400;

  interface Placed {
    id: number;
    page: number;
    x: number;
    y: number;
    width: number;
  }

  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-sign-options]");

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const $ = <T extends HTMLElement>(selector: string) => box.querySelector(selector) as T;
    const imageInput = $<HTMLInputElement>("[data-image]");
    const preview = $<HTMLElement>("[data-preview]");
    const previewImage = $<HTMLImageElement>("[data-preview-image]");
    const error = $<HTMLElement>("[data-error]");
    const controls = $<HTMLElement>("[data-controls]");
    const placeSection = $<HTMLElement>("[data-place]");
    const addPage = $<HTMLButtonElement>("[data-add-page]");
    const addAll = $<HTMLButtonElement>("[data-add-all]");
    const count = $<HTMLElement>("[data-count]");
    const pagesList = $<HTMLOListElement>("[data-pages]");
    const removal = $<HTMLInputElement>("[data-removal]");
    const contrast = $<HTMLInputElement>("[data-contrast]");
    const thickness = $<HTMLInputElement>("[data-thickness]");
    const custom = $<HTMLInputElement>("[data-custom]");
    const customSwatch = $<HTMLElement>("[data-custom-swatch]");
    const cleanValue = $<HTMLInputElement>("[data-clean-value]");
    const placementsValue = $<HTMLInputElement>("[data-placements-value]");
    const runButton = shell.querySelector<HTMLButtonElement>('[data-el="run"]');

    // True once a colour is picked from the colour picker, until a ready-made colour is chosen again.
    let customInk = false;
    let file: File | null = null;
    let document_: OutputPreview | null = null;
    let turn: CleanSettings["turn"] = 0;
    let signatureUrl: string | null = null;
    // Width divided by height of the cleaned signature, so placed copies keep its shape.
    let ratio = 1;
    let placed: Placed[] = [];
    let nextId = 1;
    let currentPage = 1;
    let lastMoved: Placed | null = null;
    const visible = new Map<number, number>();
    let renderObserver: IntersectionObserver | null = null;
    let viewObserver: IntersectionObserver | null = null;

    const picked = (name: string) => box.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";

    function settings(): CleanSettings {
      return readClean(
        JSON.stringify({
          filter: picked("sign-filter"),
          removal: removal.value,
          contrast: contrast.value,
          thickness: thickness.value,
          ink: customInk ? custom.value : picked("sign-ink"),
          turn,
        }),
      );
    }

    function sheetOf(page: number) {
      return pagesList.querySelector<HTMLElement>(`[data-page="${page}"] .sign-sheet`);
    }

    // The signature's height as a share of its page's height.
    function heightShare(item: Placed): number {
      const sheet = sheetOf(item.page);
      const aspect = sheet && sheet.clientWidth ? sheet.clientHeight / sheet.clientWidth : Math.SQRT2;
      return item.width / ratio / aspect;
    }

    function keepInside(item: Placed) {
      item.width = Math.min(1, Math.max(MIN_WIDTH, item.width));
      item.x = Math.min(1 - item.width, Math.max(0, item.x));
      item.y = Math.min(Math.max(0, 1 - heightShare(item)), Math.max(0, item.y));
    }

    function sync() {
      const ready = Boolean(chosenSignature() && signatureUrl);
      cleanValue.value = JSON.stringify(settings());
      placementsValue.value = JSON.stringify(placed.map(({ page, x, y, width }) => ({ page, x, y, width })));
      placeSection.hidden = !ready || !file;
      addPage.textContent = fill(t.addToPage, { page: currentPage });
      addPage.disabled = addAll.disabled = !ready || !document_;
      count.textContent = placed.length === 0 ? t.placedNone : placed.length === 1 ? t.placedOne : fill(t.placedMany, { count: placed.length });
      if (runButton) runButton.disabled = !ready || placed.length === 0;
    }

    function drawPlaced(item: Placed) {
      let element = pagesList.querySelector<HTMLElement>(`[data-placed="${item.id}"]`);
      if (!element) {
        element = document.createElement("div");
        element.className = "sign-placed";
        element.dataset.placed = String(item.id);
        element.setAttribute("data-testid", "sign-placed");
        element.tabIndex = 0;
        element.setAttribute("role", "group");
        element.setAttribute("aria-label", fill(t.placedLabel, { page: item.page }));
        element.setAttribute("aria-describedby", "sign-place-hint");
        const img = document.createElement("img");
        img.alt = "";
        img.draggable = false;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "sign-remove";
        remove.setAttribute("aria-label", t.remove);
        remove.textContent = "×";
        remove.addEventListener("click", () => removePlaced(item));
        const handle = document.createElement("span");
        handle.className = "sign-handle";
        handle.setAttribute("aria-hidden", "true");
        element.append(img, remove, handle);
        listen(element, handle, item);
        sheetOf(item.page)?.append(element);
      }
      const img = element.querySelector("img") as HTMLImageElement;
      if (signatureUrl && img.src !== signatureUrl) img.src = signatureUrl;
      element.style.left = `${item.x * 100}%`;
      element.style.top = `${item.y * 100}%`;
      element.style.width = `${item.width * 100}%`;
      element.style.aspectRatio = String(ratio);
    }

    function redrawAll() {
      for (const item of placed) {
        keepInside(item);
        drawPlaced(item);
      }
      sync();
    }

    function removePlaced(item: Placed) {
      placed = placed.filter((other) => other !== item);
      if (lastMoved === item) lastMoved = null;
      pagesList.querySelector(`[data-placed="${item.id}"]`)?.remove();
      sync();
      addPage.focus({ preventScroll: true });
    }

    function add(page: number, spot?: { x: number; y: number; width: number }) {
      const item: Placed = { id: nextId++, page, x: 0, y: 0, width: spot?.width ?? START_WIDTH };
      if (spot) {
        item.x = spot.x;
        item.y = spot.y;
      } else {
        item.x = 1 - item.width - EDGE;
        item.y = 1 - heightShare(item) - EDGE;
      }
      keepInside(item);
      placed.push(item);
      drawPlaced(item);
      return item;
    }

    // Drag to move; drag the corner to resize. Pointer events cover mouse, pen and touch alike.
    function listen(element: HTMLElement, handle: HTMLElement, item: Placed) {
      element.addEventListener("pointerdown", (event) => {
        if ((event.target as HTMLElement).closest(".sign-remove")) return;
        const sheet = element.parentElement as HTMLElement;
        const rect = sheet.getBoundingClientRect();
        const resizing = event.target === handle;
        const start = { x: event.clientX, y: event.clientY, left: item.x, top: item.y, width: item.width };
        element.setPointerCapture(event.pointerId);
        element.classList.add("is-moving");
        event.preventDefault();
        element.focus({ preventScroll: true });
        const move = (next: PointerEvent) => {
          const dx = (next.clientX - start.x) / rect.width;
          const dy = (next.clientY - start.y) / rect.height;
          if (resizing) item.width = start.width + dx;
          else {
            item.x = start.left + dx;
            item.y = start.top + dy;
          }
          keepInside(item);
          drawPlaced(item);
        };
        const end = () => {
          element.removeEventListener("pointermove", move);
          element.removeEventListener("pointerup", end);
          element.removeEventListener("pointercancel", end);
          element.classList.remove("is-moving");
          lastMoved = item;
          sync();
        };
        element.addEventListener("pointermove", move);
        element.addEventListener("pointerup", end);
        element.addEventListener("pointercancel", end);
      });

      element.addEventListener("keydown", (event) => {
        const step = event.shiftKey ? BIG_STEP : STEP;
        const moves: Record<string, () => void> = {
          ArrowLeft: () => (item.x -= step),
          ArrowRight: () => (item.x += step),
          ArrowUp: () => (item.y -= step),
          ArrowDown: () => (item.y += step),
          "+": () => (item.width += step * 2),
          "=": () => (item.width += step * 2),
          "-": () => (item.width -= step * 2),
          "−": () => (item.width -= step * 2),
        };
        if (event.key === "Delete" || event.key === "Backspace") {
          event.preventDefault();
          removePlaced(item);
          return;
        }
        const action = moves[event.key];
        if (!action) return;
        event.preventDefault();
        action();
        keepInside(item);
        drawPlaced(item);
        lastMoved = item;
        sync();
      });
    }

    // Cleans the preview-sized copy and shows it on the panel and on every placed copy.
    let pending = 0;
    async function refresh() {
      const ticket = ++pending;
      const current = settings();
      $<HTMLElement>("[data-original-note]").hidden = current.filter !== "original";
      $<HTMLElement>("[data-sliders]").hidden = current.filter === "original";
      $<HTMLElement>("[data-inks]").hidden = current.filter === "original";
      const pixels = cleaned(current, "preview");
      if (!pixels) {
        if (chosenSignature()) {
          error.textContent = t.noInk;
          error.hidden = false;
        }
        preview.hidden = true;
        if (signatureUrl) URL.revokeObjectURL(signatureUrl);
        signatureUrl = null;
        sync();
        return;
      }
      const blob = await toPng(pixels);
      if (ticket !== pending) return;
      error.hidden = true;
      const old = signatureUrl;
      signatureUrl = URL.createObjectURL(blob);
      ratio = pixels.width / pixels.height;
      previewImage.src = signatureUrl;
      preview.hidden = false;
      redrawAll();
      if (old) URL.revokeObjectURL(old);
    }

    // Draws pages as they come near the screen, and tracks which page is most in view.
    function watchPages(pageCount: number) {
      renderObserver?.disconnect();
      viewObserver?.disconnect();
      visible.clear();
      renderObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            renderObserver?.unobserve(entry.target);
            void drawPage(entry.target as HTMLElement);
          }
        },
        { rootMargin: "600px 0px" },
      );
      viewObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) visible.set(Number((entry.target as HTMLElement).dataset.page), entry.intersectionRatio);
          let best = currentPage;
          let most = -1;
          for (const [page, share] of visible) {
            if (share > most || (share === most && page < best)) [best, most] = [page, share];
          }
          if (most > 0 && best !== currentPage) {
            currentPage = best;
            sync();
          }
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      const items = Array.from({ length: pageCount }, (_, index) => {
        const page = index + 1;
        const item = document.createElement("li");
        item.className = "sign-page";
        item.dataset.page = String(page);
        item.setAttribute("data-testid", "sign-page");
        const sheet = document.createElement("div");
        sheet.className = "sign-sheet is-loading";
        const caption = document.createElement("span");
        caption.className = "sign-page-number";
        caption.textContent = fill(t.pageLabel, { page });
        item.append(sheet, caption);
        return item;
      });
      pagesList.replaceChildren(...items);
      for (const item of items) {
        renderObserver.observe(item);
        viewObserver.observe(item);
      }
    }

    async function drawPage(item: HTMLElement) {
      const handle = document_;
      const sheet = item.querySelector(".sign-sheet") as HTMLElement;
      if (!handle) return;
      const width = Math.min(MAX_RENDER_WIDTH, Math.round(sheet.clientWidth * (window.devicePixelRatio || 1)));
      try {
        const rendered = await handle.renderPage(Number(item.dataset.page), width);
        if (handle !== document_) return;
        const img = document.createElement("img");
        img.className = "sign-page-image";
        img.alt = "";
        img.draggable = false;
        img.src = URL.createObjectURL(rendered.blob);
        sheet.style.aspectRatio = `${rendered.width} / ${rendered.height}`;
        sheet.classList.remove("is-loading");
        sheet.prepend(img);
        // The page's real shape is known now, so keep its signatures inside it.
        for (const placedItem of placed) if (placedItem.page === Number(item.dataset.page)) keepInside(placedItem), drawPlaced(placedItem);
      } catch {
        sheet.classList.remove("is-loading");
      }
    }

    function clearPages() {
      for (const img of pagesList.querySelectorAll<HTMLImageElement>(".sign-page-image")) URL.revokeObjectURL(img.src);
      pagesList.replaceChildren();
      document_?.close();
      document_ = null;
      placed = [];
      lastMoved = null;
      currentPage = 1;
    }

    imageInput.addEventListener("change", async () => {
      const picture = imageInput.files?.[0];
      imageInput.value = "";
      if (!picture) return;
      try {
        await chooseSignature(picture);
      } catch {
        error.textContent = t.unreadableImage;
        error.hidden = false;
        return;
      }
      controls.hidden = false;
      $<HTMLElement>("[data-pick-text]").textContent = t.change;
      await refresh();
    });

    box.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target === imageInput || target.name === "clean" || target.name === "placements") return;
      // A filter sets the sliders to its own starting values.
      if (target.name === "sign-filter") {
        const values = FILTERS[target.value as Filter];
        removal.value = String(values.removal);
        contrast.value = String(values.contrast);
        thickness.value = String(values.thickness);
      }
      if (target.name === "sign-ink") pickCustom(false);
      void refresh();
    });
    for (const slider of [removal, contrast, thickness]) slider.addEventListener("input", () => void refresh());
    function pickCustom(on: boolean) {
      customInk = on;
      customSwatch.classList.toggle("is-picked", on);
      if (on) for (const radio of box.querySelectorAll<HTMLInputElement>('input[name="sign-ink"]')) radio.checked = false;
    }

    custom.addEventListener("input", () => {
      pickCustom(true);
      $<HTMLElement>("[data-custom-dot]").style.background = custom.value;
      void refresh();
    });

    $<HTMLButtonElement>("[data-rotate]").addEventListener("click", () => {
      turn = ((turn + 90) % 360) as CleanSettings["turn"];
      void refresh();
    });

    $<HTMLButtonElement>("[data-reset]").addEventListener("click", () => {
      turn = DEFAULT_CLEAN.turn;
      (box.querySelector(`input[name="sign-filter"][value="${DEFAULT_CLEAN.filter}"]`) as HTMLInputElement).checked = true;
      pickCustom(false);
      (box.querySelector('input[name="sign-ink"][value="original"]') as HTMLInputElement).checked = true;
      removal.value = String(DEFAULT_CLEAN.removal);
      contrast.value = String(DEFAULT_CLEAN.contrast);
      thickness.value = String(DEFAULT_CLEAN.thickness);
      void refresh();
    });

    function reveal(item: Placed) {
      const element = pagesList.querySelector<HTMLElement>(`[data-placed="${item.id}"]`);
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      element?.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "center" });
      element?.focus({ preventScroll: true });
    }

    addPage.addEventListener("click", () => {
      const item = add(currentPage);
      lastMoved = item;
      sync();
      reveal(item);
    });

    addAll.addEventListener("click", () => {
      const pages = Number(pagesList.children.length);
      // Every page gets it at the spot of the signature moved last, or the usual corner.
      const spot = lastMoved ? { x: lastMoved.x, y: lastMoved.y, width: lastMoved.width } : undefined;
      for (let page = 1; page <= pages; page++) {
        const already = placed.some((item) => item.page === page && spot && item.x === spot.x && item.y === spot.y);
        if (!already) add(page, spot);
      }
      sync();
    });

    shell.addEventListener("anytools:files", async (event) => {
      const next = (event as CustomEvent<{ files: File[] }>).detail.files[0] ?? null;
      if (next === file) return;
      file = next;
      clearPages();
      sync();
      if (!next) return;
      try {
        const opened = await previewPdfOutput(next);
        if (file !== next) {
          opened.close();
          return;
        }
        document_ = opened;
        watchPages(opened.pageCount);
      } catch {
        // The shell already tells people the file can't be read.
      }
      sync();
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    });

    sync();
  }
</script>

<style>
  /* Like most signing tools: the pages large on the left, the options in a panel on the right. Phones show the options first. */
  .sign-layout {
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-md));
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .sign-layout {
      grid-template-columns: minmax(0, 1fr) 23rem;
      align-items: start;
    }

    .sign-pages {
      grid-column: 1;
      grid-row: 1;
    }

    .sign-panel {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-md));
      grid-column: 2;
      max-height: calc(100vh - var(--header-height, 4rem) - var(--space-xl));
      overflow-y: auto;
    }
  }

  .sign-panel {
    min-width: 0;
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  @media (max-width: 399px) {
    .sign-panel {
      padding: var(--space-md);
    }
  }

  .sign-panel-title {
    margin: 0;
    font-size: 1.25rem;
    text-align: center;
  }

  .sign-section {
    display: grid;
    gap: var(--space-sm);
  }

  .sign-section[hidden],
  .sign-controls[hidden],
  .sign-preview[hidden],
  .sign-sliders[hidden],
  .sign-inks[hidden] {
    display: none;
  }

  .sign-section h4 {
    margin: 0;
    font-size: 1rem;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin: 0 0 var(--space-xs);
    padding: 0;
    font-weight: 700;
  }

  .sign-pick {
    display: flex;
    align-items: center;
