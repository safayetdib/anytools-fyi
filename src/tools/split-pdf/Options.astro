---
import PageGrid from "../../components/PageGrid.astro";
import en from "../../i18n/en.json";

interface Props {
  // The tab shown first. Extract PDF pages opens on Pages, as other PDF tools do.
  start?: "range" | "pages";
}

const { start = "range" } = Astro.props;
const t = en.splitPdf;
const ICONS = {
  range:
    '<rect x="2" y="7" width="7" height="10" rx="1"/><rect x="15" y="7" width="7" height="10" rx="1"/><path d="M10.5 12h3"/><path d="M1 4v16" stroke-dasharray="2 2"/><path d="M23 4v16" stroke-dasharray="2 2"/>',
  pages:
    '<rect x="2" y="7" width="7" height="10" rx="1"/><rect x="15" y="2" width="6" height="5" rx="1"/><rect x="15" y="9.5" width="6" height="5" rx="1"/><rect x="15" y="17" width="6" height="5" rx="1"/><path d="M9 12h3v-7.5h3"/><path d="M12 12h3"/><path d="M12 12v7.5h3"/>',
  size: '<rect x="2" y="9" width="8" height="11" rx="1"/><rect x="15" y="2" width="7" height="9" rx="1"/><rect x="17" y="16" width="4" height="5" rx="1"/><path d="M10 14h2.5V6.5H15"/><path d="M12.5 14v4.5H17"/>',
} as const;
const tabs = ["range", "pages", "size"] as const;
---

<div class="split-layout" data-split-options data-testid="split-options">
  <aside class="split-panel" aria-labelledby="split-panel-title">
    <h3 class="split-panel-title" id="split-panel-title">{t.panelTitle}</h3>
    <fieldset class="split-tabs">
      <legend class="sr-only">{t.tabsLegend}</legend>
      {
        tabs.map((tab) => (
          <label class="split-tab">
            <input type="radio" name="split-tab" value={tab} checked={tab === start} />
            <svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[tab]} />
            <span>{t.tabs[tab]}</span>
            <span class="split-tab-badge" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg></span>
          </label>
        ))
      }
    </fieldset>

    <div class="split-section" data-tab-panel="range" hidden={start !== "range"}>
      <fieldset class="split-switch">
        <legend>{t.rangeMode}</legend>
        <div class="split-switch-options">
          <label><input type="radio" name="split-range-mode" value="custom" checked /><svg class="split-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg><span>{t.rangeModes.custom}</span></label>
          <label><input type="radio" name="split-range-mode" value="fixed" /><svg class="split-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg><span>{t.rangeModes.fixed}</span></label>
        </div>
      </fieldset>
      <div data-range-mode="custom">
        <ol class="split-ranges" data-ranges data-testid="split-ranges"></ol>
        <button class="split-add" type="button" data-add-range>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
          {t.addRange}
        </button>
        <label class="split-check"><input type="checkbox" data-merge-ranges />{t.mergeRanges}</label>
      </div>
      <div data-range-mode="fixed" hidden>
        <div class="split-field">
          <label for="split-fixed">{t.fixedLabel}</label>
          <input id="split-fixed" type="number" inputmode="numeric" min="1" step="1" value="1" />
        </div>
      </div>
    </div>

    <div class="split-section" data-tab-panel="pages" hidden={start !== "pages"}>
      <fieldset class="split-switch">
        <legend>{t.extractMode}</legend>
        <div class="split-switch-options">
          <label><input type="radio" name="split-extract-mode" value="all" checked /><svg class="split-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg><span>{t.extractModes.all}</span></label>
          <label><input type="radio" name="split-extract-mode" value="select" /><svg class="split-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg><span>{t.extractModes.select}</span></label>
        </div>
      </fieldset>
      <div data-extract-mode="select" hidden>
        <div class="split-field">
          <label for="split-pages">{t.pagesLabel}</label>
          <input id="split-pages" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder={t.pagesPlaceholder} />
        </div>
        <label class="split-check"><input type="checkbox" data-merge-extracted />{t.mergeExtracted}</label>
      </div>
    </div>

    <div class="split-section" data-tab-panel="size" hidden>
      <dl class="split-facts">
        <div><dt>{t.originalSize}</dt><dd data-original-size></dd></div>
        <div><dt>{t.totalPages}</dt><dd data-total-pages></dd></div>
      </dl>
      <div class="split-field">
        <label for="split-size">{t.sizeLabel}</label>
        <div class="split-size-row">
          <input id="split-size" type="number" inputmode="decimal" min="0" step="any" aria-describedby="split-size-error" />
          <fieldset class="split-switch split-units">
            <legend class="sr-only">{t.sizeUnit}</legend>
            <div class="split-switch-options">
              <label><input type="radio" name="split-unit" value="KB" checked /><svg class="split-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg><span>{t.units.KB}</span></label>
              <label><input type="radio" name="split-unit" value="MB" /><svg class="split-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg><span>{t.units.MB}</span></label>
            </div>
          </fieldset>
        </div>
        <p class="split-error" id="split-size-error" data-error="size" data-testid="split-size-error" hidden></p>
      </div>
    </div>

    <p class="split-info" data-info data-testid="split-info" aria-live="polite" hidden></p>
    <p class="sr-only" data-moved aria-live="polite"></p>
    <input type="hidden" name="split" data-request />
  </aside>

  <div class="split-preview">
    <PageGrid name="split-grid" />
  </div>
</div>

<script>
  import en from "../../i18n/en.json";
  import { fill } from "../../i18n/format";
  import { formatSize } from "../../lib/files";
  import { previewPdfOutput } from "../../lib/pdf/preview";
  import { createPageGrid } from "../../lib/shell/page-grid";
  import { clampRange, cleanPageList, compressPages, fixedParts, parsePageList, MAX_PARTS, type Part, type SplitRequest } from "./plan";
  import { MIN_SIZE_BYTES, rangeMessage } from "./tool";

  const t = en.splitPdf;
  const root = document.querySelector<HTMLElement>("[data-tool-shell]");
  const found = root?.querySelector<HTMLElement>("[data-split-options]");
  const GRIP =
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 9 4-4 4 4"/><path d="m8 15 4 4 4-4"/></svg>';
  const REMOVE =
    '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>';

  if (root && found) {
    const box: HTMLElement = found;
    const shell: HTMLElement = root;
    const $ = <T extends HTMLElement>(selector: string) => box.querySelector(selector) as T;
    const rangeList = $<HTMLOListElement>("[data-ranges]");
    const fixed = $<HTMLInputElement>("#split-fixed");
    const pagesInput = $<HTMLInputElement>("#split-pages");
    const sizeInput = $<HTMLInputElement>("#split-size");
    const mergeRanges = $<HTMLInputElement>("[data-merge-ranges]");
    const mergeExtracted = $<HTMLInputElement>("[data-merge-extracted]");
    const info = $<HTMLElement>("[data-info]");
    const moved = $<HTMLElement>("[data-moved]");
    const request = $<HTMLInputElement>("[data-request]");
    const sizeError = $<HTMLElement>('[data-error="size"]');
    const runButton = shell.querySelector<HTMLButtonElement>('[data-el="run"]');

    let file: File | null = null;
    let pageCount = 0;
    let ranges: Part[] = [];
    let selected = new Set<number>();
    let activeRange: number | null = null;
    let view = "";

    const picked = (name: string) => box.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";
    const pick = (name: string, value: string) => {
      (box.querySelector(`input[name="${name}"][value="${value}"]`) as HTMLInputElement).checked = true;
    };
    const pageList = (pages: number[]) =>
      compressPages(pages)
        .map(({ from, to }) => (from === to ? String(from) : `${from}-${to}`))
        .join(",");

    // "This PDF will be split… 3 PDFs will be created.", with the count in bold.
    function say(lead: string, count?: number) {
      info.replaceChildren(lead);
      if (count !== undefined) {
        const strong = document.createElement("strong");
        strong.textContent = count === 1 ? t.createdOne : fill(t.createdMany, { count });
        info.append(" ", strong, ` ${t.createdTail}`);
      }
      info.hidden = !lead;
    }

    function sizeBytes(): number {
      return Math.round((Number(sizeInput.value) || 0) * (picked("split-unit") === "MB" ? 1024 * 1024 : 1024));
    }

    // Range rows are drawn from `ranges`. Only added ranges can be removed; the first always stays.
    function drawRanges() {
      rangeList.replaceChildren(
        ...ranges.map((range, index) => {
          const number = index + 1;
          const item = document.createElement("li");
          item.className = "split-range";
          item.dataset.index = String(index);
          item.toggleAttribute("data-active", activeRange === index);
          item.innerHTML = `
            <span class="split-range-head">
              <button type="button" class="split-range-grip" data-grip>${GRIP}</button>
              <span class="split-range-title"></span>
              <button type="button" class="split-range-remove" data-remove>${REMOVE}</button>
            </span>
            <span class="split-range-fields">
              <label class="split-range-field"><span></span><input type="number" inputmode="numeric" min="1" step="1" data-from /></label>
              <label class="split-range-field"><span></span><input type="number" inputmode="numeric" min="1" step="1" data-to /></label>
            </span>`;
          (item.querySelector(".split-range-title") as HTMLElement).textContent = fill(t.rangeLabel, { number });
          const [fromLabel, toLabel] = item.querySelectorAll<HTMLElement>(".split-range-field > span");
          fromLabel.textContent = t.fromPage;
          toLabel.textContent = t.toPage;
          const from = item.querySelector("[data-from]") as HTMLInputElement;
          const to = item.querySelector("[data-to]") as HTMLInputElement;
          from.value = String(range.from);
          to.value = String(range.to);
          from.max = to.max = String(pageCount);
          from.setAttribute("aria-label", `${fill(t.rangeLabel, { number })}, ${t.fromPage}`);
          to.setAttribute("aria-label", `${fill(t.rangeLabel, { number })}, ${t.toPage}`);
          from.dataset.index = to.dataset.index = String(index);
          const remove = item.querySelector("[data-remove]") as HTMLButtonElement;
          remove.dataset.remove = String(index);
          remove.setAttribute("aria-label", fill(t.removeRange, { number }));
          remove.hidden = index === 0;
          const grip = item.querySelector("[data-grip]") as HTMLButtonElement;
          grip.dataset.grip = String(index);
          grip.setAttribute("aria-label", fill(t.moveRange, { number }));
          grip.hidden = ranges.length === 1;
          return item;
        }),
      );
    }

    // While typing, the preview follows the numbers that make sense; the fields are corrected on leaving them.
    function readRanges(fix: boolean) {
      rangeList.querySelectorAll<HTMLInputElement>("[data-from], [data-to]").forEach((input) => {
        const range = ranges[Number(input.dataset.index)];
        if (!range) return;
        const value = input.value.trim() === "" ? Number.NaN : Math.floor(Number(input.value));
        if ("from" in input.dataset) range.from = value;
        else range.to = value;
      });
      if (!fix) return;
      ranges = ranges.map((range) => clampRange(range, pageCount));
      rangeList.querySelectorAll<HTMLInputElement>("[data-from], [data-to]").forEach((input) => {
        const range = ranges[Number(input.dataset.index)];
        input.value = String("from" in input.dataset ? range.from : range.to);
      });
    }

    function sync(redraw = false) {
      const tab = picked("split-tab");
      box.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((panel) => (panel.hidden = panel.dataset.tabPanel !== tab));
      const rangeMode = picked("split-range-mode");
      const extractMode = picked("split-extract-mode");
      box.querySelectorAll<HTMLElement>("[data-range-mode]").forEach((part) => (part.hidden = part.dataset.rangeMode !== rangeMode));
      box.querySelectorAll<HTMLElement>("[data-extract-mode]").forEach((part) => (part.hidden = part.dataset.extractMode !== extractMode));
      sizeError.hidden = true;
      sizeInput.removeAttribute("aria-invalid");
      if (runButton) runButton.disabled = false;
      if (!pageCount) {
        say("");
        request.value = "";
        return;
      }

      let next: SplitRequest;
      let nextView = "";
      let shown: Part[] = [];
      if (tab === "range" && rangeMode === "custom") {
        next = { mode: "ranges", ranges: ranges.map((range) => clampRange(range, pageCount)), merge: mergeRanges.checked };
        shown = next.ranges;
        // Like other PDF tools, custom ranges need no note: the boxes show the result.
        say("");
        nextView = `ranges:${JSON.stringify(shown)}`;
      } else if (tab === "range") {
        const size = Math.max(1, Math.floor(Number(fixed.value)) || 1);
        next = { mode: "fixed", size };
        shown = fixedParts(size, pageCount);
        say(fill(t.fixedInfo, { size }), shown.length);
        nextView = `ranges:${JSON.stringify(shown)}`;
      } else if (tab === "pages" && extractMode === "all") {
        next = { mode: "all" };
        say(t.allInfo, pageCount);
        nextView = "pages";
      } else if (tab === "pages") {
        next = { mode: "select", pages: pagesInput.value, merge: mergeExtracted.checked };
        selected = new Set(parsePageList(pagesInput.value, pageCount));
        // Merged pages make one file, so there's nothing to count.
        if (mergeExtracted.checked) say("");
        else say(t.selectInfo, selected.size);
        if (runButton) runButton.disabled = selected.size === 0;
        nextView = "pages";
      } else {
        const bytes = sizeBytes();
        next = { mode: "size", maxBytes: bytes };
        if (bytes < MIN_SIZE_BYTES) {
          sizeError.textContent = t.sizeError;
          sizeError.hidden = false;
          sizeInput.setAttribute("aria-invalid", "true");
        }
        say(fill(t.sizeInfo, { size: formatSize(Math.max(bytes, 0)) }));
        nextView = "first";
      }

      const count = next.mode === "all" ? pageCount : next.mode === "select" && !next.merge ? selected.size : shown.length;
      if (count > MAX_PARTS) say(rangeMessage("tooMany||"));
      request.value = JSON.stringify(next);

      const ticked = next.mode === "all" ? new Set(Array.from({ length: pageCount }, (_, i) => i + 1)) : selected;
      if (nextView === view && !redraw) {
        if (nextView === "pages") grid.setSelected(ticked);
        return;
      }
      view = nextView;
      if (nextView.startsWith("ranges:")) {
        grid.showRanges(shown);
        grid.setActiveRange(tab === "range" && rangeMode === "custom" ? activeRange : null);
      } else if (nextView === "pages") grid.showPages(ticked, true);
      else grid.showFirst();
    }

    const grid = createPageGrid({
      list: $<HTMLOListElement>('[data-el="split-grid-list"]'),
      status: $<HTMLElement>('[data-el="split-grid-status"]'),
      open: previewPdfOutput,
      // Tapping a page ticks or unticks it. In "Extract all pages" it starts a selection of every other page.
      onToggle(page) {
        if (picked("split-extract-mode") === "all") {
          pick("split-extract-mode", "select");
          selected = new Set(Array.from({ length: pageCount }, (_, i) => i + 1));
        }
        if (selected.has(page)) selected.delete(page);
        else selected.add(page);
        pagesInput.value = pageList([...selected].sort((a, b) => a - b));
        sync();
      },
      onZoom(page, from) {
        if (file) shell.dispatchEvent(new CustomEvent("anytools:preview-file", { detail: { file, from, page } }));
      },
    });

    function setActive(index: number | null) {
      activeRange = index;
      rangeList.querySelectorAll<HTMLElement>(".split-range").forEach((row) => row.toggleAttribute("data-active", Number(row.dataset.index) === index));
      grid.setActiveRange(index);
    }

    function moveRange(from: number, to: number, focus = true) {
      if (to < 0 || to >= ranges.length || to === from) return;
      const [range] = ranges.splice(from, 1);
      ranges.splice(to, 0, range);
      activeRange = to;
      drawRanges();
      sync(true);
      moved.textContent = fill(t.movedRange, { position: to + 1 });
      if (focus) (rangeList.querySelector(`[data-grip="${to}"]`) as HTMLButtonElement | null)?.focus();
    }

    // Select pages starts empty, as in other tools; the typed list only takes digits, commas and dashes.
    pagesInput.addEventListener("input", () => {
      const clean = cleanPageList(pagesInput.value);
      if (clean !== pagesInput.value) pagesInput.value = clean;
    });

    box.addEventListener("input", (event) => {
      if ((event.target as HTMLElement).closest("[data-ranges]")) readRanges(false);
      sync();
    });
    box.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.closest("[data-ranges]")) readRanges(true);
      if (target === fixed) fixed.value = String(Math.max(1, Math.floor(Number(fixed.value)) || 1));
      if (target.name === "split-extract-mode" && target.value === "select") {
        pagesInput.value = "";
        selected = new Set();
      }
      sync(target.name === "split-tab");
    });
    box.addEventListener("focusin", (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>(".split-range");
      if (row) setActive(Number(row.dataset.index));
    });
    box.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const remove = target.closest<HTMLButtonElement>("[data-remove]");
      if (remove) {
        ranges.splice(Number(remove.dataset.remove), 1);
        activeRange = null;
        drawRanges();
        sync(true);
        (rangeList.querySelector("[data-from]") as HTMLInputElement | null)?.focus();
        return;
      }
      if (target.closest("[data-add-range]")) {
        const last = ranges.at(-1);
        ranges.push({ from: Math.min((last?.to ?? 0) + 1, pageCount), to: pageCount });
        activeRange = ranges.length - 1;
        drawRanges();
        sync(true);
        (rangeList.querySelectorAll<HTMLInputElement>("[data-from]")[ranges.length - 1] as HTMLInputElement).focus();
      }
    });

    // Ranges can be put in another order by dragging the grip, or with the arrow keys on it.
    rangeList.addEventListener("keydown", (event) => {
      const grip = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-grip]");
      if (!grip || (event.key !== "ArrowUp" && event.key !== "ArrowDown")) return;
      event.preventDefault();
      const index = Number(grip.dataset.grip);
      moveRange(index, index + (event.key === "ArrowUp" ? -1 : 1));
    });
    rangeList.addEventListener("pointerdown", (event) => {
      const grip = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-grip]");
      if (!grip) return;
      event.preventDefault();
      const start = Number(grip.dataset.grip);
      const row = grip.closest<HTMLElement>(".split-range") as HTMLElement;
      row.setAttribute("data-dragging", "");
      grip.setPointerCapture(event.pointerId);
      let target = start;
      // The row stays in place while dragging (moving it would drop the pointer); a line shows where it will land.
      const onMove = (move: PointerEvent) => {
        const others = Array.from(rangeList.querySelectorAll<HTMLElement>(".split-range")).filter((other) => other !== row);
        target = others.filter((other) => other.getBoundingClientRect().top + other.offsetHeight / 2 < move.clientY).length;
        others.forEach((other, index) => {
          other.toggleAttribute("data-drop-before", index === target);
          other.toggleAttribute("data-drop-after", target === others.length && index === others.length - 1);
        });
      };
      const onUp = () => {
        grip.removeEventListener("pointermove", onMove);
        row.removeAttribute("data-dragging");
        rangeList.querySelectorAll("[data-drop-before], [data-drop-after]").forEach((other) => {
          other.removeAttribute("data-drop-before");
          other.removeAttribute("data-drop-after");
        });
        if (target !== start) moveRange(start, target);
      };
      grip.addEventListener("pointermove", onMove);
      grip.addEventListener("pointerup", onUp, { once: true });
      grip.addEventListener("pointercancel", onUp, { once: true });
    });

    shell.addEventListener("anytools:files", async (event) => {
      file = (event as CustomEvent<{ files: File[] }>).detail.files[0] ?? null;
      pageCount = 0;
      view = "";
      sync();
      pageCount = (await grid.load(file)) ?? 0;
      if (!file || !pageCount) return;
      // Start where other tools start: one range over the whole file, and a size limit of about four pages.
      ranges = [{ from: 1, to: pageCount }];
      activeRange = null;
      selected = new Set();
      pagesInput.value = "";
      sizeInput.value = String(Math.max(Math.ceil((file.size / pageCount) * 4 / 1024), MIN_SIZE_BYTES / 1024));
      pick("split-unit", "KB");
      $<HTMLElement>("[data-original-size]").textContent = formatSize(file.size);
      $<HTMLElement>("[data-total-pages]").textContent = String(pageCount);
      drawRanges();
      sync(true);
      // Bring the choices into view, so the next step is obvious after choosing a file.
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      box.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
    });

    sync();
  }
</script>

<style>
  /* Like most PDF tools: the options in a panel on the right, the pages on the left. Phones show the options first. */
  .split-layout {
    scroll-margin-top: calc(var(--header-height, 4rem) + var(--space-md));
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 900px) {
    .split-layout {
      grid-template-columns: minmax(0, 1fr) 24rem;
      align-items: start;
    }

    .split-preview {
      grid-column: 1;
      grid-row: 1;
    }

    .split-panel {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-md));
      grid-column: 2;
    }
  }

  .split-panel {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .split-panel-title {
    margin: 0;
    font-size: 1.25rem;
    text-align: center;
  }

