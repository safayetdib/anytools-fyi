// Cloudflare hosting. Pages are plain files, served free and without limit.
// A small Worker answers only /api/* (tool ratings), so ordinary page views never run code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anytools-fyi",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The site lives at anytools.fyi only. Branch previews keep their own test links.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Missing pages get the site's own 404 page.
    "not_found_handling": "404-page",
    // Matches Astro's trailingSlash: "always", so /merge-pdf redirects to /merge-pdf/.
    "html_handling": "force-trailing-slash"
  },
  // Once a day (UTC), rebuild the site if anyone rated, so new scores reach the pages.
  "triggers": { "crons": ["0 0 * * *"] },
  // Ratings are stored in D1. The salt for their hashes is the secret RATING_SALT.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anytools-ratings",
      "database_id": "06333976-4e38-47ec-aa5a-f41d0310b801",
      "migrations_dir": "migrations"
    }
  ],
  // Branch previews get their own database, so test ratings never count on the live site.
  // Its salt is a plain setting because preview ratings are throwaway test data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "anytools-ratings-preview",
        "database_id": "8897c60c-ca1c-40eb-99a3-9209b4b26a94",
        "migrations_dir": "migrations"
      }
    ],
    "vars": { "RATING_SALT": "preview-only" }
  }
}
