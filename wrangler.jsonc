// Cloudflare hosting. The site is plain files, so no Worker code runs and requests stay free and unlimited.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anytools-fyi",
  "compatibility_date": "2026-11-01",
  // The site lives at anytools.fyi only. Branch previews keep their own test links.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Missing pages get the site's own 404 page.
    "not_found_handling": "404-page",
    // Matches Astro's trailingSlash: "always", so /merge-pdf redirects to /merge-pdf/.
    "html_handling": "force-trailing-slash"
  }
}
